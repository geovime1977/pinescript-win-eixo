// @version=5
// -----------------------------------------------------------------------------
// Eixo Estratégico — WIN Day Trade | Indicador de Sinais X/3 (v14.10 — 05/08/2026)
// -----------------------------------------------------------------------------
// APLICAR ESTE INDICADOR NO GRÁFICO DE 1 MINUTO DO ATIVO WIN.
// Timeframe operacional: 1min | Contexto: 5m + 15m + 30m + 60m
// Fibonacci: primeiro candle 5min do dia
//
// v14 (04/08/2026) — alinhado à spec canônica:
//   - Estocástico LENTO (K=8, D=3, SMA duplo) em todos os TFs
//   - TRIX (9, MMA 3) em todos os TFs (era MMA 4)
//   - Score X/3 por TF: Estoc + TRIX + DI±  (ADX fora do score)
//   - ADX (8,8) é marcador visual de intensidade (número grande no candle)
//   - MACD 60m (12,26,9) mostrado como marcador tipo ADX + linha no painel/rodapé
//   - Setas MTF: label dinâmico com <TF>.<indicadores> (ex: "4.1.2.3")
//     Legenda: 1=Estoc, 2=TRIX, 3=DI±
//     TF: 1=5m · 2=15m · 3=30m · 4=60m
// -----------------------------------------------------------------------------

indicator("Eixo WIN — Sinais X/3 (v14)", overlay=true,
     max_lines_count=100, max_labels_count=500, max_boxes_count=50)

// ============================== PARÂMETROS ==================================
grpFibo   = "Fibonacci"
show_fibo = input.bool(true,  "Mostrar níveis Fibo",              group=grpFibo)
show_all  = input.bool(true,  "Mostrar todos os 20 níveis",        group=grpFibo)
tol_pct   = input.float(0.05, "Tolerância de toque (%)",           group=grpFibo, minval=0.01, step=0.01)

grpSig    = "Sinais"
cross_win = input.int(3, "Janela de iniciação (candles)",          group=grpSig, minval=1, maxval=10, tooltip="Quantos candles atrás o cruzamento/iniciação de um indicador ainda conta como fresh. 1 = estrito (só cruzou neste candle); 3 = default; 10 = permissivo.")
gap_bars  = input.int(3, "Gap mínimo entre eventos de toque",       group=grpSig, minval=1, maxval=20)
reset_gap = input.int(15, "Reset do contador após N candles sem tocar", group=grpSig, minval=3, maxval=100, tooltip="Se o preço fica N candles longe do nível (não toca), o contador de toques reseta para 0. Assim, um novo par 1º+2º toque no mesmo nível vira novo aviso amarelo.")
adx_min   = input.float(25.0, "ADX mínimo pra congruência TF sup.", group=grpSig, step=1)
sig_cooldown     = input.int(5, "Cooldown entre sinais (candles)",     group=grpSig, minval=1, maxval=60)
max_gap_touches  = input.int(10, "Máx. candles entre 1º e 2º toque",   group=grpSig, minval=2, maxval=50, tooltip="Se o 2º toque no mesmo Fibo demorar mais que N candles, o setup expira. O próximo toque vira novo 1º toque.")
wait_after_touch = input.int(1, "Janela pra confirmação após 2º toque (candles)", group=grpSig, minval=1, maxval=30, tooltip="Cross de Estoc 1m ou TRIX 5m vale entre o 2º toque e até N candles depois. Default 1 = apenas o candle do toque + próximo. Cross fora dessa janela é ignorado.")
min_extras       = input.int(2, "Mín. confirmações (Estoc 1m + TRIX 5m)", group=grpSig, minval=1, maxval=2, tooltip="2 (default v14) = exige AMBOS Estocástico 1m E TRIX 5m na direção. 1 = basta um dos dois.")
anti_faca    = input.bool(true, "Anti-faca (bloqueia se HTF 3/3 contra)", group=grpSig, tooltip="Bloqueia BUY se 15m OU 30m OU 60m estiver em score 3/3 SELL. Idem SELL. Vale pros dois gates (v13 e v14). Evita pegar faca caindo.")
adx_bonus    = input.int(5, "Bônus contratos quando ADX 5m intensifica", group=grpSig, minval=0, maxval=10, tooltip="Se ADX 5m está ativo (> 30 ou banda 70-80 caindo) → soma +N contratos ao sizing base (limitado por sizing_cap).")
show_alert   = input.bool(true, "Mostrar seta amarela de AVISO no 2º toque", group=grpSig, tooltip="Aviso visual do 2º toque, ANTES de qualquer confirmação — serve pra você se preparar.")
sizing_cap   = input.int(20, "Cap máximo de contratos (5×4TFs)",         group=grpSig, minval=5, maxval=100)

grpMTF = "Setas MTF (Setup por Timeframe)"
show_5m_cmb  = input.bool(true, "5m — sinais individuais (Estoc/TRIX/DI±)",  group=grpMTF)
show_15m_cmb = input.bool(true, "15m — sinais individuais",                  group=grpMTF)
show_30m_cmb = input.bool(true, "30m — sinais individuais",                  group=grpMTF)
show_60m_cmb = input.bool(true, "60m — sinais individuais",                  group=grpMTF)
mtf_label_size = input.string("small", "Tamanho das setas MTF", options=["tiny","small","normal","large","huge"], group=grpMTF, tooltip="Tamanho das setas MTF no gráfico. Default 'small' — se quiser mais legível suba pra 'normal' ou 'large'.")
show_macd60  = input.bool(true, "MACD 60m — marcador de cruzamento (contexto)", group=grpMTF, tooltip="Marca no candle quando MACD 60m cruzar. Não pontua no score.")

grpGate = "Gate de Entrada"
gate_mode = input.string("v13_legacy", "Modo do gate", options=["v14_close","v13_legacy","ambos"], group=grpGate, tooltip="v13_legacy (default) = 2º toque + Estoc 1m + TRIX 5m (AMBOS via min_extras=2). v14_close = 2º toque em Fibo + candle fecha na direção → entra na abertura do seguinte (anti-dupe). ambos = mostra os dois.")

grpPnl     = "Painel"
show_panel = input.bool(true, "Mostrar painel de sinais",           group=grpPnl)
panel_pos  = input.string("top_right", "Posição do painel", options=["top_right","top_left","bottom_right","bottom_left"], group=grpPnl)

// ============================== HELPERS =====================================
// TRIX manual (Pine v5 não tem ta.trix nativo confiável em request.security)
trix_calc(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema3 = ta.ema(ema2, len)
    ta.roc(ema3, 1)

// Estocástico LENTO (SMA duplo): K=raw, smoothed_K=SMA(raw,d), D=SMA(smoothed_K,d)
// Equivalente ao "Estocástico Lento (8,3)" usado na spec (04/08/2026).
stoch_slow(k_len, d_len) =>
    raw_k = ta.stoch(close, high, low, k_len)
    smooth_k = ta.sma(raw_k, d_len)
    smooth_d = ta.sma(smooth_k, d_len)
    [smooth_k, smooth_d]

// Converte string do input em size.* constant
size_from_str(s) =>
    s == "huge"   ? size.huge   :
     s == "large" ? size.large  :
     s == "normal"? size.normal :
     s == "small" ? size.small  : size.tiny

// ============================== FIBONACCI ===================================
// Puxa high/low do primeiro candle 5min do dia via request.security
get_first5_of_day() =>
    is_first = ta.change(dayofmonth) != 0
    fh = ta.valuewhen(is_first, high, 0)
    fl = ta.valuewhen(is_first, low, 0)
    [fh, fl]

[first5_high, first5_low] = request.security(syminfo.tickerid, "5", get_first5_of_day(), lookahead=barmerge.lookahead_off)
fib_range = first5_high - first5_low
has_base = not na(first5_high) and not na(fib_range) and fib_range > 0

fib_level(direction, pct) =>
    direction == "upper" ? first5_high + (pct / 100.0) * fib_range : first5_low - (pct / 100.0) * fib_range

// Níveis Fibo (Pine v5: uma declaração por linha)
u0 = fib_level("upper", 0)
umid = (first5_high + first5_low) / 2   // ★ meio do 1º candle 5min
u50 = fib_level("upper", 50)
u100 = fib_level("upper", 100)
u150 = fib_level("upper", 150)
u200 = fib_level("upper", 200)
u250 = fib_level("upper", 250)
u300 = fib_level("upper", 300)
u350 = fib_level("upper", 350)
u400 = fib_level("upper", 400)
u450 = fib_level("upper", 450)
l0 = fib_level("lower", 0)
l50 = fib_level("lower", 50)
l100 = fib_level("lower", 100)
l150 = fib_level("lower", 150)
l200 = fib_level("lower", 200)
l250 = fib_level("lower", 250)
l300 = fib_level("lower", 300)
l350 = fib_level("lower", 350)
l400 = fib_level("lower", 400)
l450 = fib_level("lower", 450)

color_sup      = color.new(color.blue, 60)
color_res      = color.new(color.red,  60)
color_sup_mid  = color.new(color.blue, 0)   // sem transparência
color_res_mid  = color.new(color.red,  0)
color_extremo  = color.new(color.black, 0)  // extremos R0/S0 do 1º candle 5min
color_mid_1st  = color.new(color.orange, 0) // meio do 1º candle 5min

plot(show_fibo and has_base ? u0   : na, "★ R0 (topo 1º 5m)", color=color_extremo, linewidth=2)
plot(show_fibo and has_base ? umid : na, "★ MID (meio 1º 5m)", color=color_mid_1st, linewidth=2)
plot(show_fibo and has_base ? u50  : na, "★ R50",    color=color_res_mid, linewidth=2)
plot(show_fibo and has_base ? u100 : na, "R100",     color=color_res)
plot(show_fibo and has_base ? u150 : na, "R150", color=color_res)
plot(show_fibo and has_base ? u200 : na, "R200", color=color_res)
plot(show_fibo and has_base and show_all ? u250 : na, "R250", color=color_res)
plot(show_fibo and has_base and show_all ? u300 : na, "R300", color=color_res)
plot(show_fibo and has_base and show_all ? u350 : na, "R350", color=color_res)
plot(show_fibo and has_base and show_all ? u400 : na, "R400", color=color_res)
plot(show_fibo and has_base and show_all ? u450 : na, "R450", color=color_res)
plot(show_fibo and has_base ? l0   : na, "★ S0 (base 1º 5m)", color=color_extremo, linewidth=2)
plot(show_fibo and has_base ? l50  : na, "★ S50",    color=color_sup_mid, linewidth=2)
plot(show_fibo and has_base ? l100 : na, "S100",     color=color_sup)
plot(show_fibo and has_base ? l150 : na, "S150", color=color_sup)
plot(show_fibo and has_base ? l200 : na, "S200", color=color_sup)
plot(show_fibo and has_base and show_all ? l250 : na, "S250", color=color_sup)
plot(show_fibo and has_base and show_all ? l300 : na, "S300", color=color_sup)
plot(show_fibo and has_base and show_all ? l350 : na, "S350", color=color_sup)
plot(show_fibo and has_base and show_all ? l400 : na, "S400", color=color_sup)
plot(show_fibo and has_base and show_all ? l450 : na, "S450", color=color_sup)

// ============================== INDICADORES 1min (chart) ====================
// Estocástico LENTO (K=8, D=3, SMA duplo) — alinhado à spec v14 (04/08/2026)
[stoch_k, stoch_d] = stoch_slow(8, 3)
stoch_cross_up = ta.crossover(stoch_k, stoch_d)
stoch_cross_dn = ta.crossunder(stoch_k, stoch_d)
stoch_up_recent = ta.barssince(stoch_cross_up) < cross_win
stoch_dn_recent = ta.barssince(stoch_cross_dn) < cross_win

// ============================== INDICADORES 5min via request ================
get_5m_signals() =>
    trix_val = trix_calc(close, 9)
    trix_ma = ta.sma(trix_val, 3)   // v14: MMA 3 (era 4)
    tbu = ta.barssince(ta.crossover(trix_val, trix_ma))
    tbd = ta.barssince(ta.crossunder(trix_val, trix_ma))
    [dmp, dmn, adx_v] = ta.dmi(8, 8)
    adx_up_30_r = adx_v > 30
    adx_between_70_80_dn = adx_v > 70 and adx_v < 80 and adx_v < adx_v[1]
    [tbu, tbd, adx_v, dmp, dmn, adx_up_30_r, adx_between_70_80_dn]

[trix_bars_up_5m, trix_bars_dn_5m, adx5, dmp5, dmn5, adx_up_30_5m, adx_band_dn_5m] = request.security(syminfo.tickerid, "5", get_5m_signals(), lookahead=barmerge.lookahead_off)

// ADX intensificador (5m): também usado para sizing e para congruência 4/4
adx_intensifier = adx_up_30_5m or adx_band_dn_5m

// ============================== TRIX 1min (saída) ===========================
// Saída: 2º cruzamento do TRIX 1m (contra direção do trade)
// Long fecha no 2º trix1m_cross_dn depois da entrada
// Short fecha no 2º trix1m_cross_up depois da entrada
trix1m_val = trix_calc(close, 9)
trix1m_ma  = ta.sma(trix1m_val, 3)   // v14: MMA 3 (era 4)
trix1m_cross_up = ta.crossover(trix1m_val, trix1m_ma)
trix1m_cross_dn = ta.crossunder(trix1m_val, trix1m_ma)

// ============================== SETUPS MTF POR TIMEFRAME =====================
// v14: cada TF tem 3 indicadores de decisão (Estoc Lento + TRIX + DI±) + ADX intensidade.
// Score X/3 por TF (ADX fora do cálculo — vira marcador visual separado).
get_htf_states() =>
    // Estocástico LENTO (8,3) — SMA duplo
    raw_k = ta.stoch(close, high, low, 8)
    k = ta.sma(raw_k, 3)
    d = ta.sma(k, 3)
    stoch_b = k > d
    stoch_s = k < d
    // TRIX (9, MMA 3)
    tv = trix_calc(close, 9)
    tm = ta.sma(tv, 3)
    trix_b = tv > tm
    trix_s = tv < tm
    // DI+/DI- e ADX (8, 8)
    [dp, dn, av] = ta.dmi(8, 8)
    adx_a = av > 30 or (av > 70 and av < 80 and av < av[1])
    dmi_b = dp > dn
    dmi_s = dn > dp
    [stoch_b, stoch_s, trix_b, trix_s, adx_a, dmi_b, dmi_s]

[s5_stoch_b, s5_stoch_s, s5_trix_b, s5_trix_s, s5_adx_a, s5_dmi_b, s5_dmi_s]         = request.security(syminfo.tickerid, "5",  get_htf_states(), lookahead=barmerge.lookahead_off)
[s15_stoch_b, s15_stoch_s, s15_trix_b, s15_trix_s, s15_adx_a, s15_dmi_b, s15_dmi_s]  = request.security(syminfo.tickerid, "15", get_htf_states(), lookahead=barmerge.lookahead_off)
[s30_stoch_b, s30_stoch_s, s30_trix_b, s30_trix_s, s30_adx_a, s30_dmi_b, s30_dmi_s]  = request.security(syminfo.tickerid, "30", get_htf_states(), lookahead=barmerge.lookahead_off)
[s60_stoch_b, s60_stoch_s, s60_trix_b, s60_trix_s, s60_adx_a, s60_dmi_b, s60_dmi_s]  = request.security(syminfo.tickerid, "60", get_htf_states(), lookahead=barmerge.lookahead_off)

// ============================== MACD 60min (contexto médio prazo) ============
// Filtro contextual — NÃO pontua no score MTF. Mostrado no gráfico como marcador
// (tipo ADX) e no painel/rodapé com timestamp do último cruzamento.
get_macd_60m() =>
    [macd_l, sig_l, _hist] = ta.macd(close, 12, 26, 9)
    m_up = ta.crossover(macd_l, sig_l)
    m_dn = ta.crossunder(macd_l, sig_l)
    m_state_b = macd_l > sig_l
    [m_up, m_dn, m_state_b]

[macd60_cross_up_raw, macd60_cross_dn_raw, macd60_state_buy] = request.security(syminfo.tickerid, "60", get_macd_60m(), lookahead=barmerge.lookahead_off)
// Anti-spam: request.security propaga o cross bool pra todos os 60 candles 1min
// do mesmo período 60m. Só firamos na transição (primeiro candle 1m que vê o cross).
macd60_cross_up = macd60_cross_up_raw and not macd60_cross_up_raw[1]
macd60_cross_dn = macd60_cross_dn_raw and not macd60_cross_dn_raw[1]

// v14: "TF alinhado" = 3/3 no score direcional (Estoc + TRIX + DI±), sem ADX
// ADX aparece separadamente como marca de intensidade no gráfico.
cmb_5m_buy_st   = s5_stoch_b  and s5_trix_b  and s5_dmi_b
cmb_5m_sell_st  = s5_stoch_s  and s5_trix_s  and s5_dmi_s
cmb_15m_buy_st  = s15_stoch_b and s15_trix_b and s15_dmi_b
cmb_15m_sell_st = s15_stoch_s and s15_trix_s and s15_dmi_s
cmb_30m_buy_st  = s30_stoch_b and s30_trix_b and s30_dmi_b
cmb_30m_sell_st = s30_stoch_s and s30_trix_s and s30_dmi_s
cmb_60m_buy_st  = s60_stoch_b and s60_trix_b and s60_dmi_b
cmb_60m_sell_st = s60_stoch_s and s60_trix_s and s60_dmi_s

// Sinal = transição (não persiste em candles seguintes)
sig_5m_buy   = cmb_5m_buy_st   and not cmb_5m_buy_st[1]
sig_5m_sell  = cmb_5m_sell_st  and not cmb_5m_sell_st[1]
sig_15m_buy  = cmb_15m_buy_st  and not cmb_15m_buy_st[1]
sig_15m_sell = cmb_15m_sell_st and not cmb_15m_sell_st[1]
sig_30m_buy  = cmb_30m_buy_st  and not cmb_30m_buy_st[1]
sig_30m_sell = cmb_30m_sell_st and not cmb_30m_sell_st[1]
sig_60m_buy  = cmb_60m_buy_st  and not cmb_60m_buy_st[1]
sig_60m_sell = cmb_60m_sell_st and not cmb_60m_sell_st[1]

// ============================== CONGRUÊNCIA MTF (regra completa por TF) =====
// Cada TF é "ativo direcional" quando:
//   (ADX > 30 OU está descendo dentro de 70-80)
//   E DMI aponta a direção (+DI > -DI para compra, oposto para venda)
get_higher_tf() =>
    [dmp, dmn, adx_v] = ta.dmi(8, 8)
    adx_up_30_r = adx_v > 30
    adx_band_dn = adx_v > 70 and adx_v < 80 and adx_v < adx_v[1]
    adx_active = adx_up_30_r or adx_band_dn
    [dmp, dmn, adx_v, adx_active]

[dmp15, dmn15, adx15, adx_active_15] = request.security(syminfo.tickerid, "15", get_higher_tf(), lookahead=barmerge.lookahead_off)
[dmp30, dmn30, adx30, adx_active_30] = request.security(syminfo.tickerid, "30", get_higher_tf(), lookahead=barmerge.lookahead_off)
[dmp60, dmn60, adx60, adx_active_60] = request.security(syminfo.tickerid, "60", get_higher_tf(), lookahead=barmerge.lookahead_off)

// ============================== ADX PEAK TRACKER (early declarations) =======
// Precisamos das flags de peak/exhausted disponíveis pra o Painel MTF (linha 766).
// Os inputs de config + tabela comparadora ficam no bloco maior mais abaixo.
grp_adx_pk   = "ADX Peak Tracker"
adx_drop_pct = input.float(15.0, "Queda do topo pra sinalizar exaustão (%)", group=grp_adx_pk, minval=5, maxval=50, step=1)
adx_min_peak = input.float(40.0, "Topo mínimo pra valer exaustão",           group=grp_adx_pk, minval=25, maxval=80, step=1)
show_adx_cmp = input.bool(true,  "Mostrar tabela comparador ADX MTF",         group=grp_adx_pk)

is_new_day_adx = ta.change(dayofmonth) != 0

var float adx5_peak  = 0.0
var float adx15_peak = 0.0
var float adx30_peak = 0.0
var float adx60_peak = 0.0

if is_new_day_adx
    adx5_peak  := 0.0
    adx15_peak := 0.0
    adx30_peak := 0.0
    adx60_peak := 0.0

adx5_peak  := math.max(adx5_peak,  nz(adx5))
adx15_peak := math.max(adx15_peak, nz(adx15))
adx30_peak := math.max(adx30_peak, nz(adx30))
adx60_peak := math.max(adx60_peak, nz(adx60))

adx5_thr  = adx5_peak  * (1 - adx_drop_pct / 100)
adx15_thr = adx15_peak * (1 - adx_drop_pct / 100)
adx30_thr = adx30_peak * (1 - adx_drop_pct / 100)
adx60_thr = adx60_peak * (1 - adx_drop_pct / 100)

adx5_peak_lost  = adx5_peak  >= adx_min_peak and adx5  < adx5_thr  and adx5[1]  >= adx5_thr
adx15_peak_lost = adx15_peak >= adx_min_peak and adx15 < adx15_thr and adx15[1] >= adx15_thr
adx30_peak_lost = adx30_peak >= adx_min_peak and adx30 < adx30_thr and adx30[1] >= adx30_thr
adx60_peak_lost = adx60_peak >= adx_min_peak and adx60 < adx60_thr and adx60[1] >= adx60_thr

adx5_exhausted  = adx5_peak  >= adx_min_peak and adx5  < adx5_thr
adx15_exhausted = adx15_peak >= adx_min_peak and adx15 < adx15_thr
adx30_exhausted = adx30_peak >= adx_min_peak and adx30 < adx30_thr
adx60_exhausted = adx60_peak >= adx_min_peak and adx60 < adx60_thr

// Alinhamento direcional por TF (agora usa a regra completa ADX>30 fresh OU banda 70-80 caindo)
cong5_buy   = adx_intensifier and dmp5  > dmn5
cong15_buy  = adx_active_15   and dmp15 > dmn15
cong30_buy  = adx_active_30   and dmp30 > dmn30
cong60_buy  = adx_active_60   and dmp60 > dmn60
cong5_sell  = adx_intensifier and dmn5  > dmp5
cong15_sell = adx_active_15   and dmn15 > dmp15
cong30_sell = adx_active_30   and dmn30 > dmp30
cong60_sell = adx_active_60   and dmn60 > dmp60

// Score 4/4 = quantos dos 4 TFs (5, 15, 30, 60) estão alinhados na direção
cong44_buy_score  = (cong5_buy  ? 1 : 0) + (cong15_buy  ? 1 : 0) + (cong30_buy  ? 1 : 0) + (cong60_buy  ? 1 : 0)
cong44_sell_score = (cong5_sell ? 1 : 0) + (cong15_sell ? 1 : 0) + (cong30_sell ? 1 : 0) + (cong60_sell ? 1 : 0)

// Score 3/3 antigo (só MTF superiores) — mantido para o sizing
cong_buy_score  = (cong15_buy  ? 1 : 0) + (cong30_buy  ? 1 : 0) + (cong60_buy  ? 1 : 0)
cong_sell_score = (cong15_sell ? 1 : 0) + (cong30_sell ? 1 : 0) + (cong60_sell ? 1 : 0)

// ============================== 2º TOQUE (nível a nível) ====================
is_new_day = ta.change(dayofmonth) != 0

tocou(level_price) =>
    tol = level_price * tol_pct / 100.0
    (low - tol) <= level_price and level_price <= (high + tol)

// Contadores de eventos por nível (Pine v5 exige uma declaração por linha)
var int u0_e = 0
var int u50_e = 0
var int u100_e = 0
var int u150_e = 0
var int u200_e = 0
var int u250_e = 0
var int u300_e = 0
var int u350_e = 0
var int u400_e = 0
var int u450_e = 0
var int l0_e = 0
var int l50_e = 0
var int l100_e = 0
var int l150_e = 0
var int l200_e = 0
var int l250_e = 0
var int l300_e = 0
var int l350_e = 0
var int l400_e = 0
var int l450_e = 0
// "bars since last touch" — usa int(na) inicial
var int u0_b = na
var int u50_b = na
var int u100_b = na
var int u150_b = na
var int u200_b = na
var int u250_b = na
var int u300_b = na
var int u350_b = na
var int u400_b = na
var int u450_b = na
var int l0_b = na
var int l50_b = na
var int l100_b = na
var int l150_b = na
var int l200_b = na
var int l250_b = na
var int l300_b = na
var int l350_b = na
var int l400_b = na
var int l450_b = na
var int mid_e = 0
var int mid_b = na

update(is_touching, events, bs_last) =>
    ne = events
    nbs = bs_last
    if is_touching
        if na(bs_last) or bs_last > gap_bars
            ne := events + 1
        nbs := 0
    else if not na(bs_last)
        nbs := bs_last + 1
        // Reset por gap: se preço afastou por mais de reset_gap candles, zera contador
        // Novo par 1º+2º toque vira novo aviso amarelo
        if nbs > reset_gap
            ne := 0
            nbs := na
    [ne, nbs]

if is_new_day
    u0_e := 0
    u50_e := 0
    u100_e := 0
    u150_e := 0
    u200_e := 0
    u250_e := 0
    u300_e := 0
    u350_e := 0
    u400_e := 0
    u450_e := 0
    l0_e := 0
    l50_e := 0
    l100_e := 0
    l150_e := 0
    l200_e := 0
    l250_e := 0
    l300_e := 0
    l350_e := 0
    l400_e := 0
    l450_e := 0
    mid_e := 0
    mid_b := na
    u0_b := na
    u50_b := na
    u100_b := na
    u150_b := na
    u200_b := na
    u250_b := na
    u300_b := na
    u350_b := na
    u400_b := na
    u450_b := na
    l0_b := na
    l50_b := na
    l100_b := na
    l150_b := na
    l200_b := na
    l250_b := na
    l300_b := na
    l350_b := na
    l400_b := na
    l450_b := na

if has_base
    [_e1, _b1] = update(tocou(u0), u0_e, u0_b)
    u0_e := _e1
    u0_b := _b1
    [_e2, _b2] = update(tocou(u50), u50_e, u50_b)
    u50_e := _e2
    u50_b := _b2
    [_e3, _b3] = update(tocou(u100), u100_e, u100_b)
    u100_e := _e3
    u100_b := _b3
    [_e4, _b4] = update(tocou(u150), u150_e, u150_b)
    u150_e := _e4
    u150_b := _b4
    [_e5, _b5] = update(tocou(u200), u200_e, u200_b)
    u200_e := _e5
    u200_b := _b5
    [_e6, _b6] = update(tocou(u250), u250_e, u250_b)
    u250_e := _e6
    u250_b := _b6
    [_e7, _b7] = update(tocou(u300), u300_e, u300_b)
    u300_e := _e7
    u300_b := _b7
    [_e8, _b8] = update(tocou(u350), u350_e, u350_b)
    u350_e := _e8
    u350_b := _b8
    [_e9, _b9] = update(tocou(u400), u400_e, u400_b)
    u400_e := _e9
    u400_b := _b9
    [_e10, _b10] = update(tocou(u450), u450_e, u450_b)
    u450_e := _e10
    u450_b := _b10
    [_e11, _b11] = update(tocou(l0), l0_e, l0_b)
    l0_e := _e11
    l0_b := _b11
    [_e12, _b12] = update(tocou(l50), l50_e, l50_b)
    l50_e := _e12
    l50_b := _b12
    [_e13, _b13] = update(tocou(l100), l100_e, l100_b)
    l100_e := _e13
    l100_b := _b13
    [_e14, _b14] = update(tocou(l150), l150_e, l150_b)
    l150_e := _e14
    l150_b := _b14
    [_e15, _b15] = update(tocou(l200), l200_e, l200_b)
    l200_e := _e15
    l200_b := _b15
    [_e16, _b16] = update(tocou(l250), l250_e, l250_b)
    l250_e := _e16
    l250_b := _b16
    [_e17, _b17] = update(tocou(l300), l300_e, l300_b)
    l300_e := _e17
    l300_b := _b17
    [_e18, _b18] = update(tocou(l350), l350_e, l350_b)
    l350_e := _e18
    l350_b := _b18
    [_e19, _b19] = update(tocou(l400), l400_e, l400_b)
    l400_e := _e19
    l400_b := _b19
    [_e20, _b20] = update(tocou(l450), l450_e, l450_b)
    l450_e := _e20
    l450_b := _b20
    [_em, _bm] = update(tocou(umid), mid_e, mid_b)
    mid_e := _em
    mid_b := _bm

// APENAS 2ª batida (== 2) — na 3ª, 4ª... batida no mesmo nível, NÃO dispara aviso.
// Cada nível gera no máximo 1 amarelo por dia (o momento exato do 2º toque).
// MID entra em AMBOS os lados (âncora dual).
mid_second_touch = tocou(umid) and mid_e == 2

second_upper = mid_second_touch or (tocou(u0)   and u0_e   == 2) or (tocou(u50)  and u50_e  == 2) or (tocou(u100) and u100_e == 2) or (tocou(u150) and u150_e == 2) or (tocou(u200) and u200_e == 2) or (tocou(u250) and u250_e == 2) or (tocou(u300) and u300_e == 2) or (tocou(u350) and u350_e == 2) or (tocou(u400) and u400_e == 2) or (tocou(u450) and u450_e == 2)
second_lower = mid_second_touch or (tocou(l0)   and l0_e   == 2) or (tocou(l50)  and l50_e  == 2) or (tocou(l100) and l100_e == 2) or (tocou(l150) and l150_e == 2) or (tocou(l200) and l200_e == 2) or (tocou(l250) and l250_e == 2) or (tocou(l300) and l300_e == 2) or (tocou(l350) and l350_e == 2) or (tocou(l400) and l400_e == 2) or (tocou(l450) and l450_e == 2)

// ============================== GATILHO (opção B — global por direção) =====
// Fluxo de estados (por direção, buy exemplo):
//   Estado 1: sem setup → aguarda algum 1º toque em suporte
//   Estado 2: 1º toque registrado → aguarda 2º toque no MESMO nível dentro
//             de max_gap_touches candles. Se estourar, setup expira e o próximo
//             toque vira NOVO 1º.
//   Estado 3: 2º toque válido → aguarda cross Estoc/TRIX dentro de
//             wait_after_touch candles APÓS o 2º toque. Cross entre 1º e 2º
//             também vale (cross_ago < first_touch_ago).
//   Após disparar: reset total, próximo toque vira novo 1º.

// Detect "1º toque acabou de acontecer" (algum nível com _e == 1)
// MID entra em AMBOS os lados (âncora dual)
mid_first_now = tocou(umid) and mid_e == 1
first_lower_now = mid_first_now or (tocou(l0) and l0_e == 1) or (tocou(l50) and l50_e == 1) or (tocou(l100) and l100_e == 1) or (tocou(l150) and l150_e == 1) or (tocou(l200) and l200_e == 1) or (tocou(l250) and l250_e == 1) or (tocou(l300) and l300_e == 1) or (tocou(l350) and l350_e == 1) or (tocou(l400) and l400_e == 1) or (tocou(l450) and l450_e == 1)
first_upper_now = mid_first_now or (tocou(u0) and u0_e == 1) or (tocou(u50) and u50_e == 1) or (tocou(u100) and u100_e == 1) or (tocou(u150) and u150_e == 1) or (tocou(u200) and u200_e == 1) or (tocou(u250) and u250_e == 1) or (tocou(u300) and u300_e == 1) or (tocou(u350) and u350_e == 1) or (tocou(u400) and u400_e == 1) or (tocou(u450) and u450_e == 1)

buy_cond1  = second_lower          // 2ª batida em suporte
sell_cond1 = second_upper          // 2ª batida em resistência

var int buy_first_touch_ago   = 999999
var int buy_second_touch_ago  = 999999
var int sell_first_touch_ago  = 999999
var int sell_second_touch_ago = 999999

if is_new_day
    buy_first_touch_ago   := 999999
    buy_second_touch_ago  := 999999
    sell_first_touch_ago  := 999999
    sell_second_touch_ago := 999999

buy_first_touch_ago   := buy_first_touch_ago   + 1
buy_second_touch_ago  := buy_second_touch_ago  + 1
sell_first_touch_ago  := sell_first_touch_ago  + 1
sell_second_touch_ago := sell_second_touch_ago + 1

// Registra 1º toque quando não há setup ativo (ou anterior expirou)
if first_lower_now and buy_first_touch_ago > max_gap_touches
    buy_first_touch_ago  := 0
    buy_second_touch_ago := 999999
if first_upper_now and sell_first_touch_ago > max_gap_touches
    sell_first_touch_ago  := 0
    sell_second_touch_ago := 999999

// Registra 2º toque: só se 1º ainda ativo (dentro do max_gap)
if buy_cond1 and buy_first_touch_ago <= max_gap_touches and buy_second_touch_ago > wait_after_touch
    buy_second_touch_ago := 0
if sell_cond1 and sell_first_touch_ago <= max_gap_touches and sell_second_touch_ago > wait_after_touch
    sell_second_touch_ago := 0

// Janela de confirmação aberta (2º toque aconteceu nos últimos wait_after_touch)
buy_touch_window_open  = buy_second_touch_ago  <= wait_after_touch
sell_touch_window_open = sell_second_touch_ago <= wait_after_touch

// Cross válido: aconteceu ENTRE 1º toque e AGORA → barssince(cross) < first_touch_ago
buy_cond2  = buy_touch_window_open  and ta.barssince(stoch_cross_up) < buy_first_touch_ago
buy_cond3  = buy_touch_window_open  and trix_bars_up_5m < buy_first_touch_ago
sell_cond2 = sell_touch_window_open and ta.barssince(stoch_cross_dn) < sell_first_touch_ago
sell_cond3 = sell_touch_window_open and trix_bars_dn_5m < sell_first_touch_ago

// Aliases mantidos para o painel (compatibilidade)
trix_up_5m = trix_bars_up_5m < 3
trix_dn_5m = trix_bars_dn_5m < 3

buy_extras_score  = (buy_cond2  ? 1 : 0) + (buy_cond3  ? 1 : 0)
sell_extras_score = (sell_cond2 ? 1 : 0) + (sell_cond3 ? 1 : 0)

buy_score  = (buy_cond1  ? 1 : 0) + buy_extras_score
sell_score = (sell_cond1 ? 1 : 0) + sell_extras_score

// Scores por TF (definição adiantada pra alimentar o filtro anti-faca)
// Scores por TF SEM ADX — direção pura (Est + TRIX + DMI), max 3
// ADX é tratado separadamente como marcador de intensidade
score_15m_buy  = (s15_stoch_b ? 1 : 0) + (s15_trix_b ? 1 : 0) + (s15_dmi_b ? 1 : 0)
score_15m_sell = (s15_stoch_s ? 1 : 0) + (s15_trix_s ? 1 : 0) + (s15_dmi_s ? 1 : 0)
score_30m_buy  = (s30_stoch_b ? 1 : 0) + (s30_trix_b ? 1 : 0) + (s30_dmi_b ? 1 : 0)
score_30m_sell = (s30_stoch_s ? 1 : 0) + (s30_trix_s ? 1 : 0) + (s30_dmi_s ? 1 : 0)
score_60m_buy  = (s60_stoch_b ? 1 : 0) + (s60_trix_b ? 1 : 0) + (s60_dmi_b ? 1 : 0)
score_60m_sell = (s60_stoch_s ? 1 : 0) + (s60_trix_s ? 1 : 0) + (s60_dmi_s ? 1 : 0)

// Filtro anti-faca (restaurado v14.1): bloqueia entrada se qualquer HTF (15/30/60)
// estiver em score 3/3 na direção OPOSTA. Vale pra v13 E v14.
anti_faca_buy_ok  = not anti_faca or (score_15m_sell < 3 and score_30m_sell < 3 and score_60m_sell < 3)
anti_faca_sell_ok = not anti_faca or (score_15m_buy  < 3 and score_30m_buy  < 3 and score_60m_buy  < 3)

buy_signal_hit  = buy_touch_window_open  and buy_extras_score  >= min_extras and anti_faca_buy_ok
sell_signal_hit = sell_touch_window_open and sell_extras_score >= min_extras and anti_faca_sell_ok

// ============================== GATE v14 (2º TOQUE + FECHAMENTO) ============
// Regra: 2ª batida no Fibo E candle fecha ACIMA (buy) ou ABAIXO (sell) do nível
//        → entrada na ABERTURA do candle SEGUINTE.
// buy_gate_v14_armed = TRUE no candle da 2ª batida com fechamento válido.
// buy_signal_v14     = TRUE no candle SEGUINTE (fires no open) = armed[1].

buy_gate_at(level, e) => tocou(level) and e == 2 and close > level
sell_gate_at(level, e) => tocou(level) and e == 2 and close < level

buy_gate_v14_armed  = buy_gate_at(umid, mid_e) or
   buy_gate_at(l0, l0_e)   or buy_gate_at(l50, l50_e)   or buy_gate_at(l100, l100_e) or
   buy_gate_at(l150, l150_e) or buy_gate_at(l200, l200_e) or buy_gate_at(l250, l250_e) or
   buy_gate_at(l300, l300_e) or buy_gate_at(l350, l350_e) or buy_gate_at(l400, l400_e) or
   buy_gate_at(l450, l450_e)

sell_gate_v14_armed = sell_gate_at(umid, mid_e) or
   sell_gate_at(u0, u0_e)   or sell_gate_at(u50, u50_e)   or sell_gate_at(u100, u100_e) or
   sell_gate_at(u150, u150_e) or sell_gate_at(u200, u200_e) or sell_gate_at(u250, u250_e) or
   sell_gate_at(u300, u300_e) or sell_gate_at(u350, u350_e) or sell_gate_at(u400, u400_e) or
   sell_gate_at(u450, u450_e)

// Sinal v14 bruto = entrada na abertura do candle seguinte ao armed
// Anti-faca aplicado também no v14 (mesma semântica: bloqueia se HTF 3/3 contra).
buy_signal_v14_raw  = buy_gate_v14_armed[1]  and anti_faca_buy_ok
sell_signal_v14_raw = sell_gate_v14_armed[1] and anti_faca_sell_ok

// Anti-duplicação: só a PRIMEIRA seta por direção. Próxima só depois que:
//   - passou sig_cooldown candles OU
//   - disparou um sinal oposto (compra depois de venda ou vice-versa)
var int  bars_since_v14_buy  = 999999
var int  bars_since_v14_sell = 999999
var string last_v14_dir      = ""

if is_new_day
    bars_since_v14_buy  := 999999
    bars_since_v14_sell := 999999
    last_v14_dir        := ""

bars_since_v14_buy  := bars_since_v14_buy  + 1
bars_since_v14_sell := bars_since_v14_sell + 1

// Só dispara se: (mudou de direção) OU (mesmo lado mas passou o cooldown)
buy_signal_v14  = buy_signal_v14_raw  and (last_v14_dir != "BUY"  or bars_since_v14_buy  > sig_cooldown)
sell_signal_v14 = sell_signal_v14_raw and (last_v14_dir != "SELL" or bars_since_v14_sell > sig_cooldown)

if buy_signal_v14
    bars_since_v14_buy := 0
    last_v14_dir       := "BUY"
if sell_signal_v14
    bars_since_v14_sell := 0
    last_v14_dir        := "SELL"

// SINAL PREMIUM 4/4: gatilho normal + congruência total nos 4 TFs (5,15,30,60)
buy_signal_44  = buy_signal_hit  and cong44_buy_score  == 4
sell_signal_44 = sell_signal_hit and cong44_sell_score == 4

// Reset após disparar (evita re-entrada no mesmo setup)
if buy_signal_hit
    buy_first_touch_ago  := 999999
    buy_second_touch_ago := 999999
if sell_signal_hit
    sell_first_touch_ago  := 999999
    sell_second_touch_ago := 999999

// Aviso amarelo: APENAS no candle exato da 2ª batida (transição 1→2)
// Evita persistir em candles seguintes onde o preço ainda está encostado no nível
second_lower_new = buy_cond1  and not buy_cond1[1]
second_upper_new = sell_cond1 and not sell_cond1[1]
fibo_touch_buy_alert  = second_lower_new and not buy_signal_hit
fibo_touch_sell_alert = second_upper_new and not sell_signal_hit

// ============================== COOLDOWN DE SINAIS ==========================
// Só marca o PRIMEIRO gatilho de cada cluster (evita setas empilhadas em barras
// consecutivas onde a condição continua verdadeira).
var int bars_since_buy_sig  = 999999
var int bars_since_sell_sig = 999999

if is_new_day
    bars_since_buy_sig  := 999999
    bars_since_sell_sig := 999999

bars_since_buy_sig  := bars_since_buy_sig  + 1
bars_since_sell_sig := bars_since_sell_sig + 1

buy_signal_new  = buy_signal_hit  and bars_since_buy_sig  > sig_cooldown
sell_signal_new = sell_signal_hit and bars_since_sell_sig > sig_cooldown

if buy_signal_new
    bars_since_buy_sig  := 0
if sell_signal_new
    bars_since_sell_sig := 0

// Sizing: 5 contratos por TF alinhado na direção (mín 5, máx 20)
// Ex.: só 5m compra → 5 ctr | 5m+15m → 10 ctr | 5m+15m+30m → 15 ctr | todos 4 → 20 ctr
n_tfs_buy_now  = (cmb_5m_buy_st  ? 1 : 0) + (cmb_15m_buy_st  ? 1 : 0) + (cmb_30m_buy_st  ? 1 : 0) + (cmb_60m_buy_st  ? 1 : 0)
n_tfs_sell_now = (cmb_5m_sell_st ? 1 : 0) + (cmb_15m_sell_st ? 1 : 0) + (cmb_30m_sell_st ? 1 : 0) + (cmb_60m_sell_st ? 1 : 0)
// v14.1: sizing = 5 × N_TFs + bônus se ADX 5m intensificando (limitado por cap)
sizing_by_tfs(n) => math.max(5, math.min(sizing_cap, 5 * n + (adx_intensifier ? adx_bonus : 0)))

// ============================== POSIÇÃO IMPLÍCITA + SCALE-OUT ================
// Rastreia posição assumida a partir do último buy_signal_new / sell_signal_new.
// A cada TF que vira contra → marca "pending_exit" naquele TF.
// No próximo toque em QUALQUER Fibo → sai 5 contratos e limpa a flag.

var bool tf5_locked_buy   = false
var bool tf15_locked_buy  = false
var bool tf30_locked_buy  = false
var bool tf60_locked_buy  = false
var bool tf5_locked_sell  = false
var bool tf15_locked_sell = false
var bool tf30_locked_sell = false
var bool tf60_locked_sell = false
var int  contratos_open   = 0
var string lado_open      = ""

// Reset diário
if is_new_day
    tf5_locked_buy   := false
    tf15_locked_buy  := false
    tf30_locked_buy  := false
    tf60_locked_buy  := false
    tf5_locked_sell  := false
    tf15_locked_sell := false
    tf30_locked_sell := false
    tf60_locked_sell := false
    contratos_open   := 0
    lado_open        := ""

// Nova entrada: trava TFs que estavam alinhados no momento
if buy_signal_new
    tf5_locked_buy   := cmb_5m_buy_st
    tf15_locked_buy  := cmb_15m_buy_st
    tf30_locked_buy  := cmb_30m_buy_st
    tf60_locked_buy  := cmb_60m_buy_st
    tf5_locked_sell  := false
    tf15_locked_sell := false
    tf30_locked_sell := false
    tf60_locked_sell := false
    contratos_open   := math.max(5, 5 * n_tfs_buy_now)
    lado_open        := "BUY"
if sell_signal_new
    tf5_locked_sell  := cmb_5m_sell_st
    tf15_locked_sell := cmb_15m_sell_st
    tf30_locked_sell := cmb_30m_sell_st
    tf60_locked_sell := cmb_60m_sell_st
    tf5_locked_buy   := false
    tf15_locked_buy  := false
    tf30_locked_buy  := false
    tf60_locked_buy  := false
    contratos_open   := math.max(5, 5 * n_tfs_sell_now)
    lado_open        := "SELL"

// Detecta TFs que já viraram contra (posição comprada perdendo TF)
flip_5m_from_buy  = tf5_locked_buy  and cmb_5m_sell_st
flip_15m_from_buy = tf15_locked_buy and cmb_15m_sell_st
flip_30m_from_buy = tf30_locked_buy and cmb_30m_sell_st
flip_60m_from_buy = tf60_locked_buy and cmb_60m_sell_st
flip_5m_from_sell  = tf5_locked_sell  and cmb_5m_buy_st
flip_15m_from_sell = tf15_locked_sell and cmb_15m_buy_st
flip_30m_from_sell = tf30_locked_sell and cmb_30m_buy_st
flip_60m_from_sell = tf60_locked_sell and cmb_60m_buy_st

n_flips_buy  = (flip_5m_from_buy  ? 1 : 0) + (flip_15m_from_buy  ? 1 : 0) + (flip_30m_from_buy  ? 1 : 0) + (flip_60m_from_buy  ? 1 : 0)
n_flips_sell = (flip_5m_from_sell ? 1 : 0) + (flip_15m_from_sell ? 1 : 0) + (flip_30m_from_sell ? 1 : 0) + (flip_60m_from_sell ? 1 : 0)

// Toque em qualquer nível Fibo (21 níveis + MID)
any_fibo_touch_now = has_base and (tocou(u0) or tocou(u50) or tocou(u100) or tocou(u150) or tocou(u200) or tocou(u250) or tocou(u300) or tocou(u350) or tocou(u400) or tocou(u450) or tocou(l0) or tocou(l50) or tocou(l100) or tocou(l150) or tocou(l200) or tocou(l250) or tocou(l300) or tocou(l350) or tocou(l400) or tocou(l450) or tocou(umid))

// Sinal de saída parcial: existe flip pendente + tocou Fibo + tem posição aberta
scale_out_buy_now  = lado_open == "BUY"  and n_flips_buy  > 0 and any_fibo_touch_now and contratos_open > 0
scale_out_sell_now = lado_open == "SELL" and n_flips_sell > 0 and any_fibo_touch_now and contratos_open > 0

// Executa saída: destrava os TFs que viraram e abate contratos
if scale_out_buy_now
    if flip_5m_from_buy
        tf5_locked_buy  := false
    if flip_15m_from_buy
        tf15_locked_buy := false
    if flip_30m_from_buy
        tf30_locked_buy := false
    if flip_60m_from_buy
        tf60_locked_buy := false
    contratos_open := math.max(0, contratos_open - (5 * n_flips_buy))
    if contratos_open == 0
        lado_open := ""
if scale_out_sell_now
    if flip_5m_from_sell
        tf5_locked_sell  := false
    if flip_15m_from_sell
        tf15_locked_sell := false
    if flip_30m_from_sell
        tf30_locked_sell := false
    if flip_60m_from_sell
        tf60_locked_sell := false
    contratos_open := math.max(0, contratos_open - (5 * n_flips_sell))
    if contratos_open == 0
        lado_open := ""

// ============================== PAINEL VISUAL ===============================
pos_table = panel_pos == "top_right" ? position.top_right : panel_pos == "top_left" ? position.top_left : panel_pos == "bottom_right" ? position.bottom_right : position.bottom_left

var table pnl = table.new(pos_table, 3, 13, border_width=1)

light(is_on) => is_on ? "🟢" : "⚪"
color_bg_hit(hit) => hit ? color.new(color.green, 60) : color.new(color.gray, 90)

// Score 5m também sem ADX (max 3) — mantém coerência com 15/30/60
score_5m_buy   = (s5_stoch_b  ? 1 : 0) + (s5_trix_b  ? 1 : 0) + (s5_dmi_b  ? 1 : 0)
score_5m_sell  = (s5_stoch_s  ? 1 : 0) + (s5_trix_s  ? 1 : 0) + (s5_dmi_s  ? 1 : 0)

// Formata "🟢🟢⚪ 2/3" — 3 luzes na ordem Estoc/TRIX/DMI + contador
fmt_tf(sb, tb, db, score) => light(sb) + light(tb) + light(db) + " " + str.tostring(score) + "/3"

color_tf(score) => score == 3 ? color.new(color.yellow, 0) : score == 2 ? color.new(color.orange, 0) : color.new(color.gray, 30)

// Helper (top-level: Pine v5 não permite função dentro de if)
f_adx_pnl(active, exhausted, v, peak) => exhausted ? " ⚪ADX " + str.tostring(v, "#") + "/" + str.tostring(peak, "#") : (active ? " 🟢ADX " + str.tostring(v, "#") + "/" + str.tostring(peak, "#") : "")

if show_panel and barstate.islast
    table.clear(pnl, 0, 0, 2, 10)
    table.cell(pnl, 0, 0, "EIXO WIN — Painel MTF",   bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.small)
    table.cell(pnl, 1, 0, "🟢 COMPRA",                bgcolor=color_bg_hit(buy_signal_hit),  text_color=color.white, text_size=size.small)
    table.cell(pnl, 2, 0, "🔴 VENDA",                 bgcolor=color_bg_hit(sell_signal_hit), text_color=color.white, text_size=size.small)
    table.cell(pnl, 0, 1, "★ 2ª batida em Fibo",     text_size=size.tiny, tooltip="Algum nível Fibo foi tocado pela 2ª+ vez neste candle. Âncora obrigatória.")
    table.cell(pnl, 1, 1, light(buy_cond1),           text_size=size.tiny)
    table.cell(pnl, 2, 1, light(sell_cond1),          text_size=size.tiny)
    // Setup por TF (Est/TRIX/DMI = DIREÇÃO, sem ADX) — luzes + X/3
    // ADX aparece separadamente como marca de intensidade no gráfico (número TF grande)
    table.cell(pnl, 0, 2, "5m (Est/TRIX/DMI)",   text_size=size.tiny, tooltip="Score de DIREÇÃO 5m (max 3). ADX: 🟢 ativa · ⚪ perdeu topo · valor/topo.")
    table.cell(pnl, 1, 2, fmt_tf(s5_stoch_b, s5_trix_b, s5_dmi_b, score_5m_buy)   + f_adx_pnl(s5_adx_a, adx5_exhausted, adx5, adx5_peak),   text_size=size.tiny, text_color=color_tf(score_5m_buy))
    table.cell(pnl, 2, 2, fmt_tf(s5_stoch_s, s5_trix_s, s5_dmi_s, score_5m_sell)  + f_adx_pnl(s5_adx_a, adx5_exhausted, adx5, adx5_peak),   text_size=size.tiny, text_color=color_tf(score_5m_sell))
    table.cell(pnl, 0, 3, "15m (Est/TRIX/DMI)",  text_size=size.tiny, tooltip="ADX: 🟢 ativa · ⚪ perdeu topo · valor/topo.")
    table.cell(pnl, 1, 3, fmt_tf(s15_stoch_b, s15_trix_b, s15_dmi_b, score_15m_buy)  + f_adx_pnl(s15_adx_a, adx15_exhausted, adx15, adx15_peak),   text_size=size.tiny, text_color=color_tf(score_15m_buy))
    table.cell(pnl, 2, 3, fmt_tf(s15_stoch_s, s15_trix_s, s15_dmi_s, score_15m_sell) + f_adx_pnl(s15_adx_a, adx15_exhausted, adx15, adx15_peak),   text_size=size.tiny, text_color=color_tf(score_15m_sell))
    table.cell(pnl, 0, 4, "30m (Est/TRIX/DMI)",  text_size=size.tiny, tooltip="ADX: 🟢 ativa · ⚪ perdeu topo · valor/topo.")
    table.cell(pnl, 1, 4, fmt_tf(s30_stoch_b, s30_trix_b, s30_dmi_b, score_30m_buy)  + f_adx_pnl(s30_adx_a, adx30_exhausted, adx30, adx30_peak),   text_size=size.tiny, text_color=color_tf(score_30m_buy))
    table.cell(pnl, 2, 4, fmt_tf(s30_stoch_s, s30_trix_s, s30_dmi_s, score_30m_sell) + f_adx_pnl(s30_adx_a, adx30_exhausted, adx30, adx30_peak),   text_size=size.tiny, text_color=color_tf(score_30m_sell))
    table.cell(pnl, 0, 5, "60m (Est/TRIX/DMI)",  text_size=size.tiny, tooltip="ADX: 🟢 ativa · ⚪ perdeu topo · valor/topo.")
    table.cell(pnl, 1, 5, fmt_tf(s60_stoch_b, s60_trix_b, s60_dmi_b, score_60m_buy)  + f_adx_pnl(s60_adx_a, adx60_exhausted, adx60, adx60_peak),   text_size=size.tiny, text_color=color_tf(score_60m_buy))
    table.cell(pnl, 2, 5, fmt_tf(s60_stoch_s, s60_trix_s, s60_dmi_s, score_60m_sell) + f_adx_pnl(s60_adx_a, adx60_exhausted, adx60, adx60_peak),   text_size=size.tiny, text_color=color_tf(score_60m_sell))
    // MACD 60m (contexto médio prazo — não pontua no score)
    table.cell(pnl, 0, 6, "MACD 60m (contexto)", text_size=size.tiny, tooltip="Cruzamento MACD 60m (12,26,9). Filtro contextual — não conta no score MTF.")
    table.cell(pnl, 1, 6, macd60_state_buy ? "🟢 compra" : "—", text_size=size.tiny, text_color=(macd60_state_buy ? color.green : color.gray))
    table.cell(pnl, 2, 6, not macd60_state_buy ? "🔴 venda" : "—", text_size=size.tiny, text_color=(not macd60_state_buy ? color.red : color.gray))
    // Congruência agregada mantida como resumo rápido
    table.cell(pnl, 0, 7, "Cong 4/4 (5/15/30/60)",   text_size=size.tiny)
    table.cell(pnl, 1, 7, light(cong5_buy)  + light(cong15_buy)  + light(cong30_buy)  + light(cong60_buy)  + " = " + str.tostring(cong44_buy_score),  text_size=size.tiny, text_color=(cong44_buy_score  == 4 ? color.yellow : color.gray))
    table.cell(pnl, 2, 7, light(cong5_sell) + light(cong15_sell) + light(cong30_sell) + light(cong60_sell) + " = " + str.tostring(cong44_sell_score), text_size=size.tiny, text_color=(cong44_sell_score == 4 ? color.yellow : color.gray))
    // Sizing: 5 × N_TFs alinhados AGORA
    table.cell(pnl, 0, 8, "Contratos p/ entrar (5×TFs)", text_size=size.tiny, tooltip="Se entrar AGORA no 1m: 5 contratos por TF alinhado. Mín 5, máx " + str.tostring(sizing_cap) + ".")
    table.cell(pnl, 1, 8, str.tostring(sizing_by_tfs(n_tfs_buy_now)),  text_size=size.tiny, text_color=color.green)
    table.cell(pnl, 2, 8, str.tostring(sizing_by_tfs(n_tfs_sell_now)), text_size=size.tiny, text_color=color.red)
    // Posição implícita a partir do último gatilho
    table.cell(pnl, 0, 9, "Posição aberta (implícita)", text_size=size.tiny, tooltip="Contratos assumidos a partir do último gatilho. Cada TF que virar contra → sai 5 no próximo toque em Fibo.")
    table.cell(pnl, 1, 9, lado_open == "BUY"  ? str.tostring(contratos_open) + " ctr" : "—", text_size=size.tiny, text_color=(lado_open == "BUY"  ? color.green : color.gray))
    table.cell(pnl, 2, 9, lado_open == "SELL" ? str.tostring(contratos_open) + " ctr" : "—", text_size=size.tiny, text_color=(lado_open == "SELL" ? color.red   : color.gray))
    table.cell(pnl, 0, 10, "TFs travados na entrada", text_size=size.tiny)
    table.cell(pnl, 1, 10, light(tf5_locked_buy)  + light(tf15_locked_buy)  + light(tf30_locked_buy)  + light(tf60_locked_buy),  text_size=size.tiny, text_color=color.green)
    table.cell(pnl, 2, 10, light(tf5_locked_sell) + light(tf15_locked_sell) + light(tf30_locked_sell) + light(tf60_locked_sell), text_size=size.tiny, text_color=color.red)
    table.cell(pnl, 0, 11, "Flips pendentes (sair 5×N)", text_size=size.tiny, tooltip="TFs travados que já viraram contra. No próximo toque em Fibo → sai 5 por flip.")
    table.cell(pnl, 1, 11, str.tostring(n_flips_buy)  + " → -" + str.tostring(5 * n_flips_buy)  + " ctr", text_size=size.tiny, text_color=(n_flips_buy  > 0 ? color.orange : color.gray))
    table.cell(pnl, 2, 11, str.tostring(n_flips_sell) + " → -" + str.tostring(5 * n_flips_sell) + " ctr", text_size=size.tiny, text_color=(n_flips_sell > 0 ? color.orange : color.gray))
    // Gate v14: 2º toque + fecha na direção → entra na abertura do candle seguinte
    table.cell(pnl, 0, 12, "Gate v14 (2ºtoque+fecha)", text_size=size.tiny, tooltip="v14: armed = 2ª batida em Fibo + candle fecha na direção. Sinal (BUYv14/SELLv14) dispara no candle seguinte, na abertura.")
    table.cell(pnl, 1, 12, buy_signal_v14 ? "🟢 ENTROU" : (buy_gate_v14_armed ? "🟡 armed" : "⚪"), text_size=size.tiny, text_color=(buy_signal_v14 ? color.green : (buy_gate_v14_armed ? color.yellow : color.gray)))
    table.cell(pnl, 2, 12, sell_signal_v14 ? "🔴 ENTROU" : (sell_gate_v14_armed ? "🟡 armed" : "⚪"), text_size=size.tiny, text_color=(sell_signal_v14 ? color.red : (sell_gate_v14_armed ? color.yellow : color.gray)))

// ============================== RODAPÉ: ÚLTIMO SCORE POR TF ==================
// Rastreia a última vez que o score de cada TF/direção mudou.
// Formato do timestamp: HH:MM se for hoje, DD/MM HH:MM se for outro dia.

var int last_t_5m_buy   = na
var int last_t_5m_sell  = na
var int last_t_15m_buy  = na
var int last_t_15m_sell = na
var int last_t_30m_buy  = na
var int last_t_30m_sell = na
var int last_t_60m_buy  = na
var int last_t_60m_sell = na
var int last_s_5m_buy   = 0
var int last_s_5m_sell  = 0
var int last_s_15m_buy  = 0
var int last_s_15m_sell = 0
var int last_s_30m_buy  = 0
var int last_s_30m_sell = 0
var int last_s_60m_buy  = 0
var int last_s_60m_sell = 0

if score_5m_buy != score_5m_buy[1]
    last_t_5m_buy := time
    last_s_5m_buy := score_5m_buy
if score_5m_sell != score_5m_sell[1]
    last_t_5m_sell := time
    last_s_5m_sell := score_5m_sell
if score_15m_buy != score_15m_buy[1]
    last_t_15m_buy := time
    last_s_15m_buy := score_15m_buy
if score_15m_sell != score_15m_sell[1]
    last_t_15m_sell := time
    last_s_15m_sell := score_15m_sell
if score_30m_buy != score_30m_buy[1]
    last_t_30m_buy := time
    last_s_30m_buy := score_30m_buy
if score_30m_sell != score_30m_sell[1]
    last_t_30m_sell := time
    last_s_30m_sell := score_30m_sell
if score_60m_buy != score_60m_buy[1]
    last_t_60m_buy := time
    last_s_60m_buy := score_60m_buy
if score_60m_sell != score_60m_sell[1]
    last_t_60m_sell := time
    last_s_60m_sell := score_60m_sell

pad2(n) => n < 10 ? "0" + str.tostring(n) : str.tostring(n)

fmt_time(t) =>
    result = "—"
    if not na(t)
        same_day = dayofmonth(timenow) == dayofmonth(t) and month(timenow) == month(t) and year(timenow) == year(t)
        hh = pad2(hour(t))
        mm = pad2(minute(t))
        if same_day
            result := hh + ":" + mm
        else
            result := pad2(dayofmonth(t)) + "/" + pad2(month(t)) + " " + hh + ":" + mm
    result

fmt_cell(score, t) =>
    str.tostring(score) + "/3 · " + fmt_time(t)

color_cell(score) => score == 3 ? color.new(color.yellow, 0) : score == 2 ? color.new(color.orange, 0) : score == 1 ? color.new(color.gray, 0) : color.new(color.gray, 60)

// MACD 60m — timestamp do último cruzamento (compra/venda)
var int last_t_macd60_up = na
var int last_t_macd60_dn = na
if macd60_cross_up
    last_t_macd60_up := time
if macd60_cross_dn
    last_t_macd60_dn := time

pos_rodape = position.bottom_center
var table rdp = table.new(pos_rodape, 5, 6, border_width=1, bgcolor=color.new(color.black, 70))

if show_panel and barstate.islast
    table.clear(rdp, 0, 0, 4, 5)
    table.cell(rdp, 0, 0, "ÚLT. SCORE",  bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 1, 0, "5m",          bgcolor=color.new(color.aqua,   50), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 2, 0, "15m",         bgcolor=color.new(color.lime,   50), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 3, 0, "30m",         bgcolor=color.new(color.orange, 50), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 4, 0, "60m",         bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.tiny)
    // linha BUY
    table.cell(rdp, 0, 1, "▲ BUY",       bgcolor=color.new(color.green, 60), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 1, 1, fmt_cell(last_s_5m_buy,  last_t_5m_buy),  text_size=size.tiny, text_color=color_cell(last_s_5m_buy))
    table.cell(rdp, 2, 1, fmt_cell(last_s_15m_buy, last_t_15m_buy), text_size=size.tiny, text_color=color_cell(last_s_15m_buy))
    table.cell(rdp, 3, 1, fmt_cell(last_s_30m_buy, last_t_30m_buy), text_size=size.tiny, text_color=color_cell(last_s_30m_buy))
    table.cell(rdp, 4, 1, fmt_cell(last_s_60m_buy, last_t_60m_buy), text_size=size.tiny, text_color=color_cell(last_s_60m_buy))
    // linha SELL
    table.cell(rdp, 0, 2, "▼ SELL",      bgcolor=color.new(color.red, 60), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 1, 2, fmt_cell(last_s_5m_sell,  last_t_5m_sell),  text_size=size.tiny, text_color=color_cell(last_s_5m_sell))
    table.cell(rdp, 2, 2, fmt_cell(last_s_15m_sell, last_t_15m_sell), text_size=size.tiny, text_color=color_cell(last_s_15m_sell))
    table.cell(rdp, 3, 2, fmt_cell(last_s_30m_sell, last_t_30m_sell), text_size=size.tiny, text_color=color_cell(last_s_30m_sell))
    table.cell(rdp, 4, 2, fmt_cell(last_s_60m_sell, last_t_60m_sell), text_size=size.tiny, text_color=color_cell(last_s_60m_sell))
    // linha ADX (estado atual)
    table.cell(rdp, 0, 3, "ADX ativo",   bgcolor=color.new(color.yellow, 40), text_color=color.black, text_size=size.tiny)
    table.cell(rdp, 1, 3, s5_adx_a  ? "🟢" : "⚪", text_size=size.tiny)
    table.cell(rdp, 2, 3, s15_adx_a ? "🟢" : "⚪", text_size=size.tiny)
    table.cell(rdp, 3, 3, s30_adx_a ? "🟢" : "⚪", text_size=size.tiny)
    table.cell(rdp, 4, 3, s60_adx_a ? "🟢" : "⚪", text_size=size.tiny)
    // linha MACD 60m (últimos cruzamentos)
    table.cell(rdp, 0, 4, "MACD 60m",    bgcolor=color.new(color.gray, 40), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 1, 4, "↑ " + fmt_time(last_t_macd60_up), text_size=size.tiny, text_color=color.new(color.green, 0))
    table.cell(rdp, 2, 4, "↓ " + fmt_time(last_t_macd60_dn), text_size=size.tiny, text_color=color.new(color.red, 0))
    table.cell(rdp, 3, 4, macd60_state_buy ? "estado: 🟢" : "estado: 🔴", text_size=size.tiny, text_color=(macd60_state_buy ? color.green : color.red))
    table.cell(rdp, 4, 4, "12/26/9 close", text_size=size.tiny, text_color=color.white)
    // linha legenda das cores
    table.cell(rdp, 0, 5, "Legenda",     bgcolor=color.new(color.gray, 40), text_color=color.white, text_size=size.tiny)
    table.cell(rdp, 1, 5, "3/3=amarelo", text_size=size.tiny, text_color=color.yellow)
    table.cell(rdp, 2, 5, "2/3=laranja", text_size=size.tiny, text_color=color.orange)
    table.cell(rdp, 3, 5, "1/3=cinza",   text_size=size.tiny, text_color=color.gray)
    table.cell(rdp, 4, 5, "hoje HH:MM · outro DD/MM HH:MM", text_size=size.tiny, text_color=color.white)

// ============================== SETAS + ALERTAS ==============================
// Fluxo temporal:
//   candle N   : preço toca Fibo 2x → sinaliza cond1 verde (âncora pendente)
//   candle N+1 : um dos 3 indicadores dispara iniciação → gatilho CONFIRMADO
//                a seta é desenhada RETROATIVAMENTE no candle N (offset=-1)
//
// Uso: buy_cond1[1] = "havia âncora no candle anterior";
//      buy_extras_score >= min_extras neste candle = "acaba de confirmar agora"

// Confirmação AGORA = usa buy_signal_new que já leva cooldown em conta
// (evita bug: bars_since_buy_sig é resetado antes desta linha ser avaliada)
buy_confirmed_now  = buy_signal_new
sell_confirmed_now = sell_signal_new

// Seta amarela de AVISO no candle do toque (antes de qualquer confirmação)
plotshape(show_alert and fibo_touch_buy_alert,  title="AVISO 2º toque SUP", location=location.belowbar, color=color.yellow, style=shape.diamond, size=size.tiny, text="!")
plotshape(show_alert and fibo_touch_sell_alert, title="AVISO 2º toque RES", location=location.abovebar, color=color.yellow, style=shape.diamond, size=size.tiny, text="!")

// Gate v13 legado (2º toque + Estoc 1m + TRIX 5m). Toggle via input gate_mode.
show_v13 = gate_mode == "v13_legacy" or gate_mode == "ambos"
plotshape(buy_confirmed_now  and show_v13, title="GATILHO COMPRA", location=location.belowbar, color=color.green, style=shape.triangleup,   size=size.small, text="BUY")
plotshape(sell_confirmed_now and show_v13, title="GATILHO VENDA",  location=location.abovebar, color=color.red,   style=shape.triangledown, size=size.small, text="SELL")

// Gate v14 (2º toque em Fibo + fechamento na direção → entra na abertura do seguinte).
// Balão preenchido no candle da ENTRADA (candle N+1 ao armed).
show_v14 = gate_mode == "v14_close" or gate_mode == "ambos"
plotshape(buy_signal_v14  and show_v14, title="GATILHO COMPRA v14", location=location.belowbar, color=color.new(color.green, 0), style=shape.labelup,   size=size.normal, text="BUYv14",  textcolor=color.white)
plotshape(sell_signal_v14 and show_v14, title="GATILHO VENDA v14",  location=location.abovebar, color=color.new(color.red,   0), style=shape.labeldown, size=size.normal, text="SELLv14", textcolor=color.white)

alertcondition(buy_signal_v14 or sell_signal_v14,
     title="Eixo WIN — Gatilho v14 (2º toque + fecha)",
     message="{{ticker}} @ {{close}} | GATE v14: 2º toque em Fibo + fecha na direção — entrada nesta abertura")

// Sinal PREMIUM 4/4 — estrela dourada quando congruência total (5+15+30+60) alinha
buy_confirmed_44  = buy_confirmed_now  and cong44_buy_score  == 4
sell_confirmed_44 = sell_confirmed_now and cong44_sell_score == 4
plotshape(buy_confirmed_44,  title="4/4 COMPRA PREMIUM", location=location.belowbar, color=color.yellow, style=shape.arrowup, size=size.normal, text="★ 4/4 BUY")
plotshape(sell_confirmed_44, title="4/4 VENDA PREMIUM",  location=location.abovebar, color=color.yellow, style=shape.arrowdown, size=size.normal, text="★ 4/4 SELL")

alertcondition(fibo_touch_buy_alert or fibo_touch_sell_alert,
     title="Eixo WIN — Aviso 2º toque",
     message="{{ticker}} @ {{close}} | 2º toque no Fibo — aguardando confirmação")

alertcondition(buy_confirmed_now or sell_confirmed_now,
     title="Eixo WIN — Gatilho confirmado",
     message="{{ticker}} @ {{close}} | Gatilho confirmado (toque anterior + iniciação agora)")

alertcondition(buy_confirmed_44 or sell_confirmed_44,
     title="Eixo WIN — Convergência 4/4 PREMIUM",
     message="{{ticker}} @ {{close}} | 4/4 CONVERGÊNCIA TOTAL — todos os TFs (5+15+30+60) alinhados")

// Scale-out parcial: TF virou contra + tocou Fibo → sair 5 contratos por TF flipado
plotshape(scale_out_buy_now,  title="SAIR (COMPRA)", location=location.abovebar, color=color.new(color.orange, 0), style=shape.xcross,   size=size.small, text="↓5×N")
plotshape(scale_out_sell_now, title="SAIR (VENDA)",  location=location.belowbar, color=color.new(color.orange, 0), style=shape.xcross,   size=size.small, text="↑5×N")

alertcondition(scale_out_buy_now or scale_out_sell_now,
     title="Eixo WIN — Scale-out parcial",
     message="{{ticker}} @ {{close}} | Um TF virou contra + tocou Fibo — sair 5 contratos por TF flipado")

// Plots hidden de debug removidos — Pine v5 limita 64 plots totais

// ============================== SETAS MTF (4 TFs) — INDICADORES INDIVIDUAIS ==
// v14: label dinâmico com formato "<TF>.<indicadores>" onde:
//   TF:     1=5m · 2=15m · 3=30m · 4=60m
//   Indic:  1=Estocástico Lento · 2=TRIX · 3=DI±
// Exemplos:
//   4.1.2.3  → 60m, os 3 indicadores compraram
//   2.3      → 15m, só DI comprou
//   1.1.2    → 5m, Estoc + TRIX compraram
// Seta 🔺 abaixo do candle = COMPRA. Seta 🔻 acima = VENDA.
// Label é criado quando o score do TF SOBE naquele candle (transição pra mais forte).

// Detecta subida de score por TF/direção (evita spam ao mover pra baixo)
up_5m_buy    = score_5m_buy   > score_5m_buy[1]   and score_5m_buy   >= 1
up_5m_sell   = score_5m_sell  > score_5m_sell[1]  and score_5m_sell  >= 1
up_15m_buy   = score_15m_buy  > score_15m_buy[1]  and score_15m_buy  >= 1
up_15m_sell  = score_15m_sell > score_15m_sell[1] and score_15m_sell >= 1
up_30m_buy   = score_30m_buy  > score_30m_buy[1]  and score_30m_buy  >= 1
up_30m_sell  = score_30m_sell > score_30m_sell[1] and score_30m_sell >= 1
up_60m_buy   = score_60m_buy  > score_60m_buy[1]  and score_60m_buy  >= 1
up_60m_sell  = score_60m_sell > score_60m_sell[1] and score_60m_sell >= 1

// Monta o código de indicadores ex: "1.2.3" ou "2" ou "1.3"
build_ind_code(sb, tb, db) =>
    parts = ""
    if sb
        parts := "1"
    if tb
        parts := parts == "" ? "2" : parts + ".2"
    if db
        parts := parts == "" ? "3" : parts + ".3"
    parts

mtf_sz = size_from_str(mtf_label_size)

// Lane vertical por TF: 5m mais próximo do candle, 60m mais afastado.
// Isso resolve sobreposição quando múltiplos TFs viram no mesmo candle ou próximos.
// ATR do 1m usado como escala — se ATR baixo, labels ficam juntos; se alto, se separam.
atr_lane = ta.atr(14)
lane_1 = atr_lane * 0.8   // 5m
lane_2 = atr_lane * 2.0   // 15m
lane_3 = atr_lane * 3.2   // 30m
lane_4 = atr_lane * 4.4   // 60m

// 5m — labels dinâmicos (lane 1)
if show_5m_cmb and up_5m_buy
    txt = "1." + build_ind_code(s5_stoch_b, s5_trix_b, s5_dmi_b)
    label.new(bar_index, low - lane_1, txt, style=label.style_label_up, color=color.new(color.aqua, 0), textcolor=color.white, size=mtf_sz, yloc=yloc.price)
if show_5m_cmb and up_5m_sell
    txt = "1." + build_ind_code(s5_stoch_s, s5_trix_s, s5_dmi_s)
    label.new(bar_index, high + lane_1, txt, style=label.style_label_down, color=color.new(color.aqua, 0), textcolor=color.white, size=mtf_sz, yloc=yloc.price)

// 15m (lane 2)
if show_15m_cmb and up_15m_buy
    txt = "2." + build_ind_code(s15_stoch_b, s15_trix_b, s15_dmi_b)
    label.new(bar_index, low - lane_2, txt, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=mtf_sz, yloc=yloc.price)
if show_15m_cmb and up_15m_sell
    txt = "2." + build_ind_code(s15_stoch_s, s15_trix_s, s15_dmi_s)
    label.new(bar_index, high + lane_2, txt, style=label.style_label_down, color=color.new(color.lime, 0), textcolor=color.black, size=mtf_sz, yloc=yloc.price)

// 30m (lane 3)
if show_30m_cmb and up_30m_buy
    txt = "3." + build_ind_code(s30_stoch_b, s30_trix_b, s30_dmi_b)
    label.new(bar_index, low - lane_3, txt, style=label.style_label_up, color=color.new(color.orange, 0), textcolor=color.white, size=mtf_sz, yloc=yloc.price)
if show_30m_cmb and up_30m_sell
    txt = "3." + build_ind_code(s30_stoch_s, s30_trix_s, s30_dmi_s)
    label.new(bar_index, high + lane_3, txt, style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=mtf_sz, yloc=yloc.price)

// 60m (lane 4)
if show_60m_cmb and up_60m_buy
    txt = "4." + build_ind_code(s60_stoch_b, s60_trix_b, s60_dmi_b)
    label.new(bar_index, low - lane_4, txt, style=label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=mtf_sz, yloc=yloc.price)
if show_60m_cmb and up_60m_sell
    txt = "4." + build_ind_code(s60_stoch_s, s60_trix_s, s60_dmi_s)
    label.new(bar_index, high + lane_4, txt, style=label.style_label_down, color=color.new(color.purple, 0), textcolor=color.white, size=mtf_sz, yloc=yloc.price)

// ============================== MARCA MACD 60m (CONTEXTO MÉDIO PRAZO) ========
// Marca compacta "M60" cinza no candle do cruzamento. Não pontua no score.
plotshape(show_macd60 and macd60_cross_up,  title="MACD 60m COMPRA", location=location.belowbar, color=color.new(color.gray, 0), style=shape.labelup,   size=size.small, text="M60", textcolor=color.white)
plotshape(show_macd60 and macd60_cross_dn,  title="MACD 60m VENDA",  location=location.abovebar, color=color.new(color.gray, 0), style=shape.labeldown, size=size.small, text="M60", textcolor=color.white)

alertcondition(macd60_cross_up or macd60_cross_dn,
     title="Eixo WIN — MACD 60m cruzamento",
     message="{{ticker}} @ {{close}} | MACD 60m cruzou — filtro contextual médio prazo")

// ============================== MARCA ADX (INTENSIFICADOR DIRECIONAL) ========
// ▲ SETA CIMA (labelup, abaixo do candle): ADX cruzou 30↑ E score 2/3 pra COMPRA
// ▼ SETA BAIXO (labeldown, acima do candle): ADX cruzou 30↑ E score 2/3 pra VENDA
// Exaustão (perda de topo) NÃO aparece no gráfico — só no Painel MTF (⚪ADX)
// e na tabela comparadora ADX MTF (Δ topo colorido). Chart já tem markers demais.

adx_activate_5m  = s5_adx_a  and not s5_adx_a[1]
adx_activate_15m = s15_adx_a and not s15_adx_a[1]
adx_activate_30m = s30_adx_a and not s30_adx_a[1]
adx_activate_60m = s60_adx_a and not s60_adx_a[1]

// ▲ Up markers = favorável ENTRADA COMPRA (ADX ignitando + 2/3 direcional buy)
adx_mark_5m_buy  = adx_activate_5m  and score_5m_buy  >= 2
adx_mark_15m_buy = adx_activate_15m and score_15m_buy >= 2
adx_mark_30m_buy = adx_activate_30m and score_30m_buy >= 2
adx_mark_60m_buy = adx_activate_60m and score_60m_buy >= 2

// ▼ Down markers = favorável ENTRADA VENDA (ADX ignitando + 2/3 direcional sell)
adx_mark_5m_sell  = adx_activate_5m  and score_5m_sell  >= 2
adx_mark_15m_sell = adx_activate_15m and score_15m_sell >= 2
adx_mark_30m_sell = adx_activate_30m and score_30m_sell >= 2
adx_mark_60m_sell = adx_activate_60m and score_60m_sell >= 2

// ============================== TABELA COMPARADOR ADX MTF ====================
var table tadx = table.new(position.middle_left, 5, 4, border_width=1)

// Helpers top-level (Pine v5 não aceita função dentro de if)
f_adx_bg(v)       => v >= 70 ? color.new(color.red, 40) : v >= 50 ? color.new(color.orange, 50) : v >= 30 ? color.new(color.green, 50) : color.new(color.gray, 70)
f_arr(cur, prev)  => cur > prev ? "▲" : cur < prev ? "▼" : "—"
f_cor_d(d, thr)   => d <= -thr ? color.new(color.red, 40) : d <= -thr/2 ? color.new(color.orange, 50) : color.new(color.gray, 70)

if barstate.islast and show_adx_cmp
    hdr = color.new(color.blue, 25)
    txt = color.white

    table.cell(tadx, 0, 0, "ADX",  bgcolor=hdr, text_color=txt)
    table.cell(tadx, 1, 0, "5m",   bgcolor=hdr, text_color=txt)
    table.cell(tadx, 2, 0, "15m",  bgcolor=hdr, text_color=txt)
    table.cell(tadx, 3, 0, "30m",  bgcolor=hdr, text_color=txt)
    table.cell(tadx, 4, 0, "60m",  bgcolor=hdr, text_color=txt)

    table.cell(tadx, 0, 1, "Atual", text_color=txt)
    table.cell(tadx, 1, 1, str.tostring(adx5,  "#.#") + " " + f_arr(adx5,  adx5[1]),  bgcolor=f_adx_bg(adx5),  text_color=txt)
    table.cell(tadx, 2, 1, str.tostring(adx15, "#.#") + " " + f_arr(adx15, adx15[1]), bgcolor=f_adx_bg(adx15), text_color=txt)
    table.cell(tadx, 3, 1, str.tostring(adx30, "#.#") + " " + f_arr(adx30, adx30[1]), bgcolor=f_adx_bg(adx30), text_color=txt)
    table.cell(tadx, 4, 1, str.tostring(adx60, "#.#") + " " + f_arr(adx60, adx60[1]), bgcolor=f_adx_bg(adx60), text_color=txt)

    table.cell(tadx, 0, 2, "Topo dia", text_color=txt)
    table.cell(tadx, 1, 2, str.tostring(adx5_peak,  "#.#"), bgcolor=f_adx_bg(adx5_peak),  text_color=txt)
    table.cell(tadx, 2, 2, str.tostring(adx15_peak, "#.#"), bgcolor=f_adx_bg(adx15_peak), text_color=txt)
    table.cell(tadx, 3, 2, str.tostring(adx30_peak, "#.#"), bgcolor=f_adx_bg(adx30_peak), text_color=txt)
    table.cell(tadx, 4, 2, str.tostring(adx60_peak, "#.#"), bgcolor=f_adx_bg(adx60_peak), text_color=txt)

    d5  = adx5_peak  > 0 ? (adx5  - adx5_peak)  / adx5_peak  * 100 : 0.0
    d15 = adx15_peak > 0 ? (adx15 - adx15_peak) / adx15_peak * 100 : 0.0
    d30 = adx30_peak > 0 ? (adx30 - adx30_peak) / adx30_peak * 100 : 0.0
    d60 = adx60_peak > 0 ? (adx60 - adx60_peak) / adx60_peak * 100 : 0.0

    table.cell(tadx, 0, 3, "Δ topo", text_color=txt)
    table.cell(tadx, 1, 3, str.tostring(d5,  "#.#") + "%", bgcolor=f_cor_d(d5,  adx_drop_pct), text_color=txt)
    table.cell(tadx, 2, 3, str.tostring(d15, "#.#") + "%", bgcolor=f_cor_d(d15, adx_drop_pct), text_color=txt)
    table.cell(tadx, 3, 3, str.tostring(d30, "#.#") + "%", bgcolor=f_cor_d(d30, adx_drop_pct), text_color=txt)
    table.cell(tadx, 4, 3, str.tostring(d60, "#.#") + "%", bgcolor=f_cor_d(d60, adx_drop_pct), text_color=txt)

// ADX markers agora usam o MESMO sistema de lanes dos MTF combos +
// 1 candle à direita, pra não sobrepor com "1.x", "2.x", "3.x", "4.x".
// Cada A{N} sai na lane do seu TF, um bar depois do trigger.
adx_off = 1  // bars à direita do trigger

if adx_mark_5m_buy
    label.new(bar_index + adx_off, low  - lane_1, "A5",  style=label.style_label_up,   color=color.new(color.aqua,   0), textcolor=color.white, size=size.tiny, yloc=yloc.price)
if adx_mark_5m_sell
    label.new(bar_index + adx_off, high + lane_1, "A5",  style=label.style_label_down, color=color.new(color.aqua,   0), textcolor=color.white, size=size.tiny, yloc=yloc.price)
if adx_mark_15m_buy
    label.new(bar_index + adx_off, low  - lane_2, "A15", style=label.style_label_up,   color=color.new(color.lime,   0), textcolor=color.black, size=size.tiny, yloc=yloc.price)
if adx_mark_15m_sell
    label.new(bar_index + adx_off, high + lane_2, "A15", style=label.style_label_down, color=color.new(color.lime,   0), textcolor=color.black, size=size.tiny, yloc=yloc.price)
if adx_mark_30m_buy
    label.new(bar_index + adx_off, low  - lane_3, "A30", style=label.style_label_up,   color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny, yloc=yloc.price)
if adx_mark_30m_sell
    label.new(bar_index + adx_off, high + lane_3, "A30", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny, yloc=yloc.price)
if adx_mark_60m_buy
    label.new(bar_index + adx_off, low  - lane_4, "A60", style=label.style_label_up,   color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, yloc=yloc.price)
if adx_mark_60m_sell
    label.new(bar_index + adx_off, high + lane_4, "A60", style=label.style_label_down, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, yloc=yloc.price)

// ============================== CALCULADORA DE PONTOS (LIVE) ================
// Preencha só a Entrada + Direção + Contratos. Saída = 0 usa preço ao vivo.
// Coloca valor em Saída pra congelar o resultado.
// WIN: 1 ponto = R$ 0,20 por contrato.
grp_calc   = "Calculadora de Pontos"
calc_on    = input.bool(true,  "Mostrar calculadora",                group=grp_calc)
calc_dir   = input.string("Compra", "Direção", options=["Compra","Venda"], group=grp_calc)
calc_entry = input.float(0.0, "Entrada",             step=5, group=grp_calc)
calc_exit  = input.float(0.0, "Saída (0 = ao vivo)", step=5, group=grp_calc)
calc_qty   = input.int(1,     "Contratos", minval=1, group=grp_calc)

var table tcalc = table.new(position.bottom_right, 2, 5, border_width=1)
f_fmt(v) => str.tostring(v, "#.#")

if calc_on and barstate.islast
    ativo    = calc_entry > 0
    usa_live = calc_exit <= 0
    saida_v  = usa_live ? close : calc_exit
    saida_lb = usa_live ? "AO VIVO" : "SAÍDA FIXA"
    pts      = not ativo ? 0.0 : (calc_dir == "Compra" ? saida_v - calc_entry : calc_entry - saida_v)
    rs_tot   = pts * 0.20 * calc_qty
    cor      = not ativo ? color.new(color.gray, 60) : (pts >= 0 ? color.new(color.green, 55) : color.new(color.red, 55))
    hdr      = color.new(color.blue, 25)
    txt      = color.white

    table.cell(tcalc, 0, 0, saida_lb,                        bgcolor=hdr, text_color=txt)
    table.cell(tcalc, 1, 0, calc_dir,                        bgcolor=hdr, text_color=txt)
    table.cell(tcalc, 0, 1, "Entrada",                       text_color=txt)
    table.cell(tcalc, 1, 1, ativo ? f_fmt(calc_entry) : "—", text_color=txt)
    table.cell(tcalc, 0, 2, "Preço atual",                   text_color=txt)
    table.cell(tcalc, 1, 2, f_fmt(saida_v),                  text_color=txt)
    table.cell(tcalc, 0, 3, "Pontos",                        bgcolor=cor, text_color=txt)
    table.cell(tcalc, 1, 3, ativo ? f_fmt(pts) : "—",        bgcolor=cor, text_color=txt)
    table.cell(tcalc, 0, 4, "R$ ×" + str.tostring(calc_qty), bgcolor=cor, text_color=txt)
    table.cell(tcalc, 1, 4, ativo ? "R$ " + str.tostring(rs_tot, "#.##") : "—", bgcolor=cor, text_color=txt)

// ============================== TRADE BLOTTER (v14.8) ========================
// 10 EVENTOS individuais. Cada evento tem sua PRÓPRIA ação (Compra ou Venda),
// Qtd e Preço. A calculadora rastreia:
//   - Posição líquida (LONG / SHORT / FLAT) via soma cumulativa
//   - Preço médio ponderado das compras e vendas
//   - P&L realizado (parte fechada) + P&L aberto (parte ainda em posição, live)
//   - TOTAL da sessão em pontos + R$
//
// Exemplo do usuário (05/08):
//   Ev1  09:08  Compra 4c @ 179030
//   Ev2  09:50  Venda  2c @ 179100
//   Ev3  10:08  Compra 2c @ 179050
//   Ev4  10:15  Venda  2c @ 179150
//   Ev5  10:35  Compra 2c @ 179080
//   → Total: 8c comprados · 4c vendidos → LONG 4c abertos
//   → 4c fechados com P&L realizado + 4c abertos com P&L live vs preço atual
grp_bl     = "Trade Blotter (10 eventos, cada um Compra ou Venda)"
show_bl    = input.bool(true, "Mostrar setas de eventos no gráfico", group=grp_bl)
show_bl_tb = input.bool(true, "Mostrar tabela BLOTTER",               group=grp_bl)

// -------- 10 eventos: Data/Hora + Ação + Qtd + Preço --------
ev1_t   = input.time(timestamp("2020-01-01T00:00"), "Ev1 Data/Hora", group=grp_bl, inline="ev1")
ev1_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev1")
ev1_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev1")
ev1_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev1")

ev2_t   = input.time(timestamp("2020-01-01T00:00"), "Ev2 Data/Hora", group=grp_bl, inline="ev2")
ev2_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev2")
ev2_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev2")
ev2_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev2")

ev3_t   = input.time(timestamp("2020-01-01T00:00"), "Ev3 Data/Hora", group=grp_bl, inline="ev3")
ev3_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev3")
ev3_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev3")
ev3_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev3")

ev4_t   = input.time(timestamp("2020-01-01T00:00"), "Ev4 Data/Hora", group=grp_bl, inline="ev4")
ev4_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev4")
ev4_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev4")
ev4_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev4")

ev5_t   = input.time(timestamp("2020-01-01T00:00"), "Ev5 Data/Hora", group=grp_bl, inline="ev5")
ev5_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev5")
ev5_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev5")
ev5_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev5")

ev6_t   = input.time(timestamp("2020-01-01T00:00"), "Ev6 Data/Hora", group=grp_bl, inline="ev6")
ev6_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev6")
ev6_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev6")
ev6_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev6")

ev7_t   = input.time(timestamp("2020-01-01T00:00"), "Ev7 Data/Hora", group=grp_bl, inline="ev7")
ev7_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev7")
ev7_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev7")
ev7_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev7")

ev8_t   = input.time(timestamp("2020-01-01T00:00"), "Ev8 Data/Hora", group=grp_bl, inline="ev8")
ev8_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev8")
ev8_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev8")
ev8_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev8")

ev9_t   = input.time(timestamp("2020-01-01T00:00"), "Ev9 Data/Hora", group=grp_bl, inline="ev9")
ev9_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev9")
ev9_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev9")
ev9_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev9")

ev10_t   = input.time(timestamp("2020-01-01T00:00"), "Ev10 Data/Hora", group=grp_bl, inline="ev10")
ev10_act = input.string("Compra", "", options=["Compra","Venda"],     group=grp_bl, inline="ev10")
ev10_qty = input.int(1, "Qtd", minval=1,                              group=grp_bl, inline="ev10")
ev10_p   = input.price(0.0, "Preço",                                  group=grp_bl, inline="ev10")

// -------- Agregações --------
f_qty_if(target_act, ev_act, qty, p) => (ev_act == target_act and p > 0) ? qty : 0
f_ntl_if(target_act, ev_act, qty, p) => (ev_act == target_act and p > 0) ? qty * p : 0.0

total_bought =
     f_qty_if("Compra", ev1_act, ev1_qty, ev1_p) + f_qty_if("Compra", ev2_act, ev2_qty, ev2_p) +
     f_qty_if("Compra", ev3_act, ev3_qty, ev3_p) + f_qty_if("Compra", ev4_act, ev4_qty, ev4_p) +
     f_qty_if("Compra", ev5_act, ev5_qty, ev5_p) + f_qty_if("Compra", ev6_act, ev6_qty, ev6_p) +
     f_qty_if("Compra", ev7_act, ev7_qty, ev7_p) + f_qty_if("Compra", ev8_act, ev8_qty, ev8_p) +
     f_qty_if("Compra", ev9_act, ev9_qty, ev9_p) + f_qty_if("Compra", ev10_act, ev10_qty, ev10_p)

total_sold =
     f_qty_if("Venda", ev1_act, ev1_qty, ev1_p) + f_qty_if("Venda", ev2_act, ev2_qty, ev2_p) +
     f_qty_if("Venda", ev3_act, ev3_qty, ev3_p) + f_qty_if("Venda", ev4_act, ev4_qty, ev4_p) +
     f_qty_if("Venda", ev5_act, ev5_qty, ev5_p) + f_qty_if("Venda", ev6_act, ev6_qty, ev6_p) +
     f_qty_if("Venda", ev7_act, ev7_qty, ev7_p) + f_qty_if("Venda", ev8_act, ev8_qty, ev8_p) +
     f_qty_if("Venda", ev9_act, ev9_qty, ev9_p) + f_qty_if("Venda", ev10_act, ev10_qty, ev10_p)

notional_bought =
     f_ntl_if("Compra", ev1_act, ev1_qty, ev1_p) + f_ntl_if("Compra", ev2_act, ev2_qty, ev2_p) +
     f_ntl_if("Compra", ev3_act, ev3_qty, ev3_p) + f_ntl_if("Compra", ev4_act, ev4_qty, ev4_p) +
     f_ntl_if("Compra", ev5_act, ev5_qty, ev5_p) + f_ntl_if("Compra", ev6_act, ev6_qty, ev6_p) +
     f_ntl_if("Compra", ev7_act, ev7_qty, ev7_p) + f_ntl_if("Compra", ev8_act, ev8_qty, ev8_p) +
     f_ntl_if("Compra", ev9_act, ev9_qty, ev9_p) + f_ntl_if("Compra", ev10_act, ev10_qty, ev10_p)

notional_sold =
     f_ntl_if("Venda", ev1_act, ev1_qty, ev1_p) + f_ntl_if("Venda", ev2_act, ev2_qty, ev2_p) +
     f_ntl_if("Venda", ev3_act, ev3_qty, ev3_p) + f_ntl_if("Venda", ev4_act, ev4_qty, ev4_p) +
     f_ntl_if("Venda", ev5_act, ev5_qty, ev5_p) + f_ntl_if("Venda", ev6_act, ev6_qty, ev6_p) +
     f_ntl_if("Venda", ev7_act, ev7_qty, ev7_p) + f_ntl_if("Venda", ev8_act, ev8_qty, ev8_p) +
     f_ntl_if("Venda", ev9_act, ev9_qty, ev9_p) + f_ntl_if("Venda", ev10_act, ev10_qty, ev10_p)

avg_buy  = total_bought > 0 ? notional_bought / total_bought : 0.0
avg_sell = total_sold   > 0 ? notional_sold   / total_sold   : 0.0

net_pos    = total_bought - total_sold   // positive = LONG, negative = SHORT, 0 = FLAT
is_long    = net_pos > 0
is_short   = net_pos < 0
closed_qty = math.min(total_bought, total_sold)

// P&L realizado sobre a parte fechada (uses weighted avg)
realized_pnl_pts = (avg_buy > 0 and avg_sell > 0 and closed_qty > 0) ? (avg_sell - avg_buy) * closed_qty : 0.0
realized_pnl_rs  = realized_pnl_pts * 0.20

// P&L aberto: LONG usa avg_buy como custo, SHORT usa avg_sell
open_pnl_pts = is_long  ? (close - avg_buy)  * net_pos      :
              (is_short ? (avg_sell - close) * (-net_pos)   : 0.0)
open_pnl_rs  = open_pnl_pts * 0.20

grand_total_pts = realized_pnl_pts + open_pnl_pts
grand_total_rs  = realized_pnl_rs  + open_pnl_rs

// -------- Tabela BLOTTER --------
var table tbl = table.new(position.middle_right, 2, 10, border_width=1)

if barstate.islast and show_bl_tb
    hdr    = color.new(color.blue, 25)
    txt    = color.white
    cor_r  = realized_pnl_pts >= 0 ? color.new(color.green, 55) : color.new(color.red, 55)
    cor_o  = open_pnl_pts     >= 0 ? color.new(color.green, 55) : color.new(color.red, 55)
    cor_t  = grand_total_pts  >= 0 ? color.new(color.green, 30) : color.new(color.red, 30)
    dir_lbl = is_long  ? "LONG "  + str.tostring(net_pos)  + "c" :
              (is_short ? "SHORT " + str.tostring(-net_pos) + "c" : "FLAT")

    table.cell(tbl, 0, 0, "BLOTTER",         bgcolor=hdr, text_color=txt)
    table.cell(tbl, 1, 0, dir_lbl,           bgcolor=hdr, text_color=txt)
    table.cell(tbl, 0, 1, "Compras totais",  text_color=txt)
    table.cell(tbl, 1, 1, str.tostring(total_bought) + "c" + (avg_buy > 0 ? " @ " + str.tostring(avg_buy, "#.#") : ""), text_color=txt)
    table.cell(tbl, 0, 2, "Vendas totais",   text_color=txt)
    table.cell(tbl, 1, 2, str.tostring(total_sold) + "c" + (avg_sell > 0 ? " @ " + str.tostring(avg_sell, "#.#") : ""), text_color=txt)
    table.cell(tbl, 0, 3, "Fechados",        text_color=txt)
    table.cell(tbl, 1, 3, str.tostring(closed_qty) + "c", text_color=txt)
    table.cell(tbl, 0, 4, "Posição aberta",  text_color=txt)
    table.cell(tbl, 1, 4, dir_lbl, text_color=txt)
    table.cell(tbl, 0, 5, "Preço atual",     text_color=txt)
    table.cell(tbl, 1, 5, str.tostring(close, "#.#"), text_color=txt)
    table.cell(tbl, 0, 6, "P&L realizado",   bgcolor=cor_r, text_color=txt)
    table.cell(tbl, 1, 6, str.tostring(realized_pnl_pts, "#") + "pts · R$" + str.tostring(realized_pnl_rs, "#.##"), bgcolor=cor_r, text_color=txt)
    table.cell(tbl, 0, 7, "P&L aberto",      bgcolor=cor_o, text_color=txt)
    table.cell(tbl, 1, 7, str.tostring(open_pnl_pts, "#") + "pts · R$" + str.tostring(open_pnl_rs, "#.##"), bgcolor=cor_o, text_color=txt)
    table.cell(tbl, 0, 8, "TOTAL",           bgcolor=cor_t, text_color=txt)
    table.cell(tbl, 1, 8, str.tostring(grand_total_pts, "#") + "pts · R$" + str.tostring(grand_total_rs, "#.##"), bgcolor=cor_t, text_color=txt)
    table.cell(tbl, 0, 9, "Eventos",         text_color=txt)
    table.cell(tbl, 1, 9, "Compra=azul · Venda=laranja", text_color=txt)

// -------- Desenha setas por evento --------
// Compra = azul (▲ BUY abaixo do candle)
// Venda  = laranja (▼ SELL acima do candle)
f_draw_ev(idx, et, act, qty, p) =>
    if p > 0 and time <= et and time_close > et
        is_buy = act == "Compra"
        cor  = is_buy ? color.new(color.blue, 0) : color.new(color.orange, 0)
        seta = is_buy ? "▲ BUY" : "▼ SELL"
        stl  = is_buy ? label.style_label_down : label.style_label_up
        label.new(bar_index, p,
             "Ev" + str.tostring(idx) + " " + seta + " " + str.tostring(qty) + "c @ " + str.tostring(p, "#.#"),
             color=cor, textcolor=color.white, style=stl, size=size.small)

if show_bl
    f_draw_ev(1,  ev1_t,  ev1_act,  ev1_qty,  ev1_p)
    f_draw_ev(2,  ev2_t,  ev2_act,  ev2_qty,  ev2_p)
    f_draw_ev(3,  ev3_t,  ev3_act,  ev3_qty,  ev3_p)
    f_draw_ev(4,  ev4_t,  ev4_act,  ev4_qty,  ev4_p)
    f_draw_ev(5,  ev5_t,  ev5_act,  ev5_qty,  ev5_p)
    f_draw_ev(6,  ev6_t,  ev6_act,  ev6_qty,  ev6_p)
    f_draw_ev(7,  ev7_t,  ev7_act,  ev7_qty,  ev7_p)
    f_draw_ev(8,  ev8_t,  ev8_act,  ev8_qty,  ev8_p)
    f_draw_ev(9,  ev9_t,  ev9_act,  ev9_qty,  ev9_p)
    f_draw_ev(10, ev10_t, ev10_act, ev10_qty, ev10_p)
