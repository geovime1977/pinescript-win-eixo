// @version=5
// -----------------------------------------------------------------------------
// Eixo Estratégico — WIN Day Trade | Indicador de Sinais X/4 (parametrizável)
// -----------------------------------------------------------------------------
// APLICAR ESTE INDICADOR NO GRÁFICO DE 1 MINUTO DO ATIVO WIN.
// Timeframe operacional: 1min | Contexto: 5m (TRIX, ADX), 15/30/60m (congruência)
// Fibonacci: primeiro candle 5min do dia
// -----------------------------------------------------------------------------

indicator("Eixo WIN — Sinais X/4", overlay=true,
     max_lines_count=100, max_labels_count=100, max_boxes_count=50)

// ============================== PARÂMETROS ==================================
grpFibo   = "Fibonacci"
show_fibo = input.bool(true,  "Mostrar níveis Fibo",              group=grpFibo)
show_all  = input.bool(true,  "Mostrar todos os 20 níveis",        group=grpFibo)
tol_pct   = input.float(0.05, "Tolerância de toque (%)",           group=grpFibo, minval=0.01, step=0.01)

grpSig    = "Sinais"
cross_win = input.int(3, "Janela de iniciação (candles)",          group=grpSig, minval=1, maxval=10, tooltip="Quantos candles atrás o cruzamento/iniciação de um indicador ainda conta como fresh. 1 = estrito (só cruzou neste candle); 3 = default; 10 = permissivo.")
gap_bars  = input.int(3, "Gap mínimo entre eventos de toque",       group=grpSig, minval=1, maxval=20)
reset_gap = input.int(15, "Reset do contador após N candles sem tocar", group=grpSig, minval=3, maxval=100, tooltip="Se o preço fica N candles longe do nível (não toca), o contador de toques reseta para 0. Assim, um novo par 1º+2º toque no mesmo nível vira novo aviso amarelo.")
adx_min   = input.float(25.0, "ADX mínimo pra congruência TF sup.", group=grpSig, step=1)
sig_cooldown     = input.int(5, "Cooldown entre sinais (candles)",     group=grpSig, minval=1, maxval=60)
max_gap_touches  = input.int(10, "Máx. candles entre 1º e 2º toque",   group=grpSig, minval=2, maxval=50, tooltip="Se o 2º toque no mesmo Fibo demorar mais que N candles, o setup expira. O próximo toque vira novo 1º toque.")
wait_after_touch = input.int(1, "Janela pra confirmação após 2º toque (candles)", group=grpSig, minval=1, maxval=30, tooltip="Cross de Estoc 1m ou TRIX 5m vale entre o 2º toque e até N candles depois. Default 1 = apenas o candle do toque + próximo. Cross fora dessa janela é ignorado.")
min_extras       = input.int(1, "Mín. confirmações (Estoc 1m / TRIX 5m)", group=grpSig, minval=1, maxval=2)
show_alert   = input.bool(true, "Mostrar seta amarela de AVISO no 2º toque", group=grpSig, tooltip="Aviso visual do 2º toque, ANTES de qualquer confirmação — serve pra você se preparar.")
adx_bonus    = input.int(5, "Bônus de contratos quando ADX 5m intensifica", group=grpSig, minval=0, maxval=10, tooltip="ADX 5m cruzou 30 pra cima OU está descendo entre 70-80 → +N contratos no sizing base (capado em 25).")
sizing_cap   = input.int(25, "Cap máximo de contratos",                  group=grpSig, minval=5, maxval=100)

grpMTF = "Setas MTF (Setup por Timeframe)"
show_5m_cmb  = input.bool(true, "5m — sinal combinado (Estoc+TRIX+ADX+DMI alinhados)",  group=grpMTF)
show_15m_cmb = input.bool(true, "15m — sinal combinado",                                group=grpMTF)
show_30m_cmb = input.bool(true, "30m — sinal combinado",                                group=grpMTF)
show_60m_cmb = input.bool(true, "60m — sinal combinado",                                group=grpMTF)

grpPnl     = "Painel"
show_panel = input.bool(true, "Mostrar painel de sinais",           group=grpPnl)
panel_pos  = input.string("top_right", "Posição do painel", options=["top_right","top_left","bottom_right","bottom_left"], group=grpPnl)

// ============================== HELPERS =====================================
// TRIX manual (Pine v5 não tem ta.trix nativo confiável em request.security)
trix_calc(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema3 = ta.ema(ema2, len)
    ta.roc(ema3, 1)

// ============================== FIBONACCI ===================================
// Puxa high/low do primeiro candle 5min do dia via request.security
get_first5_of_day() =>
    is_first = ta.change(dayofmonth) != 0
    fh = ta.valuewhen(is_first, high, 0)
    fl = ta.valuewhen(is_first, low, 0)
    [fh, fl]

[first5_high, first5_low] = request.security(syminfo.tickerid, "5", get_first5_of_day(), lookahead=barmerge.lookahead_off)
fib_range = first5_high - first5_low
has_base = not na(first5_high) and not na(fib_range) and fib_range > 0

fib_level(direction, pct) =>
    direction == "upper" ? first5_high + (pct / 100.0) * fib_range : first5_low - (pct / 100.0) * fib_range

// Níveis Fibo (Pine v5: uma declaração por linha)
u0 = fib_level("upper", 0)
umid = (first5_high + first5_low) / 2   // ★ meio do 1º candle 5min
u50 = fib_level("upper", 50)
u100 = fib_level("upper", 100)
u150 = fib_level("upper", 150)
u200 = fib_level("upper", 200)
u250 = fib_level("upper", 250)
u300 = fib_level("upper", 300)
u350 = fib_level("upper", 350)
u400 = fib_level("upper", 400)
u450 = fib_level("upper", 450)
l0 = fib_level("lower", 0)
l50 = fib_level("lower", 50)
l100 = fib_level("lower", 100)
l150 = fib_level("lower", 150)
l200 = fib_level("lower", 200)
l250 = fib_level("lower", 250)
l300 = fib_level("lower", 300)
l350 = fib_level("lower", 350)
l400 = fib_level("lower", 400)
l450 = fib_level("lower", 450)

color_sup      = color.new(color.blue, 60)
color_res      = color.new(color.red,  60)
color_sup_mid  = color.new(color.blue, 0)   // sem transparência
color_res_mid  = color.new(color.red,  0)
color_extremo  = color.new(color.black, 0)  // extremos R0/S0 do 1º candle 5min
color_mid_1st  = color.new(color.orange, 0) // meio do 1º candle 5min

plot(show_fibo and has_base ? u0   : na, "★ R0 (topo 1º 5m)", color=color_extremo, linewidth=2)
plot(show_fibo and has_base ? umid : na, "★ MID (meio 1º 5m)", color=color_mid_1st, linewidth=2)
plot(show_fibo and has_base ? u50  : na, "★ R50",    color=color_res_mid, linewidth=2)
plot(show_fibo and has_base ? u100 : na, "R100",     color=color_res)
plot(show_fibo and has_base ? u150 : na, "R150", color=color_res)
plot(show_fibo and has_base ? u200 : na, "R200", color=color_res)
plot(show_fibo and has_base and show_all ? u250 : na, "R250", color=color_res)
plot(show_fibo and has_base and show_all ? u300 : na, "R300", color=color_res)
plot(show_fibo and has_base and show_all ? u350 : na, "R350", color=color_res)
plot(show_fibo and has_base and show_all ? u400 : na, "R400", color=color_res)
plot(show_fibo and has_base and show_all ? u450 : na, "R450", color=color_res)
plot(show_fibo and has_base ? l0   : na, "★ S0 (base 1º 5m)", color=color_extremo, linewidth=2)
plot(show_fibo and has_base ? l50  : na, "★ S50",    color=color_sup_mid, linewidth=2)
plot(show_fibo and has_base ? l100 : na, "S100",     color=color_sup)
plot(show_fibo and has_base ? l150 : na, "S150", color=color_sup)
plot(show_fibo and has_base ? l200 : na, "S200", color=color_sup)
plot(show_fibo and has_base and show_all ? l250 : na, "S250", color=color_sup)
plot(show_fibo and has_base and show_all ? l300 : na, "S300", color=color_sup)
plot(show_fibo and has_base and show_all ? l350 : na, "S350", color=color_sup)
plot(show_fibo and has_base and show_all ? l400 : na, "S400", color=color_sup)
plot(show_fibo and has_base and show_all ? l450 : na, "S450", color=color_sup)

// ============================== INDICADORES 1min (chart) ====================
// Estocástico (5,3) no timeframe do gráfico
stoch_k = ta.stoch(close, high, low, 5)
stoch_d = ta.sma(stoch_k, 3)
stoch_cross_up = ta.crossover(stoch_k, stoch_d)
stoch_cross_dn = ta.crossunder(stoch_k, stoch_d)
stoch_up_recent = ta.barssince(stoch_cross_up) < cross_win
stoch_dn_recent = ta.barssince(stoch_cross_dn) < cross_win

// ============================== INDICADORES 5min via request ================
get_5m_signals() =>
    trix_val = trix_calc(close, 9)
    trix_ma = ta.sma(trix_val, 4)
    tbu = ta.barssince(ta.crossover(trix_val, trix_ma))
    tbd = ta.barssince(ta.crossunder(trix_val, trix_ma))
    [dmp, dmn, adx_v] = ta.dmi(8, 8)
    adx_up_30_r = ta.barssince(ta.crossover(adx_v, 30)) < 3
    adx_between_70_80_dn = adx_v > 70 and adx_v < 80 and adx_v < adx_v[1]
    [tbu, tbd, adx_v, dmp, dmn, adx_up_30_r, adx_between_70_80_dn]

[trix_bars_up_5m, trix_bars_dn_5m, adx5, dmp5, dmn5, adx_up_30_5m, adx_band_dn_5m] = request.security(syminfo.tickerid, "5", get_5m_signals(), lookahead=barmerge.lookahead_off)

// ADX intensificador (5m): também usado para sizing e para congruência 4/4
adx_intensifier = adx_up_30_5m or adx_band_dn_5m

// ============================== TRIX 1min (saída) ===========================
// Saída: 2º cruzamento do TRIX 1m (contra direção do trade)
// Long fecha no 2º trix1m_cross_dn depois da entrada
// Short fecha no 2º trix1m_cross_up depois da entrada
trix1m_val = trix_calc(close, 9)
trix1m_ma  = ta.sma(trix1m_val, 4)
trix1m_cross_up = ta.crossover(trix1m_val, trix1m_ma)
trix1m_cross_dn = ta.crossunder(trix1m_val, trix1m_ma)

// ============================== SETUPS MTF POR TIMEFRAME =====================
// Cada TF é um setup completo com 4 indicadores (Estoc + TRIX + ADX + DMI) daquele TF.
// Sinal combinado dispara na TRANSIÇÃO para "todos os 4 alinhados na mesma direção".
get_htf_states() =>
    k = ta.stoch(close, high, low, 5)
    d = ta.sma(k, 3)
    stoch_b = k > d
    stoch_s = k < d
    tv = trix_calc(close, 9)
    tm = ta.sma(tv, 4)
    trix_b = tv > tm
    trix_s = tv < tm
    [dp, dn, av] = ta.dmi(8, 8)
    adx_a = ta.barssince(ta.crossover(av, 30)) < 3 or (av > 70 and av < 80 and av < av[1])
    dmi_b = dp > dn
    dmi_s = dn > dp
    [stoch_b, stoch_s, trix_b, trix_s, adx_a, dmi_b, dmi_s]

[s5_stoch_b, s5_stoch_s, s5_trix_b, s5_trix_s, s5_adx_a, s5_dmi_b, s5_dmi_s]         = request.security(syminfo.tickerid, "5",  get_htf_states(), lookahead=barmerge.lookahead_off)
[s15_stoch_b, s15_stoch_s, s15_trix_b, s15_trix_s, s15_adx_a, s15_dmi_b, s15_dmi_s]  = request.security(syminfo.tickerid, "15", get_htf_states(), lookahead=barmerge.lookahead_off)
[s30_stoch_b, s30_stoch_s, s30_trix_b, s30_trix_s, s30_adx_a, s30_dmi_b, s30_dmi_s]  = request.security(syminfo.tickerid, "30", get_htf_states(), lookahead=barmerge.lookahead_off)
[s60_stoch_b, s60_stoch_s, s60_trix_b, s60_trix_s, s60_adx_a, s60_dmi_b, s60_dmi_s]  = request.security(syminfo.tickerid, "60", get_htf_states(), lookahead=barmerge.lookahead_off)

// Combinado por TF: 4 states alinhados na mesma direção
cmb_5m_buy_st   = s5_stoch_b  and s5_trix_b  and s5_adx_a  and s5_dmi_b
cmb_5m_sell_st  = s5_stoch_s  and s5_trix_s  and s5_adx_a  and s5_dmi_s
cmb_15m_buy_st  = s15_stoch_b and s15_trix_b and s15_adx_a and s15_dmi_b
cmb_15m_sell_st = s15_stoch_s and s15_trix_s and s15_adx_a and s15_dmi_s
cmb_30m_buy_st  = s30_stoch_b and s30_trix_b and s30_adx_a and s30_dmi_b
cmb_30m_sell_st = s30_stoch_s and s30_trix_s and s30_adx_a and s30_dmi_s
cmb_60m_buy_st  = s60_stoch_b and s60_trix_b and s60_adx_a and s60_dmi_b
cmb_60m_sell_st = s60_stoch_s and s60_trix_s and s60_adx_a and s60_dmi_s

// Sinal = transição (não persiste em candles seguintes)
sig_5m_buy   = cmb_5m_buy_st   and not cmb_5m_buy_st[1]
sig_5m_sell  = cmb_5m_sell_st  and not cmb_5m_sell_st[1]
sig_15m_buy  = cmb_15m_buy_st  and not cmb_15m_buy_st[1]
sig_15m_sell = cmb_15m_sell_st and not cmb_15m_sell_st[1]
sig_30m_buy  = cmb_30m_buy_st  and not cmb_30m_buy_st[1]
sig_30m_sell = cmb_30m_sell_st and not cmb_30m_sell_st[1]
sig_60m_buy  = cmb_60m_buy_st  and not cmb_60m_buy_st[1]
sig_60m_sell = cmb_60m_sell_st and not cmb_60m_sell_st[1]

// ============================== CONGRUÊNCIA MTF (regra completa por TF) =====
// Cada TF é "ativo direcional" quando:
//   (ADX cruzou 30↑ nos últimos 3 candles OU está descendo dentro de 70-80)
//   E DMI aponta a direção (+DI > -DI para compra, oposto para venda)
get_higher_tf() =>
    [dmp, dmn, adx_v] = ta.dmi(8, 8)
    adx_up_30_r = ta.barssince(ta.crossover(adx_v, 30)) < 3
    adx_band_dn = adx_v > 70 and adx_v < 80 and adx_v < adx_v[1]
    adx_active = adx_up_30_r or adx_band_dn
    [dmp, dmn, adx_v, adx_active]

[dmp15, dmn15, adx15, adx_active_15] = request.security(syminfo.tickerid, "15", get_higher_tf(), lookahead=barmerge.lookahead_off)
[dmp30, dmn30, adx30, adx_active_30] = request.security(syminfo.tickerid, "30", get_higher_tf(), lookahead=barmerge.lookahead_off)
[dmp60, dmn60, adx60, adx_active_60] = request.security(syminfo.tickerid, "60", get_higher_tf(), lookahead=barmerge.lookahead_off)

// Alinhamento direcional por TF (agora usa a regra completa ADX>30 fresh OU banda 70-80 caindo)
cong5_buy   = adx_intensifier and dmp5  > dmn5
cong15_buy  = adx_active_15   and dmp15 > dmn15
cong30_buy  = adx_active_30   and dmp30 > dmn30
cong60_buy  = adx_active_60   and dmp60 > dmn60
cong5_sell  = adx_intensifier and dmn5  > dmp5
cong15_sell = adx_active_15   and dmn15 > dmp15
cong30_sell = adx_active_30   and dmn30 > dmp30
cong60_sell = adx_active_60   and dmn60 > dmp60

// Score 4/4 = quantos dos 4 TFs (5, 15, 30, 60) estão alinhados na direção
cong44_buy_score  = (cong5_buy  ? 1 : 0) + (cong15_buy  ? 1 : 0) + (cong30_buy  ? 1 : 0) + (cong60_buy  ? 1 : 0)
cong44_sell_score = (cong5_sell ? 1 : 0) + (cong15_sell ? 1 : 0) + (cong30_sell ? 1 : 0) + (cong60_sell ? 1 : 0)

// Score 3/3 antigo (só MTF superiores) — mantido para o sizing
cong_buy_score  = (cong15_buy  ? 1 : 0) + (cong30_buy  ? 1 : 0) + (cong60_buy  ? 1 : 0)
cong_sell_score = (cong15_sell ? 1 : 0) + (cong30_sell ? 1 : 0) + (cong60_sell ? 1 : 0)

// ============================== 2º TOQUE (nível a nível) ====================
is_new_day = ta.change(dayofmonth) != 0

tocou(level_price) =>
    tol = level_price * tol_pct / 100.0
    (low - tol) <= level_price and level_price <= (high + tol)

// Contadores de eventos por nível (Pine v5 exige uma declaração por linha)
var int u0_e = 0
var int u50_e = 0
var int u100_e = 0
var int u150_e = 0
var int u200_e = 0
var int u250_e = 0
var int u300_e = 0
var int u350_e = 0
var int u400_e = 0
var int u450_e = 0
var int l0_e = 0
var int l50_e = 0
var int l100_e = 0
var int l150_e = 0
var int l200_e = 0
var int l250_e = 0
var int l300_e = 0
var int l350_e = 0
var int l400_e = 0
var int l450_e = 0
// "bars since last touch" — usa int(na) inicial
var int u0_b = na
var int u50_b = na
var int u100_b = na
var int u150_b = na
var int u200_b = na
var int u250_b = na
var int u300_b = na
var int u350_b = na
var int u400_b = na
var int u450_b = na
var int l0_b = na
var int l50_b = na
var int l100_b = na
var int l150_b = na
var int l200_b = na
var int l250_b = na
var int l300_b = na
var int l350_b = na
var int l400_b = na
var int l450_b = na
var int mid_e = 0
var int mid_b = na

update(is_touching, events, bs_last) =>
    ne = events
    nbs = bs_last
    if is_touching
        if na(bs_last) or bs_last > gap_bars
            ne := events + 1
        nbs := 0
    else if not na(bs_last)
        nbs := bs_last + 1
        // Reset por gap: se preço afastou por mais de reset_gap candles, zera contador
        // Novo par 1º+2º toque vira novo aviso amarelo
        if nbs > reset_gap
            ne := 0
            nbs := na
    [ne, nbs]

if is_new_day
    u0_e := 0
    u50_e := 0
    u100_e := 0
    u150_e := 0
    u200_e := 0
    u250_e := 0
    u300_e := 0
    u350_e := 0
    u400_e := 0
    u450_e := 0
    l0_e := 0
    l50_e := 0
    l100_e := 0
    l150_e := 0
    l200_e := 0
    l250_e := 0
    l300_e := 0
    l350_e := 0
    l400_e := 0
    l450_e := 0
    mid_e := 0
    mid_b := na
    u0_b := na
    u50_b := na
    u100_b := na
    u150_b := na
    u200_b := na
    u250_b := na
    u300_b := na
    u350_b := na
    u400_b := na
    u450_b := na
    l0_b := na
    l50_b := na
    l100_b := na
    l150_b := na
    l200_b := na
    l250_b := na
    l300_b := na
    l350_b := na
    l400_b := na
    l450_b := na

if has_base
    [_e1, _b1] = update(tocou(u0), u0_e, u0_b)
    u0_e := _e1
    u0_b := _b1
    [_e2, _b2] = update(tocou(u50), u50_e, u50_b)
    u50_e := _e2
    u50_b := _b2
    [_e3, _b3] = update(tocou(u100), u100_e, u100_b)
    u100_e := _e3
    u100_b := _b3
    [_e4, _b4] = update(tocou(u150), u150_e, u150_b)
    u150_e := _e4
    u150_b := _b4
    [_e5, _b5] = update(tocou(u200), u200_e, u200_b)
    u200_e := _e5
    u200_b := _b5
    [_e6, _b6] = update(tocou(u250), u250_e, u250_b)
    u250_e := _e6
    u250_b := _b6
    [_e7, _b7] = update(tocou(u300), u300_e, u300_b)
    u300_e := _e7
    u300_b := _b7
    [_e8, _b8] = update(tocou(u350), u350_e, u350_b)
    u350_e := _e8
    u350_b := _b8
    [_e9, _b9] = update(tocou(u400), u400_e, u400_b)
    u400_e := _e9
    u400_b := _b9
    [_e10, _b10] = update(tocou(u450), u450_e, u450_b)
    u450_e := _e10
    u450_b := _b10
    [_e11, _b11] = update(tocou(l0), l0_e, l0_b)
    l0_e := _e11
    l0_b := _b11
    [_e12, _b12] = update(tocou(l50), l50_e, l50_b)
    l50_e := _e12
    l50_b := _b12
    [_e13, _b13] = update(tocou(l100), l100_e, l100_b)
    l100_e := _e13
    l100_b := _b13
    [_e14, _b14] = update(tocou(l150), l150_e, l150_b)
    l150_e := _e14
    l150_b := _b14
    [_e15, _b15] = update(tocou(l200), l200_e, l200_b)
    l200_e := _e15
    l200_b := _b15
    [_e16, _b16] = update(tocou(l250), l250_e, l250_b)
    l250_e := _e16
    l250_b := _b16
    [_e17, _b17] = update(tocou(l300), l300_e, l300_b)
    l300_e := _e17
    l300_b := _b17
    [_e18, _b18] = update(tocou(l350), l350_e, l350_b)
    l350_e := _e18
    l350_b := _b18
    [_e19, _b19] = update(tocou(l400), l400_e, l400_b)
    l400_e := _e19
    l400_b := _b19
    [_e20, _b20] = update(tocou(l450), l450_e, l450_b)
    l450_e := _e20
    l450_b := _b20
    [_em, _bm] = update(tocou(umid), mid_e, mid_b)
    mid_e := _em
    mid_b := _bm

// APENAS 2ª batida (== 2) — na 3ª, 4ª... batida no mesmo nível, NÃO dispara aviso.
// Cada nível gera no máximo 1 amarelo por dia (o momento exato do 2º toque).
// MID entra em AMBOS os lados (âncora dual).
mid_second_touch = tocou(umid) and mid_e == 2

second_upper = mid_second_touch or (tocou(u0)   and u0_e   == 2) or (tocou(u50)  and u50_e  == 2) or (tocou(u100) and u100_e == 2) or (tocou(u150) and u150_e == 2) or (tocou(u200) and u200_e == 2) or (tocou(u250) and u250_e == 2) or (tocou(u300) and u300_e == 2) or (tocou(u350) and u350_e == 2) or (tocou(u400) and u400_e == 2) or (tocou(u450) and u450_e == 2)
second_lower = mid_second_touch or (tocou(l0)   and l0_e   == 2) or (tocou(l50)  and l50_e  == 2) or (tocou(l100) and l100_e == 2) or (tocou(l150) and l150_e == 2) or (tocou(l200) and l200_e == 2) or (tocou(l250) and l250_e == 2) or (tocou(l300) and l300_e == 2) or (tocou(l350) and l350_e == 2) or (tocou(l400) and l400_e == 2) or (tocou(l450) and l450_e == 2)

// ============================== GATILHO (opção B — global por direção) =====
// Fluxo de estados (por direção, buy exemplo):
//   Estado 1: sem setup → aguarda algum 1º toque em suporte
//   Estado 2: 1º toque registrado → aguarda 2º toque no MESMO nível dentro
//             de max_gap_touches candles. Se estourar, setup expira e o próximo
//             toque vira NOVO 1º.
//   Estado 3: 2º toque válido → aguarda cross Estoc/TRIX dentro de
//             wait_after_touch candles APÓS o 2º toque. Cross entre 1º e 2º
//             também vale (cross_ago < first_touch_ago).
//   Após disparar: reset total, próximo toque vira novo 1º.

// Detect "1º toque acabou de acontecer" (algum nível com _e == 1)
// MID entra em AMBOS os lados (âncora dual)
mid_first_now = tocou(umid) and mid_e == 1
first_lower_now = mid_first_now or (tocou(l0) and l0_e == 1) or (tocou(l50) and l50_e == 1) or (tocou(l100) and l100_e == 1) or (tocou(l150) and l150_e == 1) or (tocou(l200) and l200_e == 1) or (tocou(l250) and l250_e == 1) or (tocou(l300) and l300_e == 1) or (tocou(l350) and l350_e == 1) or (tocou(l400) and l400_e == 1) or (tocou(l450) and l450_e == 1)
first_upper_now = mid_first_now or (tocou(u0) and u0_e == 1) or (tocou(u50) and u50_e == 1) or (tocou(u100) and u100_e == 1) or (tocou(u150) and u150_e == 1) or (tocou(u200) and u200_e == 1) or (tocou(u250) and u250_e == 1) or (tocou(u300) and u300_e == 1) or (tocou(u350) and u350_e == 1) or (tocou(u400) and u400_e == 1) or (tocou(u450) and u450_e == 1)

buy_cond1  = second_lower          // 2ª batida em suporte
sell_cond1 = second_upper          // 2ª batida em resistência

var int buy_first_touch_ago   = 999999
var int buy_second_touch_ago  = 999999
var int sell_first_touch_ago  = 999999
var int sell_second_touch_ago = 999999

if is_new_day
    buy_first_touch_ago   := 999999
    buy_second_touch_ago  := 999999
    sell_first_touch_ago  := 999999
    sell_second_touch_ago := 999999

buy_first_touch_ago   := buy_first_touch_ago   + 1
buy_second_touch_ago  := buy_second_touch_ago  + 1
sell_first_touch_ago  := sell_first_touch_ago  + 1
sell_second_touch_ago := sell_second_touch_ago + 1

// Registra 1º toque quando não há setup ativo (ou anterior expirou)
if first_lower_now and buy_first_touch_ago > max_gap_touches
    buy_first_touch_ago  := 0
    buy_second_touch_ago := 999999
if first_upper_now and sell_first_touch_ago > max_gap_touches
    sell_first_touch_ago  := 0
    sell_second_touch_ago := 999999

// Registra 2º toque: só se 1º ainda ativo (dentro do max_gap)
if buy_cond1 and buy_first_touch_ago <= max_gap_touches and buy_second_touch_ago > wait_after_touch
    buy_second_touch_ago := 0
if sell_cond1 and sell_first_touch_ago <= max_gap_touches and sell_second_touch_ago > wait_after_touch
    sell_second_touch_ago := 0

// Janela de confirmação aberta (2º toque aconteceu nos últimos wait_after_touch)
buy_touch_window_open  = buy_second_touch_ago  <= wait_after_touch
sell_touch_window_open = sell_second_touch_ago <= wait_after_touch

// Cross válido: aconteceu ENTRE 1º toque e AGORA → barssince(cross) < first_touch_ago
buy_cond2  = buy_touch_window_open  and ta.barssince(stoch_cross_up) < buy_first_touch_ago
buy_cond3  = buy_touch_window_open  and trix_bars_up_5m < buy_first_touch_ago
sell_cond2 = sell_touch_window_open and ta.barssince(stoch_cross_dn) < sell_first_touch_ago
sell_cond3 = sell_touch_window_open and trix_bars_dn_5m < sell_first_touch_ago

// Aliases mantidos para o painel (compatibilidade)
trix_up_5m = trix_bars_up_5m < 3
trix_dn_5m = trix_bars_dn_5m < 3

buy_extras_score  = (buy_cond2  ? 1 : 0) + (buy_cond3  ? 1 : 0)
sell_extras_score = (sell_cond2 ? 1 : 0) + (sell_cond3 ? 1 : 0)

buy_score  = (buy_cond1  ? 1 : 0) + buy_extras_score
sell_score = (sell_cond1 ? 1 : 0) + sell_extras_score

buy_signal_hit  = buy_touch_window_open  and buy_extras_score  >= min_extras
sell_signal_hit = sell_touch_window_open and sell_extras_score >= min_extras

// SINAL PREMIUM 4/4: gatilho normal + congruência total nos 4 TFs (5,15,30,60)
buy_signal_44  = buy_signal_hit  and cong44_buy_score  == 4
sell_signal_44 = sell_signal_hit and cong44_sell_score == 4

// Reset após disparar (evita re-entrada no mesmo setup)
if buy_signal_hit
    buy_first_touch_ago  := 999999
    buy_second_touch_ago := 999999
if sell_signal_hit
    sell_first_touch_ago  := 999999
    sell_second_touch_ago := 999999

// Aviso amarelo: APENAS no candle exato da 2ª batida (transição 1→2)
// Evita persistir em candles seguintes onde o preço ainda está encostado no nível
second_lower_new = buy_cond1  and not buy_cond1[1]
second_upper_new = sell_cond1 and not sell_cond1[1]
fibo_touch_buy_alert  = second_lower_new and not buy_signal_hit
fibo_touch_sell_alert = second_upper_new and not sell_signal_hit

// ============================== COOLDOWN DE SINAIS ==========================
// Só marca o PRIMEIRO gatilho de cada cluster (evita setas empilhadas em barras
// consecutivas onde a condição continua verdadeira).
var int bars_since_buy_sig  = 999999
var int bars_since_sell_sig = 999999

if is_new_day
    bars_since_buy_sig  := 999999
    bars_since_sell_sig := 999999

bars_since_buy_sig  := bars_since_buy_sig  + 1
bars_since_sell_sig := bars_since_sell_sig + 1

buy_signal_new  = buy_signal_hit  and bars_since_buy_sig  > sig_cooldown
sell_signal_new = sell_signal_hit and bars_since_sell_sig > sig_cooldown

if buy_signal_new
    bars_since_buy_sig  := 0
if sell_signal_new
    bars_since_sell_sig := 0

// Sizing: 5 contratos por TF alinhado na direção (mín 5, máx 20)
// Ex.: só 5m compra → 5 ctr | 5m+15m → 10 ctr | 5m+15m+30m → 15 ctr | todos 4 → 20 ctr
n_tfs_buy_now  = (cmb_5m_buy_st  ? 1 : 0) + (cmb_15m_buy_st  ? 1 : 0) + (cmb_30m_buy_st  ? 1 : 0) + (cmb_60m_buy_st  ? 1 : 0)
n_tfs_sell_now = (cmb_5m_sell_st ? 1 : 0) + (cmb_15m_sell_st ? 1 : 0) + (cmb_30m_sell_st ? 1 : 0) + (cmb_60m_sell_st ? 1 : 0)
sizing_by_tfs(n) => math.max(5, math.min(sizing_cap, 5 * n))

// ============================== POSIÇÃO IMPLÍCITA + SCALE-OUT ================
// Rastreia posição assumida a partir do último buy_signal_new / sell_signal_new.
// A cada TF que vira contra → marca "pending_exit" naquele TF.
// No próximo toque em QUALQUER Fibo → sai 5 contratos e limpa a flag.

var bool tf5_locked_buy   = false
var bool tf15_locked_buy  = false
var bool tf30_locked_buy  = false
var bool tf60_locked_buy  = false
var bool tf5_locked_sell  = false
var bool tf15_locked_sell = false
var bool tf30_locked_sell = false
var bool tf60_locked_sell = false
var int  contratos_open   = 0
var string lado_open      = ""

// Reset diário
if is_new_day
    tf5_locked_buy   := false
    tf15_locked_buy  := false
    tf30_locked_buy  := false
    tf60_locked_buy  := false
    tf5_locked_sell  := false
    tf15_locked_sell := false
    tf30_locked_sell := false
    tf60_locked_sell := false
    contratos_open   := 0
    lado_open        := ""

// Nova entrada: trava TFs que estavam alinhados no momento
if buy_signal_new
    tf5_locked_buy   := cmb_5m_buy_st
    tf15_locked_buy  := cmb_15m_buy_st
    tf30_locked_buy  := cmb_30m_buy_st
    tf60_locked_buy  := cmb_60m_buy_st
    tf5_locked_sell  := false
    tf15_locked_sell := false
    tf30_locked_sell := false
    tf60_locked_sell := false
    contratos_open   := math.max(5, 5 * n_tfs_buy_now)
    lado_open        := "BUY"
if sell_signal_new
    tf5_locked_sell  := cmb_5m_sell_st
    tf15_locked_sell := cmb_15m_sell_st
    tf30_locked_sell := cmb_30m_sell_st
    tf60_locked_sell := cmb_60m_sell_st
    tf5_locked_buy   := false
    tf15_locked_buy  := false
    tf30_locked_buy  := false
    tf60_locked_buy  := false
    contratos_open   := math.max(5, 5 * n_tfs_sell_now)
    lado_open        := "SELL"

// Detecta TFs que já viraram contra (posição comprada perdendo TF)
flip_5m_from_buy  = tf5_locked_buy  and cmb_5m_sell_st
flip_15m_from_buy = tf15_locked_buy and cmb_15m_sell_st
flip_30m_from_buy = tf30_locked_buy and cmb_30m_sell_st
flip_60m_from_buy = tf60_locked_buy and cmb_60m_sell_st
flip_5m_from_sell  = tf5_locked_sell  and cmb_5m_buy_st
flip_15m_from_sell = tf15_locked_sell and cmb_15m_buy_st
flip_30m_from_sell = tf30_locked_sell and cmb_30m_buy_st
flip_60m_from_sell = tf60_locked_sell and cmb_60m_buy_st

n_flips_buy  = (flip_5m_from_buy  ? 1 : 0) + (flip_15m_from_buy  ? 1 : 0) + (flip_30m_from_buy  ? 1 : 0) + (flip_60m_from_buy  ? 1 : 0)
n_flips_sell = (flip_5m_from_sell ? 1 : 0) + (flip_15m_from_sell ? 1 : 0) + (flip_30m_from_sell ? 1 : 0) + (flip_60m_from_sell ? 1 : 0)

// Toque em qualquer nível Fibo (21 níveis + MID)
any_fibo_touch_now = has_base and (tocou(u0) or tocou(u50) or tocou(u100) or tocou(u150) or tocou(u200) or tocou(u250) or tocou(u300) or tocou(u350) or tocou(u400) or tocou(u450) or tocou(l0) or tocou(l50) or tocou(l100) or tocou(l150) or tocou(l200) or tocou(l250) or tocou(l300) or tocou(l350) or tocou(l400) or tocou(l450) or tocou(umid))

// Sinal de saída parcial: existe flip pendente + tocou Fibo + tem posição aberta
scale_out_buy_now  = lado_open == "BUY"  and n_flips_buy  > 0 and any_fibo_touch_now and contratos_open > 0
scale_out_sell_now = lado_open == "SELL" and n_flips_sell > 0 and any_fibo_touch_now and contratos_open > 0

// Executa saída: destrava os TFs que viraram e abate contratos
if scale_out_buy_now
    if flip_5m_from_buy
        tf5_locked_buy  := false
    if flip_15m_from_buy
        tf15_locked_buy := false
    if flip_30m_from_buy
        tf30_locked_buy := false
    if flip_60m_from_buy
        tf60_locked_buy := false
    contratos_open := math.max(0, contratos_open - (5 * n_flips_buy))
    if contratos_open == 0
        lado_open := ""
if scale_out_sell_now
    if flip_5m_from_sell
        tf5_locked_sell  := false
    if flip_15m_from_sell
        tf15_locked_sell := false
    if flip_30m_from_sell
        tf30_locked_sell := false
    if flip_60m_from_sell
        tf60_locked_sell := false
    contratos_open := math.max(0, contratos_open - (5 * n_flips_sell))
    if contratos_open == 0
        lado_open := ""

// ============================== PAINEL VISUAL ===============================
pos_table = panel_pos == "top_right" ? position.top_right : panel_pos == "top_left" ? position.top_left : panel_pos == "bottom_right" ? position.bottom_right : position.bottom_left

var table pnl = table.new(pos_table, 3, 11, border_width=1)

light(is_on) => is_on ? "🟢" : "⚪"
color_bg_hit(hit) => hit ? color.new(color.green, 60) : color.new(color.gray, 90)

// Contagem X/4 por TF (para o painel: mostra buildup dos indicadores antes de disparar a seta)
score_5m_buy   = (s5_stoch_b  ? 1 : 0) + (s5_trix_b  ? 1 : 0) + (s5_adx_a  ? 1 : 0) + (s5_dmi_b  ? 1 : 0)
score_5m_sell  = (s5_stoch_s  ? 1 : 0) + (s5_trix_s  ? 1 : 0) + (s5_adx_a  ? 1 : 0) + (s5_dmi_s  ? 1 : 0)
score_15m_buy  = (s15_stoch_b ? 1 : 0) + (s15_trix_b ? 1 : 0) + (s15_adx_a ? 1 : 0) + (s15_dmi_b ? 1 : 0)
score_15m_sell = (s15_stoch_s ? 1 : 0) + (s15_trix_s ? 1 : 0) + (s15_adx_a ? 1 : 0) + (s15_dmi_s ? 1 : 0)
score_30m_buy  = (s30_stoch_b ? 1 : 0) + (s30_trix_b ? 1 : 0) + (s30_adx_a ? 1 : 0) + (s30_dmi_b ? 1 : 0)
score_30m_sell = (s30_stoch_s ? 1 : 0) + (s30_trix_s ? 1 : 0) + (s30_adx_a ? 1 : 0) + (s30_dmi_s ? 1 : 0)
score_60m_buy  = (s60_stoch_b ? 1 : 0) + (s60_trix_b ? 1 : 0) + (s60_adx_a ? 1 : 0) + (s60_dmi_b ? 1 : 0)
score_60m_sell = (s60_stoch_s ? 1 : 0) + (s60_trix_s ? 1 : 0) + (s60_adx_a ? 1 : 0) + (s60_dmi_s ? 1 : 0)

// Formata "🟢🟢⚪⚪ 2/4" — 4 luzes na ordem Estoc/TRIX/ADX/DMI + contador
fmt_tf(sb, tb, ab, db, score) => light(sb) + light(tb) + light(ab) + light(db) + " " + str.tostring(score) + "/4"

color_tf(score) => score == 4 ? color.new(color.yellow, 0) : score == 3 ? color.new(color.orange, 0) : color.new(color.gray, 30)

if show_panel and barstate.islast
    table.clear(pnl, 0, 0, 2, 10)
    table.cell(pnl, 0, 0, "EIXO WIN — Painel MTF",   bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.small)
    table.cell(pnl, 1, 0, "🟢 COMPRA",                bgcolor=color_bg_hit(buy_signal_hit),  text_color=color.white, text_size=size.small)
    table.cell(pnl, 2, 0, "🔴 VENDA",                 bgcolor=color_bg_hit(sell_signal_hit), text_color=color.white, text_size=size.small)
    table.cell(pnl, 0, 1, "★ 2ª batida em Fibo",     text_size=size.tiny, tooltip="Algum nível Fibo foi tocado pela 2ª+ vez neste candle. Âncora obrigatória.")
    table.cell(pnl, 1, 1, light(buy_cond1),           text_size=size.tiny)
    table.cell(pnl, 2, 1, light(sell_cond1),          text_size=size.tiny)
    // Setup por TF (Est/TRIX/ADX/DMI do próprio TF) — luzes + X/4
    // Substituem completamente as linhas antigas de Estoc 1m / TRIX 5m / ADX 5m
    table.cell(pnl, 0, 2, "5m (Est/TRIX/ADX/DMI)",   text_size=size.tiny, tooltip="Combinado 5m. Cor da seta no gráfico = intensidade do score (1→transparente, 4→opaca). Cor base: aqua.")
    table.cell(pnl, 1, 2, fmt_tf(s5_stoch_b, s5_trix_b, s5_adx_a, s5_dmi_b, score_5m_buy),   text_size=size.tiny, text_color=color_tf(score_5m_buy))
    table.cell(pnl, 2, 2, fmt_tf(s5_stoch_s, s5_trix_s, s5_adx_a, s5_dmi_s, score_5m_sell),  text_size=size.tiny, text_color=color_tf(score_5m_sell))
    table.cell(pnl, 0, 3, "15m (Est/TRIX/ADX/DMI)",  text_size=size.tiny, tooltip="Combinado 15m. Cor base: lime.")
    table.cell(pnl, 1, 3, fmt_tf(s15_stoch_b, s15_trix_b, s15_adx_a, s15_dmi_b, score_15m_buy),  text_size=size.tiny, text_color=color_tf(score_15m_buy))
    table.cell(pnl, 2, 3, fmt_tf(s15_stoch_s, s15_trix_s, s15_adx_a, s15_dmi_s, score_15m_sell), text_size=size.tiny, text_color=color_tf(score_15m_sell))
    table.cell(pnl, 0, 4, "30m (Est/TRIX/ADX/DMI)",  text_size=size.tiny, tooltip="Combinado 30m. Cor base: laranja.")
    table.cell(pnl, 1, 4, fmt_tf(s30_stoch_b, s30_trix_b, s30_adx_a, s30_dmi_b, score_30m_buy),  text_size=size.tiny, text_color=color_tf(score_30m_buy))
    table.cell(pnl, 2, 4, fmt_tf(s30_stoch_s, s30_trix_s, s30_adx_a, s30_dmi_s, score_30m_sell), text_size=size.tiny, text_color=color_tf(score_30m_sell))
    table.cell(pnl, 0, 5, "60m (Est/TRIX/ADX/DMI)",  text_size=size.tiny, tooltip="Combinado 60m. Cor base: roxo.")
    table.cell(pnl, 1, 5, fmt_tf(s60_stoch_b, s60_trix_b, s60_adx_a, s60_dmi_b, score_60m_buy),  text_size=size.tiny, text_color=color_tf(score_60m_buy))
    table.cell(pnl, 2, 5, fmt_tf(s60_stoch_s, s60_trix_s, s60_adx_a, s60_dmi_s, score_60m_sell), text_size=size.tiny, text_color=color_tf(score_60m_sell))
    // Congruência agregada mantida como resumo rápido
    table.cell(pnl, 0, 6, "Cong 4/4 (5/15/30/60)",   text_size=size.tiny)
    table.cell(pnl, 1, 6, light(cong5_buy)  + light(cong15_buy)  + light(cong30_buy)  + light(cong60_buy)  + " = " + str.tostring(cong44_buy_score),  text_size=size.tiny, text_color=(cong44_buy_score  == 4 ? color.yellow : color.gray))
    table.cell(pnl, 2, 6, light(cong5_sell) + light(cong15_sell) + light(cong30_sell) + light(cong60_sell) + " = " + str.tostring(cong44_sell_score), text_size=size.tiny, text_color=(cong44_sell_score == 4 ? color.yellow : color.gray))
    // Sizing: 5 × N_TFs alinhados AGORA
    table.cell(pnl, 0, 7, "Contratos p/ entrar (5×TFs)", text_size=size.tiny, tooltip="Se entrar AGORA no 1m: 5 contratos por TF alinhado. Mín 5, máx " + str.tostring(sizing_cap) + ".")
    table.cell(pnl, 1, 7, str.tostring(sizing_by_tfs(n_tfs_buy_now)),  text_size=size.tiny, text_color=color.green)
    table.cell(pnl, 2, 7, str.tostring(sizing_by_tfs(n_tfs_sell_now)), text_size=size.tiny, text_color=color.red)
    // Posição implícita a partir do último gatilho
    table.cell(pnl, 0, 8, "Posição aberta (implícita)", text_size=size.tiny, tooltip="Contratos assumidos a partir do último gatilho. Cada TF que virar contra → sai 5 no próximo toque em Fibo.")
    table.cell(pnl, 1, 8, lado_open == "BUY"  ? str.tostring(contratos_open) + " ctr" : "—", text_size=size.tiny, text_color=(lado_open == "BUY"  ? color.green : color.gray))
    table.cell(pnl, 2, 8, lado_open == "SELL" ? str.tostring(contratos_open) + " ctr" : "—", text_size=size.tiny, text_color=(lado_open == "SELL" ? color.red   : color.gray))
    table.cell(pnl, 0, 9, "TFs travados na entrada", text_size=size.tiny)
    table.cell(pnl, 1, 9, light(tf5_locked_buy)  + light(tf15_locked_buy)  + light(tf30_locked_buy)  + light(tf60_locked_buy),  text_size=size.tiny, text_color=color.green)
    table.cell(pnl, 2, 9, light(tf5_locked_sell) + light(tf15_locked_sell) + light(tf30_locked_sell) + light(tf60_locked_sell), text_size=size.tiny, text_color=color.red)
    table.cell(pnl, 0, 10, "Flips pendentes (sair 5×N)", text_size=size.tiny, tooltip="TFs travados que já viraram contra. No próximo toque em Fibo → sai 5 por flip.")
    table.cell(pnl, 1, 10, str.tostring(n_flips_buy)  + " → -" + str.tostring(5 * n_flips_buy)  + " ctr", text_size=size.tiny, text_color=(n_flips_buy  > 0 ? color.orange : color.gray))
    table.cell(pnl, 2, 10, str.tostring(n_flips_sell) + " → -" + str.tostring(5 * n_flips_sell) + " ctr", text_size=size.tiny, text_color=(n_flips_sell > 0 ? color.orange : color.gray))

// ============================== SETAS + ALERTAS ==============================
// Fluxo temporal:
//   candle N   : preço toca Fibo 2x → sinaliza cond1 verde (âncora pendente)
//   candle N+1 : um dos 3 indicadores dispara iniciação → gatilho CONFIRMADO
//                a seta é desenhada RETROATIVAMENTE no candle N (offset=-1)
//
// Uso: buy_cond1[1] = "havia âncora no candle anterior";
//      buy_extras_score >= min_extras neste candle = "acaba de confirmar agora"

// Confirmação AGORA = usa buy_signal_new que já leva cooldown em conta
// (evita bug: bars_since_buy_sig é resetado antes desta linha ser avaliada)
buy_confirmed_now  = buy_signal_new
sell_confirmed_now = sell_signal_new

// Seta amarela de AVISO no candle do toque (antes de qualquer confirmação)
plotshape(show_alert and fibo_touch_buy_alert,  title="AVISO 2º toque SUP", location=location.belowbar, color=color.yellow, style=shape.diamond, size=size.tiny, text="!")
plotshape(show_alert and fibo_touch_sell_alert, title="AVISO 2º toque RES", location=location.abovebar, color=color.yellow, style=shape.diamond, size=size.tiny, text="!")

// Seta cheia de GATILHO — desenhada NO CANDLE ANTERIOR (offset=-1) quando este candle confirma
plotshape(buy_confirmed_now,  title="GATILHO COMPRA", location=location.belowbar, color=color.green, style=shape.triangleup,   size=size.small, text="BUY")
plotshape(sell_confirmed_now, title="GATILHO VENDA",  location=location.abovebar, color=color.red,   style=shape.triangledown, size=size.small, text="SELL")

// Sinal PREMIUM 4/4 — estrela dourada quando congruência total (5+15+30+60) alinha
buy_confirmed_44  = buy_confirmed_now  and cong44_buy_score  == 4
sell_confirmed_44 = sell_confirmed_now and cong44_sell_score == 4
plotshape(buy_confirmed_44,  title="4/4 COMPRA PREMIUM", location=location.belowbar, color=color.yellow, style=shape.arrowup, size=size.normal, text="★ 4/4 BUY")
plotshape(sell_confirmed_44, title="4/4 VENDA PREMIUM",  location=location.abovebar, color=color.yellow, style=shape.arrowdown, size=size.normal, text="★ 4/4 SELL")

alertcondition(fibo_touch_buy_alert or fibo_touch_sell_alert,
     title="Eixo WIN — Aviso 2º toque",
     message="{{ticker}} @ {{close}} | 2º toque no Fibo — aguardando confirmação")

alertcondition(buy_confirmed_now or sell_confirmed_now,
     title="Eixo WIN — Gatilho confirmado",
     message="{{ticker}} @ {{close}} | Gatilho confirmado (toque anterior + iniciação agora)")

alertcondition(buy_confirmed_44 or sell_confirmed_44,
     title="Eixo WIN — Convergência 4/4 PREMIUM",
     message="{{ticker}} @ {{close}} | 4/4 CONVERGÊNCIA TOTAL — todos os TFs (5+15+30+60) alinhados")

// Scale-out parcial: TF virou contra + tocou Fibo → sair 5 contratos por TF flipado
plotshape(scale_out_buy_now,  title="SAIR (COMPRA)", location=location.abovebar, color=color.new(color.orange, 0), style=shape.xcross,   size=size.small, text="↓5×N")
plotshape(scale_out_sell_now, title="SAIR (VENDA)",  location=location.belowbar, color=color.new(color.orange, 0), style=shape.xcross,   size=size.small, text="↑5×N")

alertcondition(scale_out_buy_now or scale_out_sell_now,
     title="Eixo WIN — Scale-out parcial",
     message="{{ticker}} @ {{close}} | Um TF virou contra + tocou Fibo — sair 5 contratos por TF flipado")

plot(buy_score,       title="buy_score",       display=display.none)
plot(sell_score,      title="sell_score",      display=display.none)
plot(cong_buy_score,  title="cong_buy_score",  display=display.none)
plot(cong_sell_score, title="cong_sell_score", display=display.none)

// ============================== SETAS MTF (4 TFs) — TONALIDADE DINÂMICA ======
// Esquema de nomenclatura: <tf_idx>.<score>
//   TF 5m  → 1.1, 1.2, 1.3, 1.4 (cor base aqua, tonalidade sobe com score)
//   TF 15m → 2.1, 2.2, 2.3, 2.4 (cor base lime)
//   TF 30m → 3.1, 3.2, 3.3, 3.4 (cor base laranja)
//   TF 60m → 4.1, 4.2, 4.3, 4.4 (cor base roxo)
// Cada TF tem 4 tonalidades — score 1 = mais transparente, score 4 = opaca.
// Seta é desenhada quando o score do TF SOBE naquele candle (redução não desenha,
// mas o painel mostra em tempo real). Direção da seta = lado dominante do TF.

tone_from_score(sc) => sc == 4 ? 0 : sc == 3 ? 25 : sc == 2 ? 50 : sc == 1 ? 75 : 100

// Detecta subida de score por TF/direção (ignora quando cai)
up_5m_buy    = score_5m_buy   > score_5m_buy[1]   and score_5m_buy   >= 1
up_5m_sell   = score_5m_sell  > score_5m_sell[1]  and score_5m_sell  >= 1
up_15m_buy   = score_15m_buy  > score_15m_buy[1]  and score_15m_buy  >= 1
up_15m_sell  = score_15m_sell > score_15m_sell[1] and score_15m_sell >= 1
up_30m_buy   = score_30m_buy  > score_30m_buy[1]  and score_30m_buy  >= 1
up_30m_sell  = score_30m_sell > score_30m_sell[1] and score_30m_sell >= 1
up_60m_buy   = score_60m_buy  > score_60m_buy[1]  and score_60m_buy  >= 1
up_60m_sell  = score_60m_sell > score_60m_sell[1] and score_60m_sell >= 1

// Cores dinâmicas com tonalidade proporcional ao score do TF
c_5m_buy    = color.new(color.aqua,   tone_from_score(score_5m_buy))
c_5m_sell   = color.new(color.aqua,   tone_from_score(score_5m_sell))
c_15m_buy   = color.new(color.lime,   tone_from_score(score_15m_buy))
c_15m_sell  = color.new(color.lime,   tone_from_score(score_15m_sell))
c_30m_buy   = color.new(color.orange, tone_from_score(score_30m_buy))
c_30m_sell  = color.new(color.orange, tone_from_score(score_30m_sell))
c_60m_buy   = color.new(color.purple, tone_from_score(score_60m_buy))
c_60m_sell  = color.new(color.purple, tone_from_score(score_60m_sell))

// Pine v5: text= em plotshape SÓ aceita const string. Então usamos 16 plotshapes
// (4 TFs × 2 direções × 4 níveis) com condição composta up_XX and score_XX == N.
// 5m BUY (1.1 a 1.4)
plotshape(show_5m_cmb and up_5m_buy and score_5m_buy == 1, title="5m BUY 1.1", location=location.belowbar, color=color.new(color.aqua, 75), style=shape.arrowup, size=size.small, text="1.1")
plotshape(show_5m_cmb and up_5m_buy and score_5m_buy == 2, title="5m BUY 1.2", location=location.belowbar, color=color.new(color.aqua, 50), style=shape.arrowup, size=size.small, text="1.2")
plotshape(show_5m_cmb and up_5m_buy and score_5m_buy == 3, title="5m BUY 1.3", location=location.belowbar, color=color.new(color.aqua, 25), style=shape.arrowup, size=size.small, text="1.3")
plotshape(show_5m_cmb and up_5m_buy and score_5m_buy == 4, title="5m BUY 1.4", location=location.belowbar, color=color.new(color.aqua,  0), style=shape.arrowup, size=size.small, text="1.4")
// 5m SELL (1.1 a 1.4)
plotshape(show_5m_cmb and up_5m_sell and score_5m_sell == 1, title="5m SELL 1.1", location=location.abovebar, color=color.new(color.aqua, 75), style=shape.arrowdown, size=size.small, text="1.1")
plotshape(show_5m_cmb and up_5m_sell and score_5m_sell == 2, title="5m SELL 1.2", location=location.abovebar, color=color.new(color.aqua, 50), style=shape.arrowdown, size=size.small, text="1.2")
plotshape(show_5m_cmb and up_5m_sell and score_5m_sell == 3, title="5m SELL 1.3", location=location.abovebar, color=color.new(color.aqua, 25), style=shape.arrowdown, size=size.small, text="1.3")
plotshape(show_5m_cmb and up_5m_sell and score_5m_sell == 4, title="5m SELL 1.4", location=location.abovebar, color=color.new(color.aqua,  0), style=shape.arrowdown, size=size.small, text="1.4")
// 15m BUY (2.1 a 2.4)
plotshape(show_15m_cmb and up_15m_buy and score_15m_buy == 1, title="15m BUY 2.1", location=location.belowbar, color=color.new(color.lime, 75), style=shape.arrowup, size=size.small, text="2.1")
plotshape(show_15m_cmb and up_15m_buy and score_15m_buy == 2, title="15m BUY 2.2", location=location.belowbar, color=color.new(color.lime, 50), style=shape.arrowup, size=size.small, text="2.2")
plotshape(show_15m_cmb and up_15m_buy and score_15m_buy == 3, title="15m BUY 2.3", location=location.belowbar, color=color.new(color.lime, 25), style=shape.arrowup, size=size.small, text="2.3")
plotshape(show_15m_cmb and up_15m_buy and score_15m_buy == 4, title="15m BUY 2.4", location=location.belowbar, color=color.new(color.lime,  0), style=shape.arrowup, size=size.small, text="2.4")
// 15m SELL (2.1 a 2.4)
plotshape(show_15m_cmb and up_15m_sell and score_15m_sell == 1, title="15m SELL 2.1", location=location.abovebar, color=color.new(color.lime, 75), style=shape.arrowdown, size=size.small, text="2.1")
plotshape(show_15m_cmb and up_15m_sell and score_15m_sell == 2, title="15m SELL 2.2", location=location.abovebar, color=color.new(color.lime, 50), style=shape.arrowdown, size=size.small, text="2.2")
plotshape(show_15m_cmb and up_15m_sell and score_15m_sell == 3, title="15m SELL 2.3", location=location.abovebar, color=color.new(color.lime, 25), style=shape.arrowdown, size=size.small, text="2.3")
plotshape(show_15m_cmb and up_15m_sell and score_15m_sell == 4, title="15m SELL 2.4", location=location.abovebar, color=color.new(color.lime,  0), style=shape.arrowdown, size=size.small, text="2.4")
// 30m BUY (3.1 a 3.4)
plotshape(show_30m_cmb and up_30m_buy and score_30m_buy == 1, title="30m BUY 3.1", location=location.belowbar, color=color.new(color.orange, 75), style=shape.arrowup, size=size.small, text="3.1")
plotshape(show_30m_cmb and up_30m_buy and score_30m_buy == 2, title="30m BUY 3.2", location=location.belowbar, color=color.new(color.orange, 50), style=shape.arrowup, size=size.small, text="3.2")
plotshape(show_30m_cmb and up_30m_buy and score_30m_buy == 3, title="30m BUY 3.3", location=location.belowbar, color=color.new(color.orange, 25), style=shape.arrowup, size=size.small, text="3.3")
plotshape(show_30m_cmb and up_30m_buy and score_30m_buy == 4, title="30m BUY 3.4", location=location.belowbar, color=color.new(color.orange,  0), style=shape.arrowup, size=size.small, text="3.4")
// 30m SELL (3.1 a 3.4)
plotshape(show_30m_cmb and up_30m_sell and score_30m_sell == 1, title="30m SELL 3.1", location=location.abovebar, color=color.new(color.orange, 75), style=shape.arrowdown, size=size.small, text="3.1")
plotshape(show_30m_cmb and up_30m_sell and score_30m_sell == 2, title="30m SELL 3.2", location=location.abovebar, color=color.new(color.orange, 50), style=shape.arrowdown, size=size.small, text="3.2")
plotshape(show_30m_cmb and up_30m_sell and score_30m_sell == 3, title="30m SELL 3.3", location=location.abovebar, color=color.new(color.orange, 25), style=shape.arrowdown, size=size.small, text="3.3")
plotshape(show_30m_cmb and up_30m_sell and score_30m_sell == 4, title="30m SELL 3.4", location=location.abovebar, color=color.new(color.orange,  0), style=shape.arrowdown, size=size.small, text="3.4")
// 60m BUY (4.1 a 4.4)
plotshape(show_60m_cmb and up_60m_buy and score_60m_buy == 1, title="60m BUY 4.1", location=location.belowbar, color=color.new(color.purple, 75), style=shape.arrowup, size=size.small, text="4.1")
plotshape(show_60m_cmb and up_60m_buy and score_60m_buy == 2, title="60m BUY 4.2", location=location.belowbar, color=color.new(color.purple, 50), style=shape.arrowup, size=size.small, text="4.2")
plotshape(show_60m_cmb and up_60m_buy and score_60m_buy == 3, title="60m BUY 4.3", location=location.belowbar, color=color.new(color.purple, 25), style=shape.arrowup, size=size.small, text="4.3")
plotshape(show_60m_cmb and up_60m_buy and score_60m_buy == 4, title="60m BUY 4.4", location=location.belowbar, color=color.new(color.purple,  0), style=shape.arrowup, size=size.small, text="4.4")
// 60m SELL (4.1 a 4.4)
plotshape(show_60m_cmb and up_60m_sell and score_60m_sell == 1, title="60m SELL 4.1", location=location.abovebar, color=color.new(color.purple, 75), style=shape.arrowdown, size=size.small, text="4.1")
plotshape(show_60m_cmb and up_60m_sell and score_60m_sell == 2, title="60m SELL 4.2", location=location.abovebar, color=color.new(color.purple, 50), style=shape.arrowdown, size=size.small, text="4.2")
plotshape(show_60m_cmb and up_60m_sell and score_60m_sell == 3, title="60m SELL 4.3", location=location.abovebar, color=color.new(color.purple, 25), style=shape.arrowdown, size=size.small, text="4.3")
plotshape(show_60m_cmb and up_60m_sell and score_60m_sell == 4, title="60m SELL 4.4", location=location.abovebar, color=color.new(color.purple,  0), style=shape.arrowdown, size=size.small, text="4.4")
