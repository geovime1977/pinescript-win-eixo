//------------------------------------------------------------------------------
// Eixo Estrategico - WIN Day Trade | Strategy X/3 (v14 - 04/08/2026)
//------------------------------------------------------------------------------
// APLICAR NO GRAFICO DE 5 MINUTOS DO WIN (mini indice).
// Sintaxe pt (Se/entao/inicio/fim, e/ou) - compativel com Profit/Nelogica NTSL.
//
// Nota importante: NTSL nao suporta request.security multi-TF como Pine.
// Esta versao roda todos os calculos no TF do grafico (5min). Para congruencia
// aproximada de TFs maiores, usa periodos dilatados dos indicadores (× 3, × 6, × 12).
//
// Gate v14:
//   1. 2a batida em nivel Fibo do 1o candle 5min do dia
//   2. Candle da 2a batida fecha ACIMA (compra) ou ABAIXO (venda) do nivel
//   3. Entrada na ABERTURA do candle SEGUINTE (via BuyStop/SellStop)
//
// Sizing: 5 x N_TFs alinhados (min 5, max 20).
// Alvos: L150/U150 e L300/U300 (scale-out em 2 partes).
// Stop: 0.5 x amplitude do 1o candle 5min.
// EOD: 17:55 forca fechamento.
//------------------------------------------------------------------------------

input
  TolPct       (0.05);   // Tolerancia toque (%)
  GapBars      (3);      // Gap min entre eventos
  ResetGap     (15);     // Reset contador
  MaxGapTouches(10);     // Max candles entre 1o e 2o toque
  QtyBase      (5);      // Contratos por TF alinhado
  QtyCap       (20);     // Cap total
  EstocLen     (8);      // Estocastico Lento K
  EstocDLen    (3);      // Estocastico Lento D
  TrixLen      (9);      // TRIX
  TrixMALen    (3);      // TRIX MMA
  AdxLen       (8);      // ADX / DMI periodo
  AdxMediaLen  (8);      // ADX media
  StopFibPct   (0.5);    // Stop = 0.5 x amplitude Fibo
  SessionEnd   (1730);   // HHMM - fim janela entrada
  EodTime      (1755);   // HHMM - EOD forcado

var
  // Fibo do 1o candle 5min do dia
  First5High, First5Low, FibRange : Float;
  HasBase : Boolean;
  U0, UMid, U50, U100, U150, U200, U250, U300, U350, U400, U450 : Float;
  L0, L50, L100, L150, L200, L250, L300, L350, L400, L450 : Float;

  // Contadores de toque por nivel
  U0e, U50e, U100e, U150e, U200e, U250e, U300e, U350e, U400e, U450e : Integer;
  L0e, L50e, L100e, L150e, L200e, L250e, L300e, L350e, L400e, L450e : Integer;
  MidE : Integer;
  U0b, U50b, U100b, U150b, U200b, U250b, U300b, U350b, U400b, U450b : Integer;
  L0b, L50b, L100b, L150b, L200b, L250b, L300b, L350b, L400b, L450b : Integer;
  MidB : Integer;

  // Indicadores no TF do grafico (5min)
  StochRaw, StochK, StochD : Float;
  StochBuy, StochSell : Boolean;
  TrixVal, TrixMA : Float;
  TrixBuy, TrixSell : Boolean;
  AdxV, DmP, DmN : Float;
  DmiBuy, DmiSell : Boolean;
  Score3Buy, Score3Sell : Integer;
  Tf5Aligned3Buy, Tf5Aligned3Sell : Boolean;

  // Congruencia aproximada 15/30/60m via periodos dilatados no 5m
  AdxV15, DmP15, DmN15 : Float;
  AdxV30, DmP30, DmN30 : Float;
  AdxV60, DmP60, DmN60 : Float;
  Tf15Buy, Tf30Buy, Tf60Buy : Boolean;
  Tf15Sell, Tf30Sell, Tf60Sell : Boolean;
  NTfsBuy, NTfsSell : Integer;

  // Gate v14
  Tol : Float;
  BuyGateArmed, SellGateArmed : Boolean;
  BuyGateArmedPrev, SellGateArmedPrev : Boolean;
  BuySignalV14, SellSignalV14 : Boolean;

  // Entrada/saida
  QtyTotal, Qty1, Qty2 : Integer;
  StopPrice, AlvoC1, AlvoC2, AlvoV1, AlvoV2 : Float;

  // Sessao
  IsNewDay, InEntryWindow, InEodWindow : Boolean;

begin
  //--------------------------------------------------------------------------
  // Detecta virada de dia
  //--------------------------------------------------------------------------
  IsNewDay := (Date <> Date[1]);

  //--------------------------------------------------------------------------
  // Captura Fibo do 1o candle 5min do dia
  //--------------------------------------------------------------------------
  Se IsNewDay entao inicio
    First5High := Maxima;
    First5Low  := Minima;
    FibRange   := First5High - First5Low;
    HasBase    := (FibRange > 0);

    // Reset contadores
    U0e := 0;  U50e := 0;  U100e := 0; U150e := 0; U200e := 0;
    U250e := 0; U300e := 0; U350e := 0; U400e := 0; U450e := 0;
    L0e := 0;  L50e := 0;  L100e := 0; L150e := 0; L200e := 0;
    L250e := 0; L300e := 0; L350e := 0; L400e := 0; L450e := 0;
    MidE := 0;

    U0b := -1;  U50b := -1;  U100b := -1; U150b := -1; U200b := -1;
    U250b := -1; U300b := -1; U350b := -1; U400b := -1; U450b := -1;
    L0b := -1;  L50b := -1;  L100b := -1; L150b := -1; L200b := -1;
    L250b := -1; L300b := -1; L350b := -1; L400b := -1; L450b := -1;
    MidB := -1;
  fim;

  //--------------------------------------------------------------------------
  // Niveis Fibonacci
  //--------------------------------------------------------------------------
  Se HasBase entao inicio
    U0   := First5High;
    UMid := (First5High + First5Low) / 2;
    U50  := First5High + 0.50 * FibRange;
    U100 := First5High + 1.00 * FibRange;
    U150 := First5High + 1.50 * FibRange;
    U200 := First5High + 2.00 * FibRange;
    U250 := First5High + 2.50 * FibRange;
    U300 := First5High + 3.00 * FibRange;
    U350 := First5High + 3.50 * FibRange;
    U400 := First5High + 4.00 * FibRange;
    U450 := First5High + 4.50 * FibRange;

    L0   := First5Low;
    L50  := First5Low - 0.50 * FibRange;
    L100 := First5Low - 1.00 * FibRange;
    L150 := First5Low - 1.50 * FibRange;
    L200 := First5Low - 2.00 * FibRange;
    L250 := First5Low - 2.50 * FibRange;
    L300 := First5Low - 3.00 * FibRange;
    L350 := First5Low - 3.50 * FibRange;
    L400 := First5Low - 4.00 * FibRange;
    L450 := First5Low - 4.50 * FibRange;
  fim;

  //--------------------------------------------------------------------------
  // Contadores de toque por nivel (inline; NTSL nao aceita funcao com ref)
  // Regra: se preco toca (Low <= level <= High com tolerancia) e nao havia
  // toque recente (b < 0 ou > GapBars), incrementa contador. Se sem toque
  // por > ResetGap barras, zera o contador.
  //--------------------------------------------------------------------------
  Se HasBase entao inicio
    // UMid
    Tol := UMid * TolPct / 100.0;
    Se ((Minima - Tol) <= UMid) e (UMid <= (Maxima + Tol)) entao inicio
      Se (MidB < 0) ou (MidB > GapBars) entao MidE := MidE + 1;
      MidB := 0;
    fim
    senao Se MidB >= 0 entao inicio
      MidB := MidB + 1;
      Se MidB > ResetGap entao inicio MidE := 0; MidB := -1; fim;
    fim;

    // Suportes (L0..L450)
    Tol := L0 * TolPct / 100.0;
    Se ((Minima - Tol) <= L0) e (L0 <= (Maxima + Tol)) entao inicio
      Se (L0b < 0) ou (L0b > GapBars) entao L0e := L0e + 1;
      L0b := 0;
    fim senao Se L0b >= 0 entao inicio L0b := L0b + 1; Se L0b > ResetGap entao inicio L0e := 0; L0b := -1; fim; fim;

    Tol := L50 * TolPct / 100.0;
    Se ((Minima - Tol) <= L50) e (L50 <= (Maxima + Tol)) entao inicio
      Se (L50b < 0) ou (L50b > GapBars) entao L50e := L50e + 1;
      L50b := 0;
    fim senao Se L50b >= 0 entao inicio L50b := L50b + 1; Se L50b > ResetGap entao inicio L50e := 0; L50b := -1; fim; fim;

    Tol := L100 * TolPct / 100.0;
    Se ((Minima - Tol) <= L100) e (L100 <= (Maxima + Tol)) entao inicio
      Se (L100b < 0) ou (L100b > GapBars) entao L100e := L100e + 1;
      L100b := 0;
    fim senao Se L100b >= 0 entao inicio L100b := L100b + 1; Se L100b > ResetGap entao inicio L100e := 0; L100b := -1; fim; fim;

    Tol := L150 * TolPct / 100.0;
    Se ((Minima - Tol) <= L150) e (L150 <= (Maxima + Tol)) entao inicio
      Se (L150b < 0) ou (L150b > GapBars) entao L150e := L150e + 1;
      L150b := 0;
    fim senao Se L150b >= 0 entao inicio L150b := L150b + 1; Se L150b > ResetGap entao inicio L150e := 0; L150b := -1; fim; fim;

    Tol := L200 * TolPct / 100.0;
    Se ((Minima - Tol) <= L200) e (L200 <= (Maxima + Tol)) entao inicio
      Se (L200b < 0) ou (L200b > GapBars) entao L200e := L200e + 1;
      L200b := 0;
    fim senao Se L200b >= 0 entao inicio L200b := L200b + 1; Se L200b > ResetGap entao inicio L200e := 0; L200b := -1; fim; fim;

    Tol := L250 * TolPct / 100.0;
    Se ((Minima - Tol) <= L250) e (L250 <= (Maxima + Tol)) entao inicio
      Se (L250b < 0) ou (L250b > GapBars) entao L250e := L250e + 1;
      L250b := 0;
    fim senao Se L250b >= 0 entao inicio L250b := L250b + 1; Se L250b > ResetGap entao inicio L250e := 0; L250b := -1; fim; fim;

    Tol := L300 * TolPct / 100.0;
    Se ((Minima - Tol) <= L300) e (L300 <= (Maxima + Tol)) entao inicio
      Se (L300b < 0) ou (L300b > GapBars) entao L300e := L300e + 1;
      L300b := 0;
    fim senao Se L300b >= 0 entao inicio L300b := L300b + 1; Se L300b > ResetGap entao inicio L300e := 0; L300b := -1; fim; fim;

    Tol := L350 * TolPct / 100.0;
    Se ((Minima - Tol) <= L350) e (L350 <= (Maxima + Tol)) entao inicio
      Se (L350b < 0) ou (L350b > GapBars) entao L350e := L350e + 1;
      L350b := 0;
    fim senao Se L350b >= 0 entao inicio L350b := L350b + 1; Se L350b > ResetGap entao inicio L350e := 0; L350b := -1; fim; fim;

    Tol := L400 * TolPct / 100.0;
    Se ((Minima - Tol) <= L400) e (L400 <= (Maxima + Tol)) entao inicio
      Se (L400b < 0) ou (L400b > GapBars) entao L400e := L400e + 1;
      L400b := 0;
    fim senao Se L400b >= 0 entao inicio L400b := L400b + 1; Se L400b > ResetGap entao inicio L400e := 0; L400b := -1; fim; fim;

    Tol := L450 * TolPct / 100.0;
    Se ((Minima - Tol) <= L450) e (L450 <= (Maxima + Tol)) entao inicio
      Se (L450b < 0) ou (L450b > GapBars) entao L450e := L450e + 1;
      L450b := 0;
    fim senao Se L450b >= 0 entao inicio L450b := L450b + 1; Se L450b > ResetGap entao inicio L450e := 0; L450b := -1; fim; fim;

    // Resistencias (U0..U450)
    Tol := U0 * TolPct / 100.0;
    Se ((Minima - Tol) <= U0) e (U0 <= (Maxima + Tol)) entao inicio
      Se (U0b < 0) ou (U0b > GapBars) entao U0e := U0e + 1;
      U0b := 0;
    fim senao Se U0b >= 0 entao inicio U0b := U0b + 1; Se U0b > ResetGap entao inicio U0e := 0; U0b := -1; fim; fim;

    Tol := U50 * TolPct / 100.0;
    Se ((Minima - Tol) <= U50) e (U50 <= (Maxima + Tol)) entao inicio
      Se (U50b < 0) ou (U50b > GapBars) entao U50e := U50e + 1;
      U50b := 0;
    fim senao Se U50b >= 0 entao inicio U50b := U50b + 1; Se U50b > ResetGap entao inicio U50e := 0; U50b := -1; fim; fim;

    Tol := U100 * TolPct / 100.0;
    Se ((Minima - Tol) <= U100) e (U100 <= (Maxima + Tol)) entao inicio
      Se (U100b < 0) ou (U100b > GapBars) entao U100e := U100e + 1;
      U100b := 0;
    fim senao Se U100b >= 0 entao inicio U100b := U100b + 1; Se U100b > ResetGap entao inicio U100e := 0; U100b := -1; fim; fim;

    Tol := U150 * TolPct / 100.0;
    Se ((Minima - Tol) <= U150) e (U150 <= (Maxima + Tol)) entao inicio
      Se (U150b < 0) ou (U150b > GapBars) entao U150e := U150e + 1;
      U150b := 0;
    fim senao Se U150b >= 0 entao inicio U150b := U150b + 1; Se U150b > ResetGap entao inicio U150e := 0; U150b := -1; fim; fim;

    Tol := U200 * TolPct / 100.0;
    Se ((Minima - Tol) <= U200) e (U200 <= (Maxima + Tol)) entao inicio
      Se (U200b < 0) ou (U200b > GapBars) entao U200e := U200e + 1;
      U200b := 0;
    fim senao Se U200b >= 0 entao inicio U200b := U200b + 1; Se U200b > ResetGap entao inicio U200e := 0; U200b := -1; fim; fim;

    Tol := U250 * TolPct / 100.0;
    Se ((Minima - Tol) <= U250) e (U250 <= (Maxima + Tol)) entao inicio
      Se (U250b < 0) ou (U250b > GapBars) entao U250e := U250e + 1;
      U250b := 0;
    fim senao Se U250b >= 0 entao inicio U250b := U250b + 1; Se U250b > ResetGap entao inicio U250e := 0; U250b := -1; fim; fim;

    Tol := U300 * TolPct / 100.0;
    Se ((Minima - Tol) <= U300) e (U300 <= (Maxima + Tol)) entao inicio
      Se (U300b < 0) ou (U300b > GapBars) entao U300e := U300e + 1;
      U300b := 0;
    fim senao Se U300b >= 0 entao inicio U300b := U300b + 1; Se U300b > ResetGap entao inicio U300e := 0; U300b := -1; fim; fim;

    Tol := U350 * TolPct / 100.0;
    Se ((Minima - Tol) <= U350) e (U350 <= (Maxima + Tol)) entao inicio
      Se (U350b < 0) ou (U350b > GapBars) entao U350e := U350e + 1;
      U350b := 0;
    fim senao Se U350b >= 0 entao inicio U350b := U350b + 1; Se U350b > ResetGap entao inicio U350e := 0; U350b := -1; fim; fim;

    Tol := U400 * TolPct / 100.0;
    Se ((Minima - Tol) <= U400) e (U400 <= (Maxima + Tol)) entao inicio
      Se (U400b < 0) ou (U400b > GapBars) entao U400e := U400e + 1;
      U400b := 0;
    fim senao Se U400b >= 0 entao inicio U400b := U400b + 1; Se U400b > ResetGap entao inicio U400e := 0; U400b := -1; fim; fim;

    Tol := U450 * TolPct / 100.0;
    Se ((Minima - Tol) <= U450) e (U450 <= (Maxima + Tol)) entao inicio
      Se (U450b < 0) ou (U450b > GapBars) entao U450e := U450e + 1;
      U450b := 0;
    fim senao Se U450b >= 0 entao inicio U450b := U450b + 1; Se U450b > ResetGap entao inicio U450e := 0; U450b := -1; fim; fim;
  fim;

  //--------------------------------------------------------------------------
  // Indicadores no TF do grafico (5min)
  //--------------------------------------------------------------------------
  // Estocastico LENTO (K=8, D=3, SMA duplo)
  StochRaw := FastStochastic(EstocLen);
  StochK   := Media(EstocDLen, StochRaw);
  StochD   := Media(EstocDLen, StochK);
  StochBuy  := StochK > StochD;
  StochSell := StochK < StochD;

  // TRIX (9, MMA 3)
  TrixVal := (MediaExp(TrixLen, MediaExp(TrixLen, MediaExp(TrixLen, Close))) -
              MediaExp(TrixLen, MediaExp(TrixLen, MediaExp(TrixLen, Close)))[1]) /
             MediaExp(TrixLen, MediaExp(TrixLen, MediaExp(TrixLen, Close)))[1] * 100;
  TrixMA  := Media(TrixMALen, TrixVal);
  TrixBuy  := TrixVal > TrixMA;
  TrixSell := TrixVal < TrixMA;

  // DI+/DI- e ADX (8, 8)
  AdxV := ADX(AdxLen, AdxMediaLen);
  DmP  := DiPDiM(AdxLen)|0|;
  DmN  := DiPDiM(AdxLen)|1|;
  DmiBuy  := DmP > DmN;
  DmiSell := DmN > DmP;

  Score3Buy  := 0;
  Score3Sell := 0;
  Se StochBuy  entao Score3Buy  := Score3Buy  + 1;
  Se TrixBuy   entao Score3Buy  := Score3Buy  + 1;
  Se DmiBuy    entao Score3Buy  := Score3Buy  + 1;
  Se StochSell entao Score3Sell := Score3Sell + 1;
  Se TrixSell  entao Score3Sell := Score3Sell + 1;
  Se DmiSell   entao Score3Sell := Score3Sell + 1;

  Tf5Aligned3Buy  := (Score3Buy  = 3);
  Tf5Aligned3Sell := (Score3Sell = 3);

  //--------------------------------------------------------------------------
  // Congruencia aproximada 15/30/60m via DMI com periodos dilatados no 5m
  // (NTSL nao tem MTF nativo; usa ADX(24), ADX(48), ADX(96) como proxies)
  //--------------------------------------------------------------------------
  AdxV15 := ADX(AdxLen * 3, AdxMediaLen);
  DmP15  := DiPDiM(AdxLen * 3)|0|;
  DmN15  := DiPDiM(AdxLen * 3)|1|;
  AdxV30 := ADX(AdxLen * 6, AdxMediaLen);
  DmP30  := DiPDiM(AdxLen * 6)|0|;
  DmN30  := DiPDiM(AdxLen * 6)|1|;
  AdxV60 := ADX(AdxLen * 12, AdxMediaLen);
  DmP60  := DiPDiM(AdxLen * 12)|0|;
  DmN60  := DiPDiM(AdxLen * 12)|1|;

  Tf15Buy := (AdxV15 > 25) e (DmP15 > DmN15);
  Tf30Buy := (AdxV30 > 25) e (DmP30 > DmN30);
  Tf60Buy := (AdxV60 > 25) e (DmP60 > DmN60);
  Tf15Sell := (AdxV15 > 25) e (DmN15 > DmP15);
  Tf30Sell := (AdxV30 > 25) e (DmN30 > DmP30);
  Tf60Sell := (AdxV60 > 25) e (DmN60 > DmP60);

  NTfsBuy := 0;
  Se Tf5Aligned3Buy entao NTfsBuy := NTfsBuy + 1;
  Se Tf15Buy        entao NTfsBuy := NTfsBuy + 1;
  Se Tf30Buy        entao NTfsBuy := NTfsBuy + 1;
  Se Tf60Buy        entao NTfsBuy := NTfsBuy + 1;

  NTfsSell := 0;
  Se Tf5Aligned3Sell entao NTfsSell := NTfsSell + 1;
  Se Tf15Sell        entao NTfsSell := NTfsSell + 1;
  Se Tf30Sell        entao NTfsSell := NTfsSell + 1;
  Se Tf60Sell        entao NTfsSell := NTfsSell + 1;

  //--------------------------------------------------------------------------
  // Gate v14: 2a batida em Fibo + candle fecha na direcao
  //--------------------------------------------------------------------------
  BuyGateArmed := False;
  SellGateArmed := False;

  Se HasBase entao inicio
    // Compra: 2a batida em suporte E fecha ACIMA
    Se ((MidE = 2) e (Fechamento > UMid))   entao BuyGateArmed := True;
    Se ((L0e = 2) e (Fechamento > L0))       entao BuyGateArmed := True;
    Se ((L50e = 2) e (Fechamento > L50))     entao BuyGateArmed := True;
    Se ((L100e = 2) e (Fechamento > L100))   entao BuyGateArmed := True;
    Se ((L150e = 2) e (Fechamento > L150))   entao BuyGateArmed := True;
    Se ((L200e = 2) e (Fechamento > L200))   entao BuyGateArmed := True;
    Se ((L250e = 2) e (Fechamento > L250))   entao BuyGateArmed := True;
    Se ((L300e = 2) e (Fechamento > L300))   entao BuyGateArmed := True;
    Se ((L350e = 2) e (Fechamento > L350))   entao BuyGateArmed := True;
    Se ((L400e = 2) e (Fechamento > L400))   entao BuyGateArmed := True;
    Se ((L450e = 2) e (Fechamento > L450))   entao BuyGateArmed := True;

    // Venda: 2a batida em resistencia E fecha ABAIXO
    Se ((MidE = 2) e (Fechamento < UMid))    entao SellGateArmed := True;
    Se ((U0e = 2) e (Fechamento < U0))        entao SellGateArmed := True;
    Se ((U50e = 2) e (Fechamento < U50))      entao SellGateArmed := True;
    Se ((U100e = 2) e (Fechamento < U100))    entao SellGateArmed := True;
    Se ((U150e = 2) e (Fechamento < U150))    entao SellGateArmed := True;
    Se ((U200e = 2) e (Fechamento < U200))    entao SellGateArmed := True;
    Se ((U250e = 2) e (Fechamento < U250))    entao SellGateArmed := True;
    Se ((U300e = 2) e (Fechamento < U300))    entao SellGateArmed := True;
    Se ((U350e = 2) e (Fechamento < U350))    entao SellGateArmed := True;
    Se ((U400e = 2) e (Fechamento < U400))    entao SellGateArmed := True;
    Se ((U450e = 2) e (Fechamento < U450))    entao SellGateArmed := True;
  fim;

  // Sinal dispara no candle SEGUINTE ao armed (entra na abertura)
  BuySignalV14  := BuyGateArmed[1];
  SellSignalV14 := SellGateArmed[1];

  //--------------------------------------------------------------------------
  // Sessao
  //--------------------------------------------------------------------------
  InEntryWindow := (Time < SessionEnd);
  InEodWindow   := (Time >= EodTime);

  //--------------------------------------------------------------------------
  // Entradas (NTSL: BuyAtMarket abre posicao total; scale-out por SellToCoverLimit)
  //--------------------------------------------------------------------------
  Se BuySignalV14 e InEntryWindow e (BuyPosition = 0) e (SellPosition = 0) e HasBase entao
  inicio
    QtyTotal := QtyBase * NTfsBuy;
    Se QtyTotal < QtyBase entao QtyTotal := QtyBase;
    Se QtyTotal > QtyCap  entao QtyTotal := QtyCap;
    Qty1 := IntPortion(QtyTotal / 2);
    Se Qty1 < 1 entao Qty1 := 1;
    Qty2 := QtyTotal - Qty1;
    Se Qty2 < 1 entao Qty2 := 1;

    BuyAtMarket(QtyTotal);
    StopPrice := Close - FibRange * StopFibPct;
    AlvoC1 := U150;
    AlvoC2 := U300;
    SellToCoverStop(StopPrice, StopPrice, QtyTotal);
    SellToCoverLimit(AlvoC1, Qty1);
    SellToCoverLimit(AlvoC2, Qty2);
  fim;

  Se SellSignalV14 e InEntryWindow e (BuyPosition = 0) e (SellPosition = 0) e HasBase entao
  inicio
    QtyTotal := QtyBase * NTfsSell;
    Se QtyTotal < QtyBase entao QtyTotal := QtyBase;
    Se QtyTotal > QtyCap  entao QtyTotal := QtyCap;
    Qty1 := IntPortion(QtyTotal / 2);
    Se Qty1 < 1 entao Qty1 := 1;
    Qty2 := QtyTotal - Qty1;
    Se Qty2 < 1 entao Qty2 := 1;

    SellShortAtMarket(QtyTotal);
    StopPrice := Close + FibRange * StopFibPct;
    AlvoV1 := L150;
    AlvoV2 := L300;
    BuyToCoverStop(StopPrice, StopPrice, QtyTotal);
    BuyToCoverLimit(AlvoV1, Qty1);
    BuyToCoverLimit(AlvoV2, Qty2);
  fim;

  //--------------------------------------------------------------------------
  // EOD forcado 17:55
  //--------------------------------------------------------------------------
  Se InEodWindow e ((BuyPosition > 0) ou (SellPosition > 0)) entao ClosePosition;

  //--------------------------------------------------------------------------
  // Plots visuais (referencia dos niveis Fibo principais)
  //--------------------------------------------------------------------------
  Plot(U0);
  Plot2(UMid);
  Plot3(L0);
  Plot4(U150);
  Plot5(L150);

end;
