// @version=5
// -----------------------------------------------------------------------------
// Eixo Estratégico — WIN Day Trade | Strategy Backtestable
// -----------------------------------------------------------------------------
// APLICAR NO GRÁFICO DE 1 MINUTO DO ATIVO WIN.
// Versão backtest: entra quando score >= min_score (default 2/4) e sai por scale-out em cada Fibo tocado.
// Sizing por congruência: 5/10/15/20 contratos.
// -----------------------------------------------------------------------------

strategy("Eixo WIN — Strategy X/4", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.5,
     slippage=1)

// ============================== PARÂMETROS ==================================
tol_pct    = input.float(0.05, "Tolerância de toque (%)",    minval=0.01, step=0.01)
cross_win  = input.int(3, "Janela de iniciação (candles)",  minval=1, maxval=10)
gap_bars   = input.int(3, "Gap mínimo entre eventos",       minval=1, maxval=20)
reset_gap  = input.int(5, "Reset contador após N candles sem tocar", minval=3, maxval=100)
adx_min    = input.float(25.0, "ADX mín. congruência TF sup", step=1)
min_extras       = input.int(1, "Mín. confirmações (Estoc 1m / TRIX 5m)", minval=1, maxval=2)
max_gap_touches  = input.int(10, "Máx. candles entre 1º e 2º toque", minval=2, maxval=50)
wait_after_touch = input.int(1, "Janela pra confirmação após 2º toque (candles)", minval=1, maxval=30)
adx_bonus        = input.int(5, "Bônus de contratos com ADX 5m ativo", minval=0, maxval=10)
sizing_cap = input.int(25, "Cap máximo de contratos", minval=5, maxval=100)

session_end_h = input.int(17, "Hora limite pra abrir posição",  minval=10, maxval=17)
session_end_m = input.int(30, "Minuto limite pra abrir",         minval=0,  maxval=59)
force_close_h = input.int(17, "Hora fechamento forçado (EOD)",   minval=10, maxval=17)
force_close_m = input.int(55, "Minuto fechamento forçado",       minval=0,  maxval=59)

// ============================== FIBONACCI ===================================
[first5_high, first5_low, _] = request.security(syminfo.tickerid, "5",
     [ta.valuewhen(ta.change(dayofmonth) != 0, high, 0),
      ta.valuewhen(ta.change(dayofmonth) != 0, low, 0),
      ta.valuewhen(ta.change(dayofmonth) != 0, time, 0)],
     lookahead=barmerge.lookahead_off)

fib_range = first5_high - first5_low
has_base = not na(first5_high) and not na(fib_range) and fib_range > 0

lvl(dir, pct) => dir == "upper" ? first5_high + (pct/100.0) * fib_range : first5_low - (pct/100.0) * fib_range

u0   = lvl("upper", 0)
umid = (first5_high + first5_low) / 2   // ★ meio do 1º candle 5min
u50  = lvl("upper", 50)
u100 = lvl("upper", 100)
u150 = lvl("upper", 150)
u200 = lvl("upper", 200)
u250 = lvl("upper", 250)
u300 = lvl("upper", 300)
u350 = lvl("upper", 350)
u400 = lvl("upper", 400)
u450 = lvl("upper", 450)
l0   = lvl("lower", 0)
l50  = lvl("lower", 50)
l100 = lvl("lower", 100)
l150 = lvl("lower", 150)
l200 = lvl("lower", 200)
l250 = lvl("lower", 250)
l300 = lvl("lower", 300)
l350 = lvl("lower", 350)
l400 = lvl("lower", 400)
l450 = lvl("lower", 450)

// ============================== 2º TOQUE ====================================
is_new_day = ta.change(dayofmonth) != 0

tocou(level_price) =>
    tol = level_price * tol_pct / 100.0
    (low - tol) <= level_price and level_price <= (high + tol)

update(is_touching, events, bs_last) =>
    ne = events
    nbs = bs_last
    if is_touching
        if na(bs_last) or bs_last > gap_bars
            ne := events + 1
        nbs := 0
    else if not na(bs_last)
        nbs := bs_last + 1
        // Reset por gap: novo par 1º+2º toque vira novo aviso
        if nbs > reset_gap
            ne := 0
            nbs := na
    [ne, nbs]

var int u0e = 0
var int u50e = 0
var int u100e = 0
var int u150e = 0
var int u200e = 0
var int u250e = 0
var int u300e = 0
var int u350e = 0
var int u400e = 0
var int u450e = 0
var int l0e = 0
var int l50e = 0
var int l100e = 0
var int l150e = 0
var int l200e = 0
var int l250e = 0
var int l300e = 0
var int l350e = 0
var int l400e = 0
var int l450e = 0
var int u0b = na
var int u50b = na
var int u100b = na
var int u150b = na
var int u200b = na
var int u250b = na
var int u300b = na
var int u350b = na
var int u400b = na
var int u450b = na
var int l0b = na
var int l50b = na
var int l100b = na
var int l150b = na
var int l200b = na
var int l250b = na
var int l300b = na
var int l350b = na
var int l400b = na
var int l450b = na
var int mide = 0
var int midb = na

if is_new_day
    u0e := 0
    u50e := 0
    u100e := 0
    u150e := 0
    u200e := 0
    u250e := 0
    u300e := 0
    u350e := 0
    u400e := 0
    u450e := 0
    l0e := 0
    l50e := 0
    l100e := 0
    l150e := 0
    l200e := 0
    l250e := 0
    l300e := 0
    l350e := 0
    l400e := 0
    l450e := 0
    mide := 0
    midb := na
    u0b := na
    u50b := na
    u100b := na
    u150b := na
    u200b := na
    u250b := na
    u300b := na
    u350b := na
    u400b := na
    u450b := na
    l0b := na
    l50b := na
    l100b := na
    l150b := na
    l200b := na
    l250b := na
    l300b := na
    l350b := na
    l400b := na
    l450b := na

if has_base
    [nu0e, nu0b] = update(tocou(u0), u0e, u0b)
    u0e := nu0e
    u0b := nu0b
    [nu50e, nu50b] = update(tocou(u50), u50e, u50b)
    u50e := nu50e
    u50b := nu50b
    [nu100e, nu100b] = update(tocou(u100), u100e, u100b)
    u100e := nu100e
    u100b := nu100b
    [nu150e, nu150b] = update(tocou(u150), u150e, u150b)
    u150e := nu150e
    u150b := nu150b
    [nu200e, nu200b] = update(tocou(u200), u200e, u200b)
    u200e := nu200e
    u200b := nu200b
    [nu250e, nu250b] = update(tocou(u250), u250e, u250b)
    u250e := nu250e
    u250b := nu250b
    [nu300e, nu300b] = update(tocou(u300), u300e, u300b)
    u300e := nu300e
    u300b := nu300b
    [nu350e, nu350b] = update(tocou(u350), u350e, u350b)
    u350e := nu350e
    u350b := nu350b
    [nu400e, nu400b] = update(tocou(u400), u400e, u400b)
    u400e := nu400e
    u400b := nu400b
    [nu450e, nu450b] = update(tocou(u450), u450e, u450b)
    u450e := nu450e
    u450b := nu450b
    [nl0e, nl0b] = update(tocou(l0), l0e, l0b)
    l0e := nl0e
    l0b := nl0b
    [nl50e, nl50b] = update(tocou(l50), l50e, l50b)
    l50e := nl50e
    l50b := nl50b
    [nl100e, nl100b] = update(tocou(l100), l100e, l100b)
    l100e := nl100e
    l100b := nl100b
    [nl150e, nl150b] = update(tocou(l150), l150e, l150b)
    l150e := nl150e
    l150b := nl150b
    [nl200e, nl200b] = update(tocou(l200), l200e, l200b)
    l200e := nl200e
    l200b := nl200b
    [nl250e, nl250b] = update(tocou(l250), l250e, l250b)
    l250e := nl250e
    l250b := nl250b
    [nl300e, nl300b] = update(tocou(l300), l300e, l300b)
    l300e := nl300e
    l300b := nl300b
    [nl350e, nl350b] = update(tocou(l350), l350e, l350b)
    l350e := nl350e
    l350b := nl350b
    [nl400e, nl400b] = update(tocou(l400), l400e, l400b)
    l400e := nl400e
    l400b := nl400b
    [nl450e, nl450b] = update(tocou(l450), l450e, l450b)
    l450e := nl450e
    l450b := nl450b
    [nmide, nmidb] = update(tocou(umid), mide, midb)
    mide := nmide
    midb := nmidb

// APENAS 2ª batida (== 2) — cada nível gera no máximo 1 aviso por dia.
// MID entra em ambos os lados (dual-side).
mid_second_touch = tocou(umid) and mide == 2

second_upper = mid_second_touch or (tocou(u0) and u0e == 2) or (tocou(u50) and u50e == 2) or (tocou(u100) and u100e == 2) or (tocou(u150) and u150e == 2) or (tocou(u200) and u200e == 2) or (tocou(u250) and u250e == 2) or (tocou(u300) and u300e == 2) or (tocou(u350) and u350e == 2) or (tocou(u400) and u400e == 2) or (tocou(u450) and u450e == 2)
second_lower = mid_second_touch or (tocou(l0) and l0e == 2) or (tocou(l50) and l50e == 2) or (tocou(l100) and l100e == 2) or (tocou(l150) and l150e == 2) or (tocou(l200) and l200e == 2) or (tocou(l250) and l250e == 2) or (tocou(l300) and l300e == 2) or (tocou(l350) and l350e == 2) or (tocou(l400) and l400e == 2) or (tocou(l450) and l450e == 2)

// ============================== INDICADORES =================================
// TRIX manual (Pine v5 não tem ta.trix nativo)
trix_calc(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    ta.roc(e3, 1)

// Estoc 1m — evento e "barssince cross"
stoch_k = ta.stoch(close, high, low, 5)
stoch_d = ta.sma(stoch_k, 3)
stoch_cross_up = ta.crossover(stoch_k, stoch_d)
stoch_cross_dn = ta.crossunder(stoch_k, stoch_d)
stoch_bars_up  = ta.barssince(stoch_cross_up)
stoch_bars_dn  = ta.barssince(stoch_cross_dn)

// TRIX 5m + ADX 5m + DMI 5m via helper (Pine v5 exige função pra tuple no request.security)
get_5m() =>
    tv = trix_calc(close, 9)
    tm = ta.sma(tv, 4)
    tbu = ta.barssince(ta.crossover(tv, tm))
    tbd = ta.barssince(ta.crossunder(tv, tm))
    [dp, dn, av] = ta.dmi(8, 8)
    up30r = ta.barssince(ta.crossover(av, 30)) < 3
    band  = av > 70 and av < 80 and av < av[1]
    [tbu, tbd, av, dp, dn, up30r, band]

[trix_bars_up_5m, trix_bars_dn_5m, adx5, dmp5, dmn5, adx_up_30_recent, adx_band_dn] = request.security(syminfo.tickerid, "5", get_5m(), lookahead=barmerge.lookahead_off)
adx_intensifier = adx_up_30_recent or adx_band_dn

// TRIX 1m — SAÍDA (2º cruzamento contra o trade)
trix1m_val = trix_calc(close, 9)
trix1m_ma  = ta.sma(trix1m_val, 4)
trix1m_cross_up = ta.crossover(trix1m_val, trix1m_ma)
trix1m_cross_dn = ta.crossunder(trix1m_val, trix1m_ma)

// ============================== CONGRUÊNCIA MTF =============================
get_htf() =>
    [dp, dn, av] = ta.dmi(8, 8)
    up30r = ta.barssince(ta.crossover(av, 30)) < 3
    band  = av > 70 and av < 80 and av < av[1]
    active = up30r or band
    [dp, dn, av, active]

[dip15, dim15, adx15, act15] = request.security(syminfo.tickerid, "15", get_htf())
[dip30, dim30, adx30, act30] = request.security(syminfo.tickerid, "30", get_htf())
[dip60, dim60, adx60, act60] = request.security(syminfo.tickerid, "60", get_htf())

cong5_buy   = adx_intensifier and dmp5  > dmn5
cong15_buy  = act15 and dip15 > dim15
cong30_buy  = act30 and dip30 > dim30
cong60_buy  = act60 and dip60 > dim60
cong5_sell  = adx_intensifier and dmn5  > dmp5
cong15_sell = act15 and dim15 > dip15
cong30_sell = act30 and dim30 > dip30
cong60_sell = act60 and dim60 > dip60

cong44_buy_score  = (cong5_buy  ? 1 : 0) + (cong15_buy  ? 1 : 0) + (cong30_buy  ? 1 : 0) + (cong60_buy  ? 1 : 0)
cong44_sell_score = (cong5_sell ? 1 : 0) + (cong15_sell ? 1 : 0) + (cong30_sell ? 1 : 0) + (cong60_sell ? 1 : 0)

// Score MTF antigo (só 15+30+60) — mantido para o sizing
cong_buy_score  = (cong15_buy  ? 1 : 0) + (cong30_buy  ? 1 : 0) + (cong60_buy  ? 1 : 0)
cong_sell_score = (cong15_sell ? 1 : 0) + (cong30_sell ? 1 : 0) + (cong60_sell ? 1 : 0)

// ============================== GATILHO (opção B — global por direção) =====
// Estado 1: sem setup → aguarda 1º toque em algum suporte
// Estado 2: 1º toque → aguarda 2º toque no mesmo nível em ≤ max_gap_touches
// Estado 3: 2º toque → aguarda cross Estoc/TRIX em ≤ wait_after_touch pós 2º
//           (cross entre 1º e 2º também vale)
// Após disparar: reset total

// Detect 1º toque em algum nível (usa _e == 1)
// MID como âncora dual: 1º toque no midpoint conta pra ambas as direções
mid_first_now = tocou(umid) and mide == 1
first_lower_now = mid_first_now or (tocou(l0) and l0e == 1) or (tocou(l50) and l50e == 1) or (tocou(l100) and l100e == 1) or (tocou(l150) and l150e == 1) or (tocou(l200) and l200e == 1) or (tocou(l250) and l250e == 1) or (tocou(l300) and l300e == 1) or (tocou(l350) and l350e == 1) or (tocou(l400) and l400e == 1) or (tocou(l450) and l450e == 1)
first_upper_now = mid_first_now or (tocou(u0) and u0e == 1) or (tocou(u50) and u50e == 1) or (tocou(u100) and u100e == 1) or (tocou(u150) and u150e == 1) or (tocou(u200) and u200e == 1) or (tocou(u250) and u250e == 1) or (tocou(u300) and u300e == 1) or (tocou(u350) and u350e == 1) or (tocou(u400) and u400e == 1) or (tocou(u450) and u450e == 1)

var int buy_first_touch_ago   = 999999
var int buy_second_touch_ago  = 999999
var int sell_first_touch_ago  = 999999
var int sell_second_touch_ago = 999999

if is_new_day
    buy_first_touch_ago   := 999999
    buy_second_touch_ago  := 999999
    sell_first_touch_ago  := 999999
    sell_second_touch_ago := 999999

buy_first_touch_ago   := buy_first_touch_ago   + 1
buy_second_touch_ago  := buy_second_touch_ago  + 1
sell_first_touch_ago  := sell_first_touch_ago  + 1
sell_second_touch_ago := sell_second_touch_ago + 1

if first_lower_now and buy_first_touch_ago > max_gap_touches
    buy_first_touch_ago  := 0
    buy_second_touch_ago := 999999
if first_upper_now and sell_first_touch_ago > max_gap_touches
    sell_first_touch_ago  := 0
    sell_second_touch_ago := 999999

if second_lower and buy_first_touch_ago <= max_gap_touches and buy_second_touch_ago > wait_after_touch
    buy_second_touch_ago := 0
if second_upper and sell_first_touch_ago <= max_gap_touches and sell_second_touch_ago > wait_after_touch
    sell_second_touch_ago := 0

buy_touch_window_open  = buy_second_touch_ago  <= wait_after_touch
sell_touch_window_open = sell_second_touch_ago <= wait_after_touch

buy_stoch_valid  = buy_touch_window_open  and stoch_bars_up   < buy_first_touch_ago
buy_trix_valid   = buy_touch_window_open  and trix_bars_up_5m < buy_first_touch_ago
sell_stoch_valid = sell_touch_window_open and stoch_bars_dn   < sell_first_touch_ago
sell_trix_valid  = sell_touch_window_open and trix_bars_dn_5m < sell_first_touch_ago

buy_extras_score  = (buy_stoch_valid  ? 1 : 0) + (buy_trix_valid  ? 1 : 0)
sell_extras_score = (sell_stoch_valid ? 1 : 0) + (sell_trix_valid ? 1 : 0)

buy_score  = (second_lower ? 1 : 0) + buy_extras_score
sell_score = (second_upper ? 1 : 0) + sell_extras_score

buy_signal_hit  = buy_touch_window_open  and buy_extras_score  >= min_extras
sell_signal_hit = sell_touch_window_open and sell_extras_score >= min_extras

// SINAL PREMIUM 4/4 (paridade com indicator): gatilho X/2 + congruência total 4 TFs
buy_signal_44  = buy_signal_hit  and cong44_buy_score  == 4
sell_signal_44 = sell_signal_hit and cong44_sell_score == 4

if buy_signal_hit
    buy_first_touch_ago  := 999999
    buy_second_touch_ago := 999999
if sell_signal_hit
    sell_first_touch_ago  := 999999
    sell_second_touch_ago := 999999

// ============================== SESSION FILTER ==============================
in_entry_window = (hour < session_end_h) or (hour == session_end_h and minute < session_end_m)
in_eod_window   = (hour > force_close_h) or (hour == force_close_h and minute >= force_close_m)

// ============================== SIZING ======================================
sizing_base(cong) => cong == 3 ? 20 : cong == 2 ? 15 : cong == 1 ? 10 : 5
sizing_contratos(cong) => math.min(sizing_cap, sizing_base(cong) + (adx_intensifier ? adx_bonus : 0))

// ============================== ENTRADAS ====================================
// 10 targets iguais para todos os cong: 0, 50, 100, 150, 200, 250, 300, 350, 400, 450
// qty por target = floor(total/10), min 1; T10 fecha o remainder.

if buy_signal_hit and in_entry_window and strategy.position_size == 0 and has_base
    qty_total = sizing_contratos(cong_buy_score)
    tag = buy_signal_44 ? "★4/4 " : ""
    strategy.entry("Long", strategy.long, qty=qty_total, comment=tag + "Buy cong=" + str.tostring(cong_buy_score) + " cong44=" + str.tostring(cong44_buy_score))
    stop_price = close - fib_range * 0.5
    qty_t = math.max(1, int(math.floor(qty_total / 10.0)))
    strategy.exit("T1",  from_entry="Long", qty=qty_t, limit=lvl("upper",   0), stop=stop_price)
    strategy.exit("T2",  from_entry="Long", qty=qty_t, limit=lvl("upper",  50), stop=stop_price)
    strategy.exit("T3",  from_entry="Long", qty=qty_t, limit=lvl("upper", 100), stop=stop_price)
    strategy.exit("T4",  from_entry="Long", qty=qty_t, limit=lvl("upper", 150), stop=stop_price)
    strategy.exit("T5",  from_entry="Long", qty=qty_t, limit=lvl("upper", 200), stop=stop_price)
    strategy.exit("T6",  from_entry="Long", qty=qty_t, limit=lvl("upper", 250), stop=stop_price)
    strategy.exit("T7",  from_entry="Long", qty=qty_t, limit=lvl("upper", 300), stop=stop_price)
    strategy.exit("T8",  from_entry="Long", qty=qty_t, limit=lvl("upper", 350), stop=stop_price)
    strategy.exit("T9",  from_entry="Long", qty=qty_t, limit=lvl("upper", 400), stop=stop_price)
    strategy.exit("T10", from_entry="Long",            limit=lvl("upper", 450), stop=stop_price)

if sell_signal_hit and in_entry_window and strategy.position_size == 0 and has_base
    qty_total = sizing_contratos(cong_sell_score)
    tag = sell_signal_44 ? "★4/4 " : ""
    strategy.entry("Short", strategy.short, qty=qty_total, comment=tag + "Sell cong=" + str.tostring(cong_sell_score) + " cong44=" + str.tostring(cong44_sell_score))
    stop_price = close + fib_range * 0.5
    qty_t = math.max(1, int(math.floor(qty_total / 10.0)))
    strategy.exit("T1",  from_entry="Short", qty=qty_t, limit=lvl("lower",   0), stop=stop_price)
    strategy.exit("T2",  from_entry="Short", qty=qty_t, limit=lvl("lower",  50), stop=stop_price)
    strategy.exit("T3",  from_entry="Short", qty=qty_t, limit=lvl("lower", 100), stop=stop_price)
    strategy.exit("T4",  from_entry="Short", qty=qty_t, limit=lvl("lower", 150), stop=stop_price)
    strategy.exit("T5",  from_entry="Short", qty=qty_t, limit=lvl("lower", 200), stop=stop_price)
    strategy.exit("T6",  from_entry="Short", qty=qty_t, limit=lvl("lower", 250), stop=stop_price)
    strategy.exit("T7",  from_entry="Short", qty=qty_t, limit=lvl("lower", 300), stop=stop_price)
    strategy.exit("T8",  from_entry="Short", qty=qty_t, limit=lvl("lower", 350), stop=stop_price)
    strategy.exit("T9",  from_entry="Short", qty=qty_t, limit=lvl("lower", 400), stop=stop_price)
    strategy.exit("T10", from_entry="Short",            limit=lvl("lower", 450), stop=stop_price)

// ============================== SAÍDA ANTECIPADA — 2 FASES ==================
// FASE 1 (ARMA): 2º cruzamento do TRIX 1m contra a direção do trade →
//                seta bandeira "exit_armed", mas não fecha ainda.
// FASE 2 (DISPARA): estando armada, quando preço tocar em algum Fibo no
//                gráfico 1min → close_all.
// Contadores e flags resetam a cada nova entrada.
var int  long_trix_dn_count  = 0
var int  short_trix_up_count = 0
var bool long_exit_armed     = false
var bool short_exit_armed    = false

// Reset ao ficar flat
if strategy.position_size == 0
    long_trix_dn_count  := 0
    short_trix_up_count := 0
    long_exit_armed     := false
    short_exit_armed    := false

// Conta crosses contrários enquanto posição aberta
if strategy.position_size > 0 and trix1m_cross_dn
    long_trix_dn_count := long_trix_dn_count + 1
if strategy.position_size < 0 and trix1m_cross_up
    short_trix_up_count := short_trix_up_count + 1

// FASE 1: 2º contrário = ARMA (não fecha ainda)
if strategy.position_size > 0 and long_trix_dn_count >= 2
    long_exit_armed := true
if strategy.position_size < 0 and short_trix_up_count >= 2
    short_exit_armed := true

// FASE 2: armado + toque em QUALQUER Fibo (1min) = DISPARA
any_fibo_touch = tocou(umid) or tocou(u0) or tocou(u50) or tocou(u100) or tocou(u150) or tocou(u200) or tocou(u250) or tocou(u300) or tocou(u350) or tocou(u400) or tocou(u450) or tocou(l0) or tocou(l50) or tocou(l100) or tocou(l150) or tocou(l200) or tocou(l250) or tocou(l300) or tocou(l350) or tocou(l400) or tocou(l450)

if long_exit_armed and any_fibo_touch
    strategy.close_all(comment="2ºTRIX1m↓ + FiboTouch")
if short_exit_armed and any_fibo_touch
    strategy.close_all(comment="2ºTRIX1m↑ + FiboTouch")

// EOD close forçado
if in_eod_window and strategy.position_size != 0
    strategy.close_all(comment="EOD")

// ============================== PLOTS =======================================
plot(has_base ? u0   : na, "★ R0 (topo 1º 5m)",  color=color.new(color.black,  0), linewidth=2)
plot(has_base ? umid : na, "★ MID (meio 1º 5m)", color=color.new(color.orange, 0), linewidth=2)
plot(has_base ? l0   : na, "★ S0 (base 1º 5m)",  color=color.new(color.black,  0), linewidth=2)
plot(has_base ? u100 : na, "R100", color=color.new(color.red, 60))
plot(has_base ? u200 : na, "R200", color=color.new(color.red, 60))
plot(has_base ? u300 : na, "R300", color=color.new(color.red, 60))
plot(has_base ? l100 : na, "S100", color=color.new(color.blue, 60))
plot(has_base ? l200 : na, "S200", color=color.new(color.blue, 60))
plot(has_base ? l300 : na, "S300", color=color.new(color.blue, 60))

plotshape(buy_signal_hit,  title="BUY hit",  location=location.belowbar, color=color.green, style=shape.triangleup,   size=size.small)
plotshape(sell_signal_hit, title="SELL hit", location=location.abovebar, color=color.red,   style=shape.triangledown, size=size.small)
